        <mxCell id="mode-note" value="&lt;b&gt;SLOT_D[8:0] = {último bit guardado, patrón[7:0]}&lt;/b&gt; · 00 OFF / 01 ZERO: {0, 00h} · 10 WORD: {HS_BYTE[7], HS_BYTE[7:0]}&lt;br&gt;11 TRAIL: {LAST_BIT, 8 repeticiones de ¬LAST_BIT} · ISO tiene prioridad: borra la carga incluso sin reloj." style="text;html=1;whiteSpace=wrap;align=left;spacing=0;fontSize=17;fontColor=#20313F;" vertex="1" connectable="0" parent="ser">
          <mxGeometry x="60" y="472" width="1110" height="41" as="geometry"/>
        </mxCell>
        <mxCell id="table" value="&lt;b style=&quot;font-size:22px&quot;&gt;Flancos de consumo y emisión&lt;/b&gt;&lt;br&gt;Pᵢ = ↑PCLK que sigue a ↓i de CLK_BYTE. Fᵢ = ↑FCLK que inicia el slot en Q0 tras la latencia interna; Fᵢ₊₁ − Fᵢ = Tbyte.&lt;table style=&quot;border-collapse:collapse;margin-top:7px;width:1725px;table-layout:fixed&quot; cellpadding=&quot;4&quot;&gt;
          &lt;tr style=&quot;background:#DDE8EC;&quot;&gt;&lt;th width=&quot;16%&quot; align=&quot;left&quot;&gt;CLK_BYTE&lt;/th&gt;&lt;th width=&quot;22%&quot; align=&quot;left&quot;&gt;PHY_IF publica tras ↓&lt;/th&gt;&lt;th width=&quot;23%&quot; align=&quot;left&quot;&gt;Captura lógica en ↓&lt;/th&gt;&lt;th width=&quot;7%&quot; align=&quot;left&quot;&gt;Carga&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Q0 en Fᵢ + j·UI, j = 0…7&lt;/th&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;↓−1&lt;/td&gt;&lt;td&gt;SoT B8/B8&lt;/td&gt;&lt;td&gt;ZERO, no captura dato&lt;/td&gt;&lt;td&gt;P₋₁&lt;/td&gt;&lt;td&gt;Nivel HS-0 por carril&lt;/td&gt;&lt;/tr&gt;
          &lt;tr style=&quot;background:#EAF1F5;&quot;&gt;&lt;td&gt;↓0&lt;/td&gt;&lt;td&gt;W0: 3E/70&lt;/td&gt;&lt;td&gt;WORD: SoT (registro previo)&lt;/td&gt;&lt;td&gt;P₀&lt;/td&gt;&lt;td&gt;0 0 0 1 1 1 0 1 en D0 y D1&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;↓1&lt;/td&gt;&lt;td&gt;W1: 08/13&lt;/td&gt;&lt;td&gt;WORD: W0&lt;/td&gt;&lt;td&gt;P₁&lt;/td&gt;&lt;td&gt;W0 b0…b7, contiguo a SoT&lt;/td&gt;&lt;/tr&gt;
          &lt;tr style=&quot;background:#EAF1F5;&quot;&gt;&lt;td&gt;↓2…↓1081&lt;/td&gt;&lt;td&gt;W2…W1081: píxeles&lt;/td&gt;&lt;td&gt;WORD: W1…W1080&lt;/td&gt;&lt;td&gt;Pᵢ&lt;/td&gt;&lt;td&gt;b0…b7 de cada byte; ↑ para j par y ↓ para j impar&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;↓1082&lt;/td&gt;&lt;td&gt;W1082: CRC bajo/alto&lt;/td&gt;&lt;td&gt;WORD: W1081, últimos píxeles&lt;/td&gt;&lt;td&gt;P₁₀₈₂&lt;/td&gt;&lt;td&gt;Últimos píxeles b0…b7&lt;/td&gt;&lt;/tr&gt;
          &lt;tr style=&quot;background:#EAF1F5;&quot;&gt;&lt;td&gt;↓1083&lt;/td&gt;&lt;td&gt;00/00 sin dato · HS_REQ bajo&lt;/td&gt;&lt;td&gt;WORD: CRC y su b7 por carril&lt;/td&gt;&lt;td&gt;P₁₀₈₃&lt;/td&gt;&lt;td&gt;CRC b0…b7, ocho UI completos en Q0&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;↓1084…&lt;/td&gt;&lt;td&gt;Sin dato&lt;/td&gt;&lt;td&gt;TRAIL, no captura del packer&lt;/td&gt;&lt;td&gt;Pᵢ&lt;/td&gt;&lt;td&gt;Nivel ¬LAST_BIT, desde el UI siguiente al CRC&lt;/td&gt;&lt;/tr&gt;
          &lt;tr style=&quot;background:#EAF1F5;&quot;&gt;&lt;td&gt;↓(1084 + T_TRAIL)&lt;/td&gt;&lt;td&gt;Sin dato&lt;/td&gt;&lt;td&gt;OFF, fin del trail lógico&lt;/td&gt;&lt;td&gt;Pᵢ&lt;/td&gt;&lt;td&gt;Relleno 0; el cierre del OE es externo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=13;fillColor=#F5F8FA;strokeColor=#8798A4;fontSize=17;fontColor=#20313F;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="659" width="1770" height="339" as="geometry"/>
        </mxCell>
        <mxCell id="timing-note" value="&lt;b style=&quot;font-size:21px&quot;&gt;Latencia y habilitación&lt;/b&gt;&lt;br&gt;UI ≈ 2,273 ns · T&lt;sub&gt;byte&lt;/sub&gt; ≈ 18,182 ns. ↓i → Pᵢ: 9,091 ns nominales.&lt;br&gt;GW2A prim_sim (HWL=false): Pᵢ → Fᵢ de 5 a 8 ciclos FCLK con subidas nominales coincidentes, según la fase tras reset. δ = Fᵢ − ↓i ≈ 31,82…45,45 ns en ese modelo.&lt;br&gt;Si el OE se cierra en ↓(1084 + T_TRAIL), quedan T_TRAIL·T&lt;sub&gt;byte&lt;/sub&gt; − δ de trail. Con 1 slot se trunca el CRC; con 4 quedan 27,27…40,91 ns.&lt;br&gt;Mínimo D-PHY forward: ≈69,09 ns. Siete slots cubren el ejemplo nominal. Falta validar δ y acordar la ventana física de salida; ISO corta aparte." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=13;fillColor=#F6F0E6;strokeColor=#AD9270;fontColor=#20313F;fontSize=17;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="1017" width="866" height="209" as="geometry"/>
        </mxCell>
        <mxCell id="routing-note" value="&lt;b style=&quot;font-size:21px&quot;&gt;Bank 1 · dos destinos simultáneos&lt;/b&gt;&lt;br&gt;D0 117/116 (IOT40A/B, X39Y0) · D1 115/114 (IOT42A/B, X41Y0).&lt;br&gt;Cotejo estático: CLKOUTD → GCLK → CLK0 (PCLK); CLKOUT → HCLK superior, sección 1 → HCLK_OUT1 → FCLKA. Los dos sitios admiten esas entradas dedicadas.&lt;br&gt;PR #13 solo llegó a CLKDIV de la sección 0. Falta enrutar los dos OSER8 juntos y comprobar setup/hold, fase PCLK/FCLK y liberación del reset común en ambos sitios." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=13;fillColor=#EEF3F7;strokeColor=#8BA1B2;fontColor=#20313F;fontSize=17;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="920" y="1017" width="882" height="209" as="geometry"/>
        </mxCell>
        <mxCell id="refs" value="Contrato: MIPI_PHY_bloques.pdf · Gowin UG289 §4.3.4 / DS226 tabla 3-17 · Tektronix D-PHY MOI, pruebas 1.3.3 y 1.3.13" style="text;html=1;align=left;spacing=0;fontSize=15;fontColor=#344654;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="1233" width="1770" height="21" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
