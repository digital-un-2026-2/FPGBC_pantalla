<mxfile host="app.diagrams.net" type="device">
  <diagram id="supervisor-flow" name="Flujo">
    <mxGraphModel page="1" pageWidth="1280" pageHeight="1120" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="PHY_SUPERVISOR — arranque, corte y recuperación" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1180" height="40" as="geometry"/></mxCell>
        <mxCell id="wait" value="&lt;b&gt;WAIT_REF&lt;/b&gt;&lt;br&gt;RESET = 1 · RST_BYTE = 1&lt;br&gt;Vigilar CLK_REF y CLK_BYTE desde CLK_WD" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="85" y="95" width="390" height="75" as="geometry"/></mxCell>
        <mxCell id="ref" value="¿REF_OK durante&lt;br&gt;64 ciclos de CLK_WD?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="140" y="200" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="acq" value="&lt;b&gt;ACQUIRE&lt;/b&gt;&lt;br&gt;RESET = 0 · RST_BYTE = 1&lt;br&gt;Exigir pruebas frescas de CLK_BYTE" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="85" y="340" width="390" height="75" as="geometry"/></mxCell>
        <mxCell id="qualified" value="¿62 000 ciclos con ambos&lt;br&gt;relojes activos, LOCK_RAW alto&lt;br&gt;y sin RST_LINK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="115" y="450" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="pair" value="&lt;b&gt;ENABLED: rearme local en CLK_BYTE&lt;/b&gt;&lt;br&gt;Mantener RST_BYTE = 1 en ↑ P3 y ↓ siguiente&lt;br&gt;Liberar después de ↑ P4" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="85" y="630" width="390" height="80" as="geometry"/></mxCell>
        <mxCell id="rom" value="&lt;b&gt;Enlace en servicio&lt;/b&gt;&lt;br&gt;PHY_CTRL se rearma por su contrato habitual.&lt;br&gt;INIT_SEQUENCER repite INIT_MEM desde 0." style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="85" y="745" width="390" height="80" as="geometry"/></mxCell>
        <mxCell id="w1" edge="1" parent="1" source="wait" target="ref" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w2" value="Sí" edge="1" parent="1" source="ref" target="acq" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w3" value="No" edge="1" parent="1" source="ref" target="wait" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="255"/><mxPoint x="55" y="132"/></Array></mxGeometry></mxCell>
        <mxCell id="w4" edge="1" parent="1" source="acq" target="qualified" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w5" value="Sí" edge="1" parent="1" source="qualified" target="pair" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w6" value="No" edge="1" parent="1" source="qualified" target="acq" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="522"/><mxPoint x="55" y="377"/></Array></mxGeometry></mxCell>
        <mxCell id="w7" edge="1" parent="1" source="pair" target="rom" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fault" value="&lt;b&gt;Durante rearme o servicio&lt;/b&gt;&lt;br&gt;Pérdida de actividad → RST_BYTE = 1, vuelta a WAIT_REF.&lt;br&gt;LOCK_RAW bajo o RST_LINK → RST_BYTE = 1, vuelta a ACQUIRE.&lt;br&gt;El corte por ISO no espera a CLK_BYTE." style="whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="875" width="390" height="145" as="geometry"/></mxCell>
        <mxCell id="w8" value="Fallo" edge="1" parent="1" source="rom" target="fault" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#b85450;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="table" value="&lt;b&gt;Tabla de arranque, pérdida y recuperación&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellspacing='0' cellpadding='8' style='border-collapse:collapse;width:100%'&gt;&lt;tr bgcolor='#dae8fc'&gt;&lt;th&gt;Evento&lt;/th&gt;&lt;th&gt;RESET / RST_BYTE / efecto&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RST_SUP o arranque sin referencia&lt;/td&gt;&lt;td&gt;1 / 1; ISO = 1. Sin prueba de REF no se libera la PLL.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Referencia de vuelta&lt;/td&gt;&lt;td&gt;64 ciclos continuos con REF_OK; luego 0 / 1. Este intervalo supera los ≥10 ns de RESET de la PLL.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Adquisición / LOCK_RAW inestable&lt;/td&gt;&lt;td&gt;0 / 1. Cada caída reconocida borra la ventana de 2 ms, incluso entre muestras. Tras 124 000 ciclos sin cualificar, volver a WAIT_REF y reintentar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CLK_REF parado, LOCK_RAW = 1&lt;/td&gt;&lt;td&gt;1 / 1 al vencer REF_OK; ISO inhibe los doce pads sin CLK_BYTE, incluso si BYTE seguía activo.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CLK_BYTE parado, LOCK_RAW = 1&lt;/td&gt;&lt;td&gt;1 / 1 al vencer BYTE_OK en ENABLED; el mismo corte, aunque REF siga activo. En ACQUIRE ya hay aislamiento; recupera el plazo de reintento.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LOCK_RAW ↓ o RST_LINK durante tráfico&lt;/td&gt;&lt;td&gt;ISO corta sin flancos; RST_BYTE = 1. Con REF y BYTE activos, RESET queda en 0. RST_LINK mantenido inhibe la cualificación y el plazo de reintento.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Recuperación&lt;/td&gt;&lt;td&gt;62 000 ciclos válidos completos; después nuevo ↑ y ↓ con RST_BYTE = 1 y LOCK_RAW válido. Soltar tras ↑ P4 y arrancar la ROM desde 0; se descarta el paquete interrumpido.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Objetivos de diseño:&lt;/b&gt; 64 ciclos = 2,06–3,37 µs; corte por pérdida de flancos &amp;lt;3,7 µs (hasta 70 ciclos presupuestados, más propagación a pads); cualificación = 2,00–3,27 ms; plazo por intento = 4,00–6,53 ms. Los plazos suponen CLK_WD operativo y CDC con latencia normal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alcance:&lt;/b&gt; reset del enlace. PANEL_RST, alimentación y backlight corresponden al TOP. Repetir la ROM no certifica recuperación del panel físico." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="530" y="94" width="710" height="890" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="supervisor-datapath" name="Datapath">
    <mxGraphModel page="1" pageWidth="1440" pageHeight="1290" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="PHY_SUPERVISOR — dominios y conexiones (puertos de 1 bit)" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1360" height="40" as="geometry"/></mxCell>
        <mxCell id="frame" value="&lt;b&gt;PHY_SUPERVISOR&lt;/b&gt;" style="html=1;align=left;verticalAlign=top;spacing=12;fillColor=none;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="270" y="75" width="900" height="590" as="geometry"/></mxCell>
        <mxCell id="osc" value="&lt;b&gt;OSC Gowin → BUFG&lt;/b&gt;&lt;br&gt;FREQ_DIV = 10&lt;br&gt;&lt;font color='#755199'&gt;CLK_WD →&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="303" y="125" width="163" height="80" as="geometry"/></mxCell>
        <mxCell id="watch" value="&lt;b&gt;Vigilancia REF / BYTE&lt;/b&gt;&lt;br&gt;2 canales REQ/ACK&lt;br&gt;&lt;font color='#755199'&gt;CLK_WD&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="225" height="180" as="geometry"/></mxCell>
        <mxCell id="portswatch" value="&lt;font color='#157c72'&gt;CLK_REF&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#356cbb'&gt;CLK_BYTE&lt;/font&gt;" style="text;html=1;align=left;spacingLeft=7;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="222" width="95" height="68" as="geometry"/></mxCell>
        <mxCell id="fsm" value="&lt;b&gt;FSM + temporizadores&lt;/b&gt;&lt;br&gt;&lt;font color='#755199'&gt;CLK_WD&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#456539'&gt;REF_OK, BYTE_OK, BYTE_ACK&lt;/font&gt;&lt;br&gt;&lt;font color='#795620'&gt;LOCK_OK, LINK_OK&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="855" y="130" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="resetport" value="&lt;font color='#a55819'&gt;RESET →&lt;/font&gt;" style="text;html=1;fontSize=13;align=right;spacingRight=7;" vertex="1" parent="1"><mxGeometry x="1025" y="205" width="100" height="30" as="geometry"/></mxCell>
        <mxCell id="allowport" value="&lt;font color='#516b91'&gt;ALLOW ↓&lt;/font&gt;" style="text;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="275" width="78" height="25" as="geometry"/></mxCell>
        <mxCell id="qual" value="&lt;b&gt;Captura de caída / reset&lt;/b&gt;&lt;br&gt;&lt;font color='#755199'&gt;CLK_WD&lt;/font&gt; · 4 FF + CDC de 2 FF&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#795620'&gt;LOCK_OK, LINK_OK →&lt;/font&gt;&lt;br&gt;&lt;font color='#9b4b29'&gt;LOCK_FAST, LINK_FAST →&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="540" y="370" width="225" height="145" as="geometry"/></mxCell>
        <mxCell id="rearm" value="&lt;b&gt;Liberación local de reset&lt;/b&gt;&lt;br&gt;Aserción asíncrona · salida tras CLK_BYTE ↑&lt;br&gt;&lt;br&gt;&lt;font color='#516b91'&gt;ALLOW&lt;/font&gt; · &lt;font color='#9b4b29'&gt;LOCK_FAST, LINK_FAST&lt;/font&gt;&lt;br&gt;&lt;font color='#356cbb'&gt;CLK_BYTE&lt;/font&gt; · &lt;font color='#b02e34'&gt;RST_BYTE →&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="855" y="395" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="ref" value="&lt;b&gt;Referencia TOP&lt;/b&gt;&lt;br&gt;&lt;font color='#157c72'&gt;CLK_REF →&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="165" height="70" as="geometry"/></mxCell>
        <mxCell id="src" value="&lt;b&gt;phy / clock_gen&lt;/b&gt;&lt;br&gt;&lt;font color='#356cbb'&gt;CLK_BYTE →&lt;/font&gt;&lt;br&gt;&lt;font color='#a14572'&gt;LOCK_RAW →&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="165" height="115" as="geometry"/></mxCell>
        <mxCell id="top" value="&lt;b&gt;Reset desde TOP&lt;/b&gt;&lt;br&gt;&lt;font color='#aa671c'&gt;RST_LINK →&lt;/font&gt;&lt;br&gt;&lt;font color='#606060'&gt;RST_SUP →&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="165" height="95" as="geometry"/></mxCell>
        <mxCell id="to_pll" value="&lt;b&gt;phy → rPLL&lt;/b&gt;&lt;br&gt;&lt;font color='#a55819'&gt;RESET&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1225" y="185" width="175" height="70" as="geometry"/></mxCell>
        <mxCell id="to_byte" value="&lt;b&gt;Dominio BYTE&lt;/b&gt;&lt;br&gt;&lt;font color='#b02e34'&gt;RST_BYTE&lt;/font&gt;&lt;br&gt;phy → ISO → pads&lt;br&gt;MIPI_TX · INIT_SEQUENCER&lt;br&gt;VIDEO_SOURCE" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1205" y="395" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="inputs" value="&lt;font color='#a14572'&gt;LOCK_RAW&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#aa671c'&gt;RST_LINK&lt;/font&gt;" style="text;html=1;align=left;spacingLeft=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="408" width="95" height="65" as="geometry"/></mxCell>
        <mxCell id="reset_tree" value="&lt;b&gt;RST_SUP&lt;/b&gt;: 1 asíncrono por dominio; quitarlo con 2 FF en ↓ del reloj local (FF a 1 con reset, desplazar 0). Inicializar las cadenas a 1 o aplicar RST_SUP de arranque. RST_SUP fuerza RST_BYTE inmediatamente. El oscilador sigue habilitado. Esta red resetea los FF de vigilancia y control; ni RESET de PLL ni RST_BYTE resetean el monitor." style="whiteSpace=wrap;html=1;align=left;spacing=9;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="305" y="560" width="820" height="75" as="geometry"/></mxCell>
        <mxCell id="o1a" edge="1" parent="1" source="osc" target="branchw" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#755199;exitX=1;exitY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="branchw" style="ellipse;fillColor=#755199;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="499" y="161" width="8" height="8" as="geometry"/></mxCell>
        <mxCell id="o1" edge="1" parent="1" source="branchw" target="watch" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#755199;entryX=0;entryY=0.19;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o1b" edge="1" parent="1" source="branchw" target="fsm" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#755199;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="503" y="111"/><mxPoint x="990" y="111"/></Array></mxGeometry></mxCell>
        <mxCell id="o1c" edge="1" parent="1" source="branchw" target="qual" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#755199;jumpStyle=gap;jumpSize=8;entryX=0;entryY=0.22;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="503" y="402"/></Array></mxGeometry></mxCell>
        <mxCell id="o2" edge="1" parent="1" source="ref" target="watch" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#157c72;entryX=0;entryY=0.56;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o3" edge="1" parent="1" source="src" target="watch" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#356cbb;exitX=1;exitY=0.3;entryX=0;entryY=0.8;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="305"/><mxPoint x="350" y="274"/></Array></mxGeometry></mxCell>
        <mxCell id="o4" edge="1" parent="1" source="src" target="qual" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#a14572;exitX=1;exitY=0.72;entryX=0;entryY=0.33;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="353"/><mxPoint x="370" y="418"/></Array></mxGeometry></mxCell>
        <mxCell id="o5" edge="1" parent="1" source="top" target="qual" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#aa671c;exitX=1;exitY=0.35;entryX=0;entryY=0.6;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o6" edge="1" parent="1" source="watch" target="fsm" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#456539;exitX=1;exitY=0.65;entryX=0;entryY=0.69;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o7" edge="1" parent="1" source="qual" target="fsm" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#795620;exitX=1;exitY=0.56;entryX=0;entryY=0.85;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="451"/><mxPoint x="805" y="274"/></Array></mxGeometry></mxCell>
        <mxCell id="o8" edge="1" parent="1" source="fsm" target="rearm" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#516b91;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o9" edge="1" parent="1" source="fsm" target="to_pll" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#a55819;exitX=1;exitY=0.53;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o10" edge="1" parent="1" source="rearm" target="to_byte" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#b02e34;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o11" edge="1" parent="1" source="top" target="reset_tree" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#606060;exitX=1;exitY=0.7;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="516"/><mxPoint x="245" y="597"/></Array></mxGeometry></mxCell>
        <mxCell id="branch" style="ellipse;fillColor=#356cbb;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="346" y="301" width="8" height="8" as="geometry"/></mxCell>
        <mxCell id="o12" edge="1" parent="1" source="branch" target="rearm" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#356cbb;jumpStyle=gap;jumpSize=8;entryX=0;entryY=0.9;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="535"/><mxPoint x="835" y="535"/><mxPoint x="835" y="503"/></Array></mxGeometry></mxCell>
        <mxCell id="o13" edge="1" parent="1" source="qual" target="rearm" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#9b4b29;exitX=1;exitY=0.83;entryX=0;entryY=0.79;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="notes-bg" style="fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1360" height="550" as="geometry"/></mxCell>
        <mxCell id="notes-sep1" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="488" y="700" width="1" height="550" as="geometry"/></mxCell>
        <mxCell id="notes-sep2" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="950" y="700" width="1" height="550" as="geometry"/></mxCell>
        <mxCell id="cdc" value="&lt;b&gt;Prueba de flancos (x2, sin alias)&lt;/b&gt;&lt;br&gt;&lt;br&gt;REQ se mantiene hasta que vuelve ACK = REQ. ACK = segunda etapa de REQ sincronizado en dos ↓ del reloj probado y retorna por dos FF en CLK_WD ↓. Sin flancos no hay nuevo ACK; una prueba pendiente puede completarse una vez tras la parada.&lt;br&gt;&lt;br&gt;En CLK_WD ↓: REQ, SENT y OK (1 bit c/u) y AGE[6:0] inician en 0. Primer ↓ lanza REQ=1 y pone SENT=1. Éxito combinacional = SENT y ACK sincronizado igual a REQ. En el mismo ↓ del éxito, contar la prueba (BYTE_ACK), poner OK=1 y AGE=0, e invertir REQ. En espera avanzar AGE (satura a 64), borrar OK a 64 y conservar REQ. FF CDC a 0 por reset local; solo se usa la segunda etapa.&lt;br&gt;&lt;br&gt;Presupuesto de corte: hasta 4 ciclos para el último ACK en vuelo, 64 para vencer y 2 para decisión y margen. No mide frecuencia, fase, flancos de CLK_HS ni fallos de la red de un consumidor individual." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="440" height="550" as="geometry"/></mxCell>
        <mxCell id="timing" value="&lt;b&gt;Base de tiempo y temporizadores&lt;/b&gt;&lt;br&gt;&lt;br&gt;DS226-2.7E §2.11: 250 MHz / 10 = 25 MHz nominal. Tabla 3-19 a 125 MHz: 100–150 MHz entre −40 y +100 °C (±20%, no la tolerancia MSPI). Trasladar por el divisor: 20–30 MHz; usar 19–31 MHz como margen de diseño (incluye holgura sobre el jitter publicado).&lt;br&gt;&lt;br&gt;En CLK_WD ↓: REF_CNT[6:0] satura a 64 con REF_OK en WAIT_REF. QUAL_CNT[15:0] satura a 62 000 en ACQUIRE con REF_OK, BYTE_OK, LOCK_OK, LINK_OK y prueba fresca de BYTE. TRY_CNT[16:0] satura a 124 000 en ACQUIRE con LINK_OK. Todos a 0 por reset local y cuando su condición sea falsa.&lt;br&gt;&lt;br&gt;BYTE_PROOFS[1:0] satura en 2, en ↓ con BYTE_ACK (0 por reset local, fuera de ACQUIRE o !BYTE_OK). El primer retorno puede venir del estado anterior; el segundo exige un REQ posterior a la entrada.&lt;br&gt;&lt;br&gt;Para cada fallo: STRETCH[3:0] desplaza 1 en ↓; borrado asíncrono a 0000 por !LOCK_RAW o RST_LINK, respectivamente, o reset local. El bit alto da LOCK_FAST / LINK_FAST. OBSERVE[1:0] sincroniza ese bit en ↓, a 00 por reset local, y da LOCK_OK / LINK_OK. El pulso debe cumplir el mínimo de borrado de la primitiva." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="440" height="550" as="geometry"/></mxCell>
        <mxCell id="flanks" value="&lt;b&gt;Flancos de rearme · CLK_BYTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;CUT_REQ = RST_SUP || !ALLOW || !LOCK_FAST || !LINK_FAST. Borra PERMIT[1:0] a 00 sin reloj. !PERMIT[1] borra UP_SEEN y PAIR_SEEN a 0 y presetea RST_BYTE a 1, también sin reloj. Verificar recovery/removal y caminos de medio ciclo.&lt;br&gt;&lt;br&gt;&lt;table border='1' cellspacing='0' cellpadding='6' style='border-collapse:collapse;width:100%'&gt;&lt;tr bgcolor='#dae8fc'&gt;&lt;th&gt;Flanco&lt;/th&gt;&lt;th&gt;Registro / efecto&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↑ P1/P2&lt;/td&gt;&lt;td&gt;PERMIT: 00 → 01 → 11; RST_BYTE sigue en 1.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↑ P3&lt;/td&gt;&lt;td&gt;UP_SEEN captura 1; FSM de byte ve reset.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓ después de P3&lt;/td&gt;&lt;td&gt;PAIR_SEEN captura UP_SEEN; datapath ve reset y PHY_CTRL observa reset con LOCK_RAW alto.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↑ P4&lt;/td&gt;&lt;td&gt;RST_BYTE captura !PAIR_SEEN; la salida baja después del flanco, los consumidores aún ven reset en P4.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓ siguiente / ↑ P5&lt;/td&gt;&lt;td&gt;Primer ↓ y ↑ sin reset. Verificar setup/hold en los consumidores.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Exponer LOCK_RAW del mismo nodo que alimenta PHY_CTRL. Tomar CLK_BYTE de la red existente de CLKOUTD usada por los consumidores y CLK_REF de la misma entrada que rPLL.CLKIN." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="440" height="550" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="supervisor-fsm" name="FSM">
    <mxGraphModel page="1" pageWidth="1280" pageHeight="925" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="PHY_SUPERVISOR — FSM en ↑ CLK_WD" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="rst" value="Reset local de CLK_WD&lt;br&gt;(asíncrono en la aserción)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="65" y="100" width="285" height="55" as="geometry"/></mxCell>
        <mxCell id="wait" value="&lt;b&gt;WAIT_REF · 2'b10&lt;/b&gt;&lt;br&gt;RESET = 1 · ALLOW = 0&lt;br&gt;&lt;br&gt;Esperar REF_CNT = 64 y REF_OK" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="65" y="235" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="acq" value="&lt;b&gt;ACQUIRE · 2'b00&lt;/b&gt;&lt;br&gt;RESET = 0 · ALLOW = 0&lt;br&gt;&lt;br&gt;Contar actividad y LOCK_RAW estable" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="485" y="235" width="305" height="110" as="geometry"/></mxCell>
        <mxCell id="run" value="&lt;b&gt;ENABLED · 2'b01&lt;/b&gt;&lt;br&gt;RESET = 0 · ALLOW = 1&lt;br&gt;&lt;br&gt;Primero rearme local; luego tráfico" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="930" y="235" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="f1" edge="1" parent="1" source="rst" target="wait" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#b85450;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="REF_CNT = 64&lt;br&gt;y REF_OK" edge="1" parent="1" source="wait" target="acq" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;exitX=1;exitY=0.28;entryX=0;entryY=0.28;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="QUAL_CNT = 62 000&lt;br&gt;y condiciones vigentes" edge="1" parent="1" source="acq" target="run" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;exitX=1;exitY=0.28;entryX=0;entryY=0.28;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="!REF_OK o&lt;br&gt;fin de intento" edge="1" parent="1" source="acq" target="wait" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#b85450;exitX=0;exitY=0.78;entryX=1;entryY=0.78;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="!LOCK_OK&lt;br&gt;o !LINK_OK" edge="1" parent="1" source="run" target="acq" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#b85450;html=1;exitX=0;exitY=0.78;entryX=1;entryY=0.78;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="!REF_OK o !BYTE_OK" edge="1" parent="1" source="run" target="wait" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1072" y="415"/><mxPoint x="207" y="415"/></Array></mxGeometry></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Prioridad y plazos&lt;/b&gt;&lt;br&gt;&lt;br&gt;En todos los estados: RST_SUP asíncrono fuerza WAIT_REF. En ENABLED la pérdida de reloj tiene prioridad sobre la pérdida de LOCK_OK o LINK_OK. En ACQUIRE: !REF_OK → WAIT_REF; si la ventana se completó y siguen válidas sus condiciones, → ENABLED; si TRY_CNT = 124 000 con LINK_OK, → WAIT_REF. Si ninguna transición aplica, conservar el estado. Estado inválido 11 → WAIT_REF, con corte y RESET activos mientras tanto.&lt;br&gt;&lt;br&gt;Registros de la FSM: STATE[1:0] actualiza en ↑ CLK_WD y va a 10 en reset activo alto; decodificar RESET=STATE[1] y ALLOW=STATE[0] &amp;amp;&amp;amp; !STATE[1]. Conservar la codificación en síntesis. El corte de ALLOW se aserta incluso con BYTE detenido.&lt;br&gt;&lt;br&gt;Los contadores capturan en ↓ y sus comparadores alimentan el ↑ siguiente. LOCK_FAST/LINK_FAST bajan asíncronamente y el bajo se sostiene durante ≥3 periodos para que la FSM y los contadores lo observen tras dos FF, como LOCK_OK/LINK_OK. Revisar recovery/removal y caminos de medio ciclo. No se usa READY ni el LOCK cualificado del PHY." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;" vertex="1" parent="1"><mxGeometry x="65" y="465" width="1150" height="275" as="geometry"/></mxCell>
        <mxCell id="checks" value="&lt;b&gt;Validación tras aprobar el diseño&lt;/b&gt; · Arranque sin REF; rebotes y pulso entre muestras de LOCK_RAW; pérdida por separado de REF y BYTE con LOCK_RAW alto; reset lógico en transmisión; recuperación con el PHY modelado. Verificar alta impedancia de los doce pads sin reloj, par ↑/↓ nuevo, ROM completa desde dirección 0 y ausencia de continuación del paquete abortado." style="whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#eef5fb;strokeColor=#6c8eb7;fontSize=15;" vertex="1" parent="1"><mxGeometry x="65" y="765" width="1150" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
