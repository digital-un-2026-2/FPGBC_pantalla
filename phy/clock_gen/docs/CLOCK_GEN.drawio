        <mxCell id="byte-to-tx" style="edgeStyle=segmentEdgeStyle;rounded=0;endArrow=block;endSize=8;endFill=1;strokeColor=#A65114;strokeWidth=2.25;exitX=0.5;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.6375;entryPerimeter=0;" edge="1" parent="1" source="byte-j2" target="tx">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1059" y="661"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="raw-to-ctrl" style="edgeStyle=segmentEdgeStyle;rounded=0;endArrow=block;endSize=8;endFill=1;strokeColor=#267744;strokeWidth=2.25;jumpStyle=gap;jumpSize=8;exitX=1;exitY=0.9358670;exitPerimeter=0;entryX=0;entryY=0.7410714;entryPerimeter=0;" edge="1" parent="1" source="pll" target="ctrl">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1007" y="554"/><mxPoint x="1007" y="567"/></Array>
