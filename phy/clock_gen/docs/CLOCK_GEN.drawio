        </mxCell>
        <mxCell id="reset-review" value="&lt;b&gt;Arranque y reset común&lt;/b&gt;&lt;br&gt;CLK_REQ no gobierna estos relojes. RST_BYTE no reinicia la PLL.&lt;br&gt;Con referencia estable, liberar RESET de la PLL; sostener RST_BYTE al volver los flancos.&lt;br&gt;LOCK_RAW puede tener glitches durante la adquisición; observarlo ≥2 ms." style="rounded=0;html=1;fillColor=#F4F8FA;strokeColor=#A1B2BF;strokeWidth=1.25;whiteSpace=wrap;align=left;spacingLeft=14;spacingRight=14;fontSize=16;fontColor=#20313F;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="714" width="742" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="phase-review" value="&lt;b&gt;Reloj físico y protección pendientes&lt;/b&gt;&lt;br&gt;CLOCK_DDR recibe la fase base; el ajuste local busca centrar los flancos (≈1,136 ns).&lt;br&gt;Sonda hasta HCLK superior; faltan FCLK/PCLK de E/S y medición CLK/D0/D1.&lt;br&gt;LOCK_RAW no sustituye a un detector de reloj parado." style="rounded=0;html=1;fillColor=#F4F8FA;strokeColor=#A1B2BF;strokeWidth=1.25;whiteSpace=wrap;align=left;spacingLeft=14;spacingRight=14;fontSize=16;fontColor=#20313F;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="792" y="714" width="752" height="108" as="geometry"/>
        </mxCell>
