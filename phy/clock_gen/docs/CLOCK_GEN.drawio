        <mxCell id="lock-to-tx" style="edgeStyle=segmentEdgeStyle;rounded=0;endArrow=block;endSize=8;endFill=1;strokeColor=#90466D;strokeWidth=2.25;exitX=1;exitY=0.7410714;exitPerimeter=0;entryX=1;entryY=0.6375;entryPerimeter=0;" edge="1" parent="1" source="ctrl" target="tx">
