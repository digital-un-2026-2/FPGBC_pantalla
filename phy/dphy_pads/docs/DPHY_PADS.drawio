        </mxCell>
        <mxCell id="note-0" value="Por grupo: modo 00/11 = Z; 01 = símbolo LP; 10 = polarización 00. DRIVE indica modo 01 y selecciona LP_P / LP_N en I." vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#172c3a;fontStyle=0;">
          <mxGeometry as="geometry" x="42" y="981" width="1135" height="23" />
        </mxCell>
        <mxCell id="note-1" value="Con modo 01 y petición HS se aíslan ambos drivers del grupo. HS solo conduce en modo 10 y con su OE lógico activo." vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#172c3a;fontStyle=0;">
          <mxGeometry as="geometry" x="42" y="1008" width="1135" height="23" />
        </mxCell>
        <mxCell id="note-2" value="OEN=0 conduce; OEN=1 deja Z. ISO domina los cuatro OEN combinacionalmente, incluso con ambos relojes detenidos." vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#172c3a;fontStyle=0;">
          <mxGeometry as="geometry" x="42" y="1035" width="1135" height="23" />
        </mxCell>
        <mxCell id="note-3" value="Por conductor: pad LP → 100 Ω → nodo del panel; pad HS → mismo nodo. Los números son pines de la FPGA." vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#172c3a;fontStyle=0;">
          <mxGeometry as="geometry" x="42" y="1062" width="1135" height="23" />
        </mxCell>
      </root>
