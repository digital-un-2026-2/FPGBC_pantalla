        <mxCell id="controls-title" value="Habilitación física y ramas de la placa" vertex="1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#172c3a;fontStyle=1;">
