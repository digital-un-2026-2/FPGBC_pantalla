<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="phy-ctrl-flow" name="Flujo">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1570" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="PHY_CTRL — flujo LP / HS" style="text;html=1;align=left;fontSize=31;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="32" y="20" width="1500" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Control interno del PHY · ↑ decide, ↓ captura · adopción lógica del modelo de MIPI_TX (PR #11)" style="text;html=1;align=left;fontSize=17;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="33" y="72" width="1500" height="30" as="geometry"/></mxCell>
        <mxCell id="start" value="RESET / arranque" style="text;html=1;align=center;fontSize=17;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="271" y="111" width="208" height="26" as="geometry"/></mxCell>
        <mxCell id="safe" value="&lt;b&gt;SAFE&lt;/b&gt;&lt;br&gt;LP_EN = HS_EN = CLK_EN = 0&lt;br&gt;Recuperar reloj y confirmar reset común" style="html=1;whiteSpace=wrap;fillColor=#F5E6DE;strokeColor=#435965;fontColor=#20313F;fontSize=17;" vertex="1" parent="1"><mxGeometry x="185" y="156" width="380" height="72" as="geometry"/></mxCell>
        <mxCell id="qready" value="&lt;b&gt;¿RUN y HS_Q = CLK_Q = 0?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FAF1DD;strokeColor=#435965;fontColor=#20313F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="225" y="250" width="300" height="74" as="geometry"/></mxCell>
        <mxCell id="lp" value="&lt;b&gt;LP&lt;/b&gt;&lt;br&gt;Al aplicar SLOT = LP: LP_EN = 1, READY = 1&lt;br&gt;HS_EN = CLK_EN = 0 (también durante LPDT)" style="html=1;whiteSpace=wrap;fillColor=#DCECF2;strokeColor=#435965;fontColor=#20313F;fontSize=17;" vertex="1" parent="1"><mxGeometry x="185" y="351" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="qclk" value="&lt;b&gt;¿CLK_Q = 1?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FAF1DD;strokeColor=#435965;fontColor=#20313F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="255" y="448" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="arm" value="&lt;b&gt;ARM_CLK&lt;/b&gt;&lt;br&gt;READY = 0, CLK_ARM = 1 (interno)&lt;br&gt;Mantener LP_EN; reloj físico aún aislado" style="html=1;whiteSpace=wrap;fillColor=#DCECF2;strokeColor=#435965;fontColor=#20313F;fontSize=17;" vertex="1" parent="1"><mxGeometry x="185" y="540" width="380" height="74" as="geometry"/></mxCell>
        <mxCell id="qhs" value="&lt;b&gt;¿HS_Q = 1&lt;br&gt;con CLK_Q = 1?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FAF1DD;strokeColor=#435965;fontColor=#20313F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="248" y="636" width="254" height="76" as="geometry"/></mxCell>
        <mxCell id="zero" value="&lt;b&gt;ZERO&lt;/b&gt;&lt;br&gt;Soltar LP en ↑; en ↓ activar HS_EN y CLK_EN&lt;br&gt;Cero HS, sin carga; temporizar T_ZERO" style="html=1;whiteSpace=wrap;fillColor=#E5EFE1;strokeColor=#435965;fontColor=#20313F;fontSize=17;" vertex="1" parent="1"><mxGeometry x="185" y="736" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="qzero" value="&lt;b&gt;¿DONE?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FAF1DD;strokeColor=#435965;fontColor=#20313F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="255" y="838" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="stream" value="&lt;b&gt;STREAM&lt;/b&gt;&lt;br&gt;Cargar en ↓ el registro anterior de PHY_IF&lt;br&gt;SoT, luego una palabra por ↓; también el último CRC" style="html=1;whiteSpace=wrap;fillColor=#E5EFE1;strokeColor=#435965;fontColor=#20313F;fontSize=17;" vertex="1" parent="1"><mxGeometry x="185" y="930" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="qfall" value="&lt;b&gt;¿HS_Q = 0&lt;br&gt;después del ↓?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FAF1DD;strokeColor=#435965;fontColor=#20313F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="248" y="1030" width="254" height="76" as="geometry"/></mxCell>
        <mxCell id="trail" value="&lt;b&gt;TRAIL&lt;/b&gt;&lt;br&gt;Completar el CRC antes de aplicar trail&lt;br&gt;T_TRAIL ciclos; HS_EN = CLK_EN = 1; sin cargas" style="html=1;whiteSpace=wrap;fillColor=#E5EFE1;strokeColor=#435965;fontColor=#20313F;fontSize=17;" vertex="1" parent="1"><mxGeometry x="185" y="1132" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="qtrail" value="&lt;b&gt;¿DONE?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FAF1DD;strokeColor=#435965;fontColor=#20313F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="255" y="1234" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="post" value="&lt;b&gt;POST_CLK&lt;/b&gt;&lt;br&gt;Al terminar el último slot de trail, apagar HS.&lt;br&gt;Mantener CLK_EN; no habilitar aún LP" style="html=1;whiteSpace=wrap;fillColor=#EAE6F2;strokeColor=#435965;fontColor=#20313F;fontSize=17;" vertex="1" parent="1"><mxGeometry x="185" y="1326" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="qpost" value="&lt;b&gt;¿HS_Q = CLK_Q = 0?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FAF1DD;strokeColor=#435965;fontColor=#20313F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="232" y="1424" width="286" height="68" as="geometry"/></mxCell>
        <mxCell id="e0" style="endArrow=block;strokeColor=#435965;strokeWidth=1.4;" edge="1" parent="1" source="start" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;strokeColor=#435965;strokeWidth=1.4;" edge="1" parent="1" source="safe" target="qready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Sí" style="endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qready" target="lp"><mxGeometry relative="1" as="geometry"><mxPoint x="20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e3" style="endArrow=block;strokeColor=#435965;strokeWidth=1.4;" edge="1" parent="1" source="lp" target="qclk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Sí" style="endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qclk" target="arm"><mxGeometry relative="1" as="geometry"><mxPoint x="20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e5" style="endArrow=block;strokeColor=#435965;strokeWidth=1.4;" edge="1" parent="1" source="arm" target="qhs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Sí" style="endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qhs" target="zero"><mxGeometry relative="1" as="geometry"><mxPoint x="20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e7" style="endArrow=block;strokeColor=#435965;strokeWidth=1.4;" edge="1" parent="1" source="zero" target="qzero"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Sí" style="endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qzero" target="stream"><mxGeometry relative="1" as="geometry"><mxPoint x="20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e9" style="endArrow=block;strokeColor=#435965;strokeWidth=1.4;" edge="1" parent="1" source="stream" target="qfall"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Sí" style="endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qfall" target="trail"><mxGeometry relative="1" as="geometry"><mxPoint x="20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e11" style="endArrow=block;strokeColor=#435965;strokeWidth=1.4;" edge="1" parent="1" source="trail" target="qtrail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="Sí" style="endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qtrail" target="post"><mxGeometry relative="1" as="geometry"><mxPoint x="20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e13" style="endArrow=block;strokeColor=#435965;strokeWidth=1.4;" edge="1" parent="1" source="post" target="qpost"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="back0" value="No" style="exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qready" target="safe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="287"/><mxPoint x="105" y="192"/></Array></mxGeometry></mxCell>
        <mxCell id="back1" value="No" style="exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qclk" target="lp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="481"/><mxPoint x="105" y="389"/></Array></mxGeometry></mxCell>
        <mxCell id="back2" value="No: CLK_Q = 1" style="exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qhs" target="arm"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="674"/><mxPoint x="105" y="577"/></Array></mxGeometry></mxCell>
        <mxCell id="back2cancel" value="No: ambas a 0" style="exitX=1;exitY=0.5;entryX=1;entryY=0.27;endArrow=block;strokeColor=#4F697C;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qhs" target="lp"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="7" y="0" as="offset"/><Array as="points"><mxPoint x="607" y="674"/><mxPoint x="607" y="372"/></Array></mxGeometry></mxCell>
        <mxCell id="back3" value="No" style="exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qzero" target="zero"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="871"/><mxPoint x="105" y="776"/></Array></mxGeometry></mxCell>
        <mxCell id="back4" value="No" style="exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qfall" target="stream"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="1068"/><mxPoint x="105" y="970"/></Array></mxGeometry></mxCell>
        <mxCell id="back5" value="No" style="exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qtrail" target="trail"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="1267"/><mxPoint x="105" y="1172"/></Array></mxGeometry></mxCell>
        <mxCell id="back6" value="No" style="exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;strokeColor=#435965;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="qpost" target="post"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="1458"/><mxPoint x="105" y="1364"/></Array></mxGeometry></mxCell>
        <mxCell id="return" value="Sí: apagar CLK en ↑;&lt;br&gt;LP habilitado en ↓ siguiente" style="html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.76;endArrow=block;strokeColor=#664788;strokeWidth=1.7;fontSize=15;labelBackgroundColor=#FFFFFF;jumpStyle=gap;jumpSize=10;" edge="1" parent="1" source="qpost" target="lp"><mxGeometry x="-0.83" relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/><Array as="points"><mxPoint x="375" y="1520"/><mxPoint x="678" y="1520"/><mxPoint x="678" y="409"/></Array></mxGeometry></mxCell>
        <mxCell id="table-head" value="Flancos de referencia — comparación con PR #11" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="745" y="152" width="805" height="37" as="geometry"/></mxCell>
        <mxCell id="notation" value="↑k va entre ↓k y ↓(k+1). c: primer ↓ con CLK_REQ=1; z: primer ↓ con HS_REQ=1.&lt;br&gt;s = z + T_ZERO + 1, f = s + 1083 (CRC), r = f + T_TRAIL + 1 (fin de trail).&lt;br&gt;↓s es el ↓0 del PR. Cada slot va de ↓k al ↓(k+1), sin incluir este último." style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="745" y="193" width="807" height="85" as="geometry"/></mxCell>
        <mxCell id="edges" value="&lt;table style=&quot;width:100%;border-collapse:collapse;text-align:left;line-height:1.32&quot; border=&quot;1&quot; cellpadding=&quot;9&quot;&gt;&lt;tr style=&quot;background:#e8edf2&quot;&gt;&lt;th style=&quot;width:125px&quot;&gt;Flanco&lt;/th&gt;&lt;th&gt;Acción lógica propuesta para el PHY&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reposo&lt;/td&gt;&lt;td&gt;LOCK indica reloj de trabajo cualificado. READY sube con LP disponible y sin reserva HS, aun con ambas peticiones a 0. LP11 son datos; LP_EN permite conducir.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓c → ↑c&lt;/td&gt;&lt;td&gt;Muestrea CLK_REQ. Arma la ruta del reloj reenviado; no lo conduce aún. Deja pasar LP01 / LP00 de datos con los drivers HS apagados.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓z → ↑z&lt;/td&gt;&lt;td&gt;Muestrea HS_REQ. En ↑z retira LP_EN. Todavía no habilita HS ni CLK físico: guardia lógica de medio ciclo.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓(z+1)…↓(s−1)&lt;/td&gt;&lt;td&gt;Cero HS y reloj reenviado habilitados. T_ZERO slots sin carga. En ↓(s−1), PHY_IF registra B8/B8; todavía no se toma.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓s, ↓(s+1), …&lt;/td&gt;&lt;td&gt;Modo WORD: carga SoT ya registrado mientras PHY_IF publica W0. Luego carga W0, W1 y el resto, de a un par por ↓ y sin VALID.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓(f−1) → ↓f&lt;/td&gt;&lt;td&gt;PHY_IF publica el CRC en ↓(f−1). En ↓f PHY_CTRL muestrea HS_REQ=0, pero el modo sigue en WORD: toma ese CRC previo, no el 00/00 entrante. No corta suministro al serializador.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↑f / ↓(f+1)&lt;/td&gt;&lt;td&gt;Cambia el modo para el siguiente ↓. Termina el CRC antes de iniciar el primer slot de TRAIL en ↓(f+1). No carga palabras desde ↓(f+1).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓r → ↑r&lt;/td&gt;&lt;td&gt;Acaba el último slot de trail. Quita HS_EN en ↓r; retiene CLK_EN. En ↑r, si ambas peticiones muestreadas están a 0, retira CLK_EN. Si no, mantiene solo el reloj.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓(r+1)&lt;/td&gt;&lt;td&gt;En el caso normal aplica LP_EN con LP11 ya publicado y vuelve a anunciar READY. No detiene CLK_BYTE.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="745" y="288" width="807" height="575" as="geometry"/></mxCell>
        <mxCell id="fault-note" value="&lt;b&gt;Aborto (prioridad en cualquier fase)&lt;/b&gt;&lt;br&gt;RST_BYTE=1 o caída de LOCK_RAW → ISO corta los drivers sin esperar ↑ ni ↓ y descarta la carga en curso. No hay drenaje ni trail normal. LOCK y READY pertenecen al dominio de byte; pueden quedar obsoletos sin flancos y no gobiernan el corte inmediato. Tras perder lock: esperar reset común con reloj recuperado y volver a LP sin retomar la transacción." style="html=1;whiteSpace=wrap;align=left;spacing=14;fillColor=#F5E6DE;strokeColor=#8698A4;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="745" y="924" width="807" height="140" as="geometry"/></mxCell>
        <mxCell id="clock-note" value="&lt;b&gt;Modo de reloj modelado: por ráfaga&lt;/b&gt;&lt;br&gt;CLK_REQ reserva el reloj físico desde el preámbulo; no es un gate de CLK_BYTE. En esta propuesta, LP y cualquier driver HS se excluyen. CLK_EN sube con ZERO, T_ZERO ciclos antes del SoT lógico, y baja después de datos/trail. CLK_REQ alto por sí solo prepara, pero no conduce durante el preámbulo LP.&lt;br&gt;&lt;br&gt;El contrato no fija fase, adelanto, retención ni modo de placa. Las dos guardias de medio ciclo señalan ventanas para verificar con los adaptadores; no son márgenes eléctricos medidos." style="html=1;whiteSpace=wrap;align=left;spacing=14;fillColor=#F3F6F8;strokeColor=#8698A4;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="745" y="1081" width="807" height="180" as="geometry"/></mxCell>
        <mxCell id="scope-note" value="&lt;b&gt;Frontera de revisión&lt;/b&gt;&lt;br&gt;Las dos lanes cargan juntas; WORD, ZERO y TRAIL se aplican por slot, no a mitad de un byte. OFF deja preparado el cero con el driver apagado. El modelo supone que una carga agota sus ocho bits antes del siguiente ↓. Si la primitiva solo carga en otro flanco, o su latencia cruza ese límite, no cumple el traspaso mostrado sin un adaptador validado; no desplazar el SoT ni el CRC en MIPI_TX.&lt;br&gt;&lt;br&gt;Sin puertos nuevos a MIPI_TX: no LP_REQ, PK_START, PK_DONE, SOT_EN ni VALID. PHY_CTRL no identifica palabras por contenido ni por longitud. Ver guardas y prioridades completas en FSM." style="html=1;whiteSpace=wrap;align=left;spacing=14;fillColor=#F3F6F8;strokeColor=#8698A4;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="745" y="1278" width="807" height="198" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phy-ctrl-datapath" name="Datapath">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1690" pageHeight="1190" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="PHY_CTRL — datapath y controles de modo" style="text;html=1;align=left;fontSize=31;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="32" y="20" width="1610" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Solo control: LP_P/N y HS_BYTE0/1 no atraviesan PHY_CTRL · fino: 1 bit · grueso: bus · punto: unión · corte: cruce" style="text;html=1;align=left;fontSize=17;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="33" y="73" width="1615" height="29" as="geometry"/></mxCell>
        <mxCell id="outline" value="PHY_CTRL" style="html=1;dashed=1;dashPattern=3 5;fillColor=#F8FAFB;strokeColor=#8196A4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=22;fontStyle=1;fontColor=#20313F;" vertex="1" connectable="0" parent="1"><mxGeometry x="303" y="115" width="1045" height="802" as="geometry"/></mxCell>
        <mxCell id="gen" value="CLOCK_GEN" style="html=1;fillColor=#E5EFE1;strokeColor=#435965;verticalAlign=top;spacingTop=8;fontSize=20;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="35" y="173" width="223" height="118" as="geometry"/></mxCell>
        <mxCell id="gen-lock" value="LOCK_RAW" style="text;html=1;align=right;fontSize=16;fontColor=#267744;" vertex="1" connectable="0" parent="gen"><mxGeometry x="60" y="41" width="153" height="24" as="geometry"/></mxCell>
        <mxCell id="gen-clk" value="CLK_BYTE" style="text;html=1;align=right;fontSize=16;fontColor=#A54C18;" vertex="1" connectable="0" parent="gen"><mxGeometry x="60" y="79" width="153" height="24" as="geometry"/></mxCell>
        <mxCell id="reset" value="RESET COMÚN" style="html=1;fillColor=#F5E6DE;strokeColor=#435965;verticalAlign=top;spacingTop=8;fontSize=20;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="35" y="320" width="223" height="81" as="geometry"/></mxCell>
        <mxCell id="reset-port" value="RST_BYTE" style="text;html=1;align=right;fontSize=16;fontColor=#A53339;" vertex="1" connectable="0" parent="reset"><mxGeometry x="60" y="40" width="153" height="24" as="geometry"/></mxCell>
        <mxCell id="tx" value="MIPI_TX · LINK_FSM" style="html=1;fillColor=#DCECF2;strokeColor=#435965;verticalAlign=top;spacingTop=8;fontSize=20;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="35" y="433" width="223" height="286" as="geometry"/></mxCell>
        <mxCell id="tx-clk" value="CLK_BYTE" style="text;html=1;align=right;fontSize=16;fontColor=#A54C18;" vertex="1" connectable="0" parent="tx"><mxGeometry x="60" y="39" width="153" height="24" as="geometry"/></mxCell>
        <mxCell id="tx-hs" value="HS_REQ" style="text;html=1;align=right;fontSize=16;fontColor=#245E99;" vertex="1" connectable="0" parent="tx"><mxGeometry x="60" y="61" width="153" height="24" as="geometry"/></mxCell>
        <mxCell id="tx-ck" value="CLK_REQ" style="text;html=1;align=right;fontSize=16;fontColor=#723F8C;" vertex="1" connectable="0" parent="tx"><mxGeometry x="60" y="103" width="153" height="24" as="geometry"/></mxCell>
