        <mxCell id="subtitle" value="Estado en ↑CLK_BYTE; temporizadores, peticiones y controles aplicados en ↓CLK_BYTE. Los tiempos dN se detallan en tabla_flancos.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#23334a;fontStyle=0;spacing=0;" vertex="1" parent="1">
