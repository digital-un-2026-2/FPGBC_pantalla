          <mxGeometry as="geometry" x="30" y="58" width="1160" height="35" />
        </mxCell>
        <mxCell id="idle" value="&lt;b&gt;LP11 y LPDT&lt;/b&gt; · READY=1 antes de solicitar vídeo.&lt;br&gt;CLK en LP11 durante los 18 paquetes, WAIT final y END." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5FA;strokeColor=#889EB5;fontColor=#23334a;fontSize=15;spacing=8;" vertex="1" parent="1">
