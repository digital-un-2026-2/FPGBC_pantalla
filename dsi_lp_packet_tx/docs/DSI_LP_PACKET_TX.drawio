  <diagram id="dsi-lp-packet-flujo" name="Flujo de dsi_lp_packet_tx">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="2440" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=28;fontColor=#172b4d;" value="&lt;b&gt;DSI_LP_PACKET_TX · DIAGRAMA DE FLUJO&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="1640" x="80" y="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=17;fontColor=#42526e;spacingTop=4;" value="&lt;b&gt;DCS CORTOS · VC = 0&lt;/b&gt;&lt;br/&gt;Comando → paquete DSI de cuatro bytes. Una caja no equivale a un ciclo ni a un estado de FSM.&lt;br/&gt;&lt;b&gt;←&lt;/b&gt; asignación · &lt;b&gt;==&lt;/b&gt; comparación · Handshake evaluado en flanco ascendente." vertex="1">
          <mxGeometry height="75" width="1640" x="80" y="90" as="geometry" />
        </mxCell>
        <mxCell id="inicio" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#e8edf4;strokeColor=#5c708a;strokeWidth=2;" value="&lt;b&gt;INICIO&lt;/b&gt;" vertex="1">
          <mxGeometry height="45" width="180" x="670" y="185" as="geometry" />
        </mxCell>
        <mxCell id="reset" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;RESET INTERNO&lt;/b&gt;&lt;br/&gt;Descartar paquete pendiente&lt;br/&gt;busy ← 0; packet_done ← 0&lt;br/&gt;Sin transferencia de bytes" vertex="1">
          <mxGeometry height="110" width="380" x="570" y="260" as="geometry" />
        </mxCell>
        <mxCell id="rst" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" value="&lt;b&gt;¿rst == 0?&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="620" y="420" as="geometry" />
        </mxCell>
        <mxCell id="libre" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;ESPERAR COMANDO&lt;/b&gt;&lt;br/&gt;cmd_ready ← 1; tx_byte_valid ← 0&lt;br/&gt;packet_done ← 0" vertex="1">
          <mxGeometry height="95" width="400" x="560" y="575" as="geometry" />
        </mxCell>
        <mxCell id="valido" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" value="&lt;b&gt;¿cmd_valid == 1?&lt;/b&gt;" vertex="1">
          <mxGeometry height="110" width="320" x="600" y="720" as="geometry" />
        </mxCell>
        <mxCell id="aceptar" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;ACEPTAR COMANDO&lt;/b&gt;&lt;br/&gt;Conservar comando e indicador de parámetro&lt;br/&gt;Bloquear aceptación de otra orden" vertex="1">
          <mxGeometry height="105" width="420" x="550" y="880" as="geometry" />
        </mxCell>
        <mxCell id="param" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" value="&lt;b&gt;¿cmd_has_param == 1?&lt;/b&gt;" vertex="1">
          <mxGeometry height="120" width="360" x="580" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="sin" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;FORMAR CABECERA SIN PARÁMETRO&lt;/b&gt;&lt;br/&gt;Data ID ← 05&lt;br/&gt;Data 0 ← comando; Data 1 ← 00" vertex="1">
          <mxGeometry height="110" width="370" x="320" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="con" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;FORMAR CABECERA CON PARÁMETRO&lt;/b&gt;&lt;br/&gt;Data ID ← 15&lt;br/&gt;Data 0 ← comando; Data 1 ← parámetro" vertex="1">
          <mxGeometry height="110" width="370" x="830" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="ecc" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;CALCULAR ECC&lt;/b&gt;&lt;br/&gt;Proteger los tres bytes de cabecera" vertex="1">
          <mxGeometry height="85" width="400" x="560" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="paquete" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;CONSERVAR PAQUETE COMPLETO&lt;/b&gt;&lt;br/&gt;Data ID → Data 0 → Data 1 → ECC&lt;br/&gt;Seleccionar el primer byte; busy ← 1" vertex="1">
          <mxGeometry height="105" width="420" x="550" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="ofrecer" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;OFRECER BYTE ACTUAL&lt;/b&gt;&lt;br/&gt;tx_byte_valid ← 1&lt;br/&gt;Indicar si es el último byte" vertex="1">
          <mxGeometry height="100" width="400" x="560" y="1680" as="geometry" />
        </mxCell>
        <mxCell id="ready" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" value="&lt;b&gt;¿tx_byte_ready == 1?&lt;/b&gt;" vertex="1">
          <mxGeometry height="120" width="360" x="580" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="ultimo" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" value="&lt;b&gt;BYTE TRANSFERIDO&lt;/b&gt;&lt;br/&gt;¿Era el último byte?" vertex="1">
          <mxGeometry height="120" width="340" x="590" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="siguiente" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;AVANZAR&lt;/b&gt;&lt;br/&gt;Seleccionar el siguiente byte" vertex="1">
          <mxGeometry height="90" width="300" x="200" y="2010" as="geometry" />
        </mxCell>
        <mxCell id="fin" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" value="&lt;b&gt;FINALIZAR ENTREGA&lt;/b&gt;&lt;br/&gt;Liberar paquete; busy ← 0&lt;br/&gt;packet_done ← 1 durante un ciclo" vertex="1">
          <mxGeometry height="110" width="420" x="550" y="2180" as="geometry" />
        </mxCell>
        <mxCell id="nota-reset" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" value="&lt;b&gt;REGLA GLOBAL · RESET&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;rst tiene prioridad desde cualquier punto.&lt;br/&gt;En el flanco ascendente con rst = 1:&lt;br/&gt;descartar la operación sin packet_done.&lt;br/&gt;Mientras rst esté activo no se aceptan&lt;br/&gt;comandos ni se transfieren bytes.&lt;br/&gt;&lt;br/&gt;Es reset del bloque, no del panel." vertex="1">
          <mxGeometry height="270" width="440" x="1270" y="260" as="geometry" />
        </mxCell>
        <mxCell id="nota-entrada" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" value="&lt;b&gt;ENTRADA · DESCRIPTOR&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Productor: cmd_valid, cmd_opcode,&lt;br/&gt;cmd_has_param y cmd_param.&lt;br/&gt;Bloque: cmd_ready.&lt;br/&gt;&lt;br/&gt;Aceptación = cmd_valid y cmd_ready&lt;br/&gt;en el mismo flanco ascendente.&lt;br/&gt;El productor conserva los datos hasta&lt;br/&gt;esa aceptación. Sin cola de comandos." vertex="1">
          <mxGeometry height="280" width="440" x="1270" y="580" as="geometry" />
        </mxCell>
        <mxCell id="nota-operaciones" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" value="&lt;b&gt;OPERACIONES, NO ESTADOS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Aceptar, formar cabecera, calcular ECC&lt;br/&gt;y conservar paquete describen el algoritmo.&lt;br/&gt;No exigen un registro o ciclo por caja.&lt;br/&gt;Pueden resolverse en la misma captura.&lt;br/&gt;&lt;br/&gt;El paquete activo queda inmutable hasta&lt;br/&gt;entregar el último byte o recibir reset.&lt;br/&gt;No se acepta otra orden mientras está activo." vertex="1">
          <mxGeometry height="280" width="440" x="1270" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="nota-salida" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" value="&lt;b&gt;SALIDA · VALID / READY&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Transferencia = tx_byte_valid y&lt;br/&gt;tx_byte_ready en flanco ascendente.&lt;br/&gt;&lt;br/&gt;Si ready = 0: conservar byte, posición&lt;br/&gt;y marca de último; sin timeout local.&lt;br/&gt;El bucle no genera otra transferencia.&lt;br/&gt;&lt;br/&gt;Receptor: adaptación al motor LPDT.&lt;br/&gt;El motor actual usa pos/byte_almacen;&lt;br/&gt;no conectar el flujo directamente." vertex="1">
          <mxGeometry height="320" width="440" x="1270" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="nota-alcance" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" value="&lt;b&gt;PROPIEDAD DE CADA CAPA&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Este bloque entrega cuatro bytes DSI.&lt;br/&gt;El motor LPDT añade el selector 87.&lt;br/&gt;packet_done no significa fin LPDT&lt;br/&gt;ni aceptación del comando por el LCD.&lt;br/&gt;&lt;br/&gt;Software elige comandos, orden y esperas.&lt;br/&gt;Paquetes largos: ampliación posterior.&lt;br/&gt;Sin drivers, pads ni temporización DCS." vertex="1">
          <mxGeometry height="290" width="440" x="1270" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="pie" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=17;fontColor=#42526e;spacingTop=4;" value="&lt;b&gt;EJEMPLO:&lt;/b&gt; comando 01, sin parámetro → &lt;b&gt;05 01 00 10&lt;/b&gt;.&lt;br/&gt;Paquetes DCS cortos; VC = 0. Datapath y FSM en las páginas siguientes." vertex="1">
          <mxGeometry height="75" width="1640" x="80" y="2340" as="geometry" />
        </mxCell>
