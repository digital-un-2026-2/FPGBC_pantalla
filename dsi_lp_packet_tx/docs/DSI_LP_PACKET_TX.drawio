        <mxCell id="dp-ctrl-out-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=default;verticalAlign=middle;fontSize=19;align=left;" value="tx_byte_valid" vertex="1">
