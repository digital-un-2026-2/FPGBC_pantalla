        </mxCell>
        <mxCell id="dp-ctrl-out-wire-4" edge="1" parent="1" source="dp-ctrl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=18;strokeColor=default;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=default;exitX=1;exitY=0.6985294117647058;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" target="dp-ctrl-out-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dp-ctrl-out-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=default;verticalAlign=middle;fontSize=19;align=left;" value="busy, packet_done" vertex="1">
          <mxGeometry height="35" width="290" x="1310" y="1595" as="geometry" />
        </mxCell>
        <mxCell id="dp-ctrl-out-wire-5" edge="1" parent="1" source="dp-ctrl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=18;strokeColor=default;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=default;exitX=1;exitY=0.8602941176470589;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" target="dp-ctrl-out-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dp-rules" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=default;strokeColor=default;fillColor=none;rounded=0;align=left;verticalAlign=top;spacing=22;" value="&lt;b&gt;CAPTURA Y AVANCE · CONTROLES EN ↑clk&lt;/b&gt;&lt;br&gt;&lt;br&gt;CMD_FIRE = cmd_valid &amp;amp; cmd_ready&lt;br&gt;TX_FIRE = tx_byte_valid &amp;amp; tx_byte_ready&lt;br&gt;LD_PACKET = CMD_FIRE&lt;br&gt;RST_BYTE = rst | CMD_FIRE&lt;br&gt;INC_BYTE = TX_FIRE &amp;amp; !Z_LAST&lt;br&gt;&lt;br&gt;RST prioritario sobre LD / INC. El paquete solo se carga al aceptar&lt;br&gt;una orden; sus cuatro bytes permanecen estables durante la entrega.&lt;br&gt;Los dos MUX de entrada se seleccionan con cmd_has_param." vertex="1">
          <mxGeometry height="425" width="1060" x="80" y="1800" as="geometry" />
        </mxCell>
        <mxCell id="dp-handshake" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=default;strokeColor=default;fillColor=none;rounded=0;align=left;verticalAlign=top;spacing=22;" value="&lt;b&gt;CONTRATO CON EL CONTROL&lt;/b&gt;&lt;br&gt;&lt;br&gt;activo: bit de control, inicializado a 0 por rst.&lt;br&gt;CMD_FIRE: activo ← 1; TX_FIRE &amp;amp; Z_LAST: activo ← 0.&lt;br&gt;cmd_ready = !rst &amp;amp; !activo&lt;br&gt;tx_byte_valid = !rst &amp;amp; activo; busy = activo&lt;br&gt;packet_done ← TX_FIRE &amp;amp; Z_LAST en cada ↑clk;&lt;br&gt;rst fuerza activo = 0 y packet_done = 0.&lt;br&gt;&lt;br&gt;Si valid = 1 y ready = 0: conservar Q e IDX_BYTE,&lt;br&gt;y con ellos byte / last / valid. No hay cola ni aceptación mientras activo." vertex="1">
          <mxGeometry height="425" width="1050" x="1190" y="1800" as="geometry" />
        </mxCell>
        <mxCell id="dp-boundary" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=default;strokeColor=default;fillColor=none;rounded=0;align=left;verticalAlign=top;spacing=22;" value="&lt;b&gt;RECEPTOR · ADAPTACIÓN LPDT EXTERNA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Salida: data [8], valid y last.&lt;br&gt;Entrada: ready.&lt;br&gt;&lt;br&gt;El motor actual recibe cantidad_bytes y usa&lt;br&gt;pos / byte_almacen; requiere adaptación.&lt;br&gt;El selector 87 lo añade dphy_lpdt_tx.&lt;br&gt;packet_done indica entrega de cuatro bytes;&lt;br&gt;el fin LPDT se observa en terminado." vertex="1">
          <mxGeometry height="425" width="1030" x="2290" y="1800" as="geometry" />
        </mxCell>
        <mxCell id="dp-footer" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=default;verticalAlign=middle;fontSize=20;align=left;" value="&lt;b&gt;Ejemplo:&lt;/b&gt; cmd_opcode = 01, cmd_has_param = 0 → 05 01 00 10.&lt;br&gt;Captura única de {ECC, H}: no se necesitan registros separados de comando / parámetro. Sin CRC en paquetes cortos.&lt;br&gt;RTL: src/dsi_lp_packet_tx.v; consultar página FSM. El camino MUX → ECC → registro deberá comprobarse a 40 MHz." vertex="1">
          <mxGeometry height="115" width="3240" x="80" y="2310" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dsi-lp-packet-fsm" name="FSM">
    <mxGraphModel dx="2620" dy="3928" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2330" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fsm-title" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=34;" value="&lt;b&gt;DSI_LP_PACKET_TX · FSM&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="2440" x="80" y="30" as="geometry" />
        </mxCell>
        <mxCell id="fsm-key" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=22;" value="DCS cortos · VC = 0 · controles del datapath aprobado · ↑clk, 40 MHz&lt;br&gt;Las condiciones se evalúan antes del flanco; las cargas y el cambio de estado ocurren en ese flanco.&lt;br&gt;El recorrido normal presupone rst = 0. rst tiene prioridad desde cualquier estado." vertex="1">
          <mxGeometry height="115" width="2440" x="80" y="110" as="geometry" />
        </mxCell>
        <mxCell id="fsm-events" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;align=left;verticalAlign=top;spacing=25;" value="&lt;b&gt;EVENTOS Y ESTADO&lt;/b&gt;&lt;br&gt;&lt;br&gt;CMD_FIRE = cmd_valid &amp;amp; cmd_ready&lt;br&gt;TX_FIRE = tx_byte_valid &amp;amp; tx_byte_ready&lt;br&gt;Z_LAST = (IDX_BYTE == 2&#39;d3)&lt;br&gt;FIN_EVT = TX_FIRE &amp;amp; Z_LAST&lt;br&gt;&lt;br&gt;Un bit de estado: IDLE = 0; SEND = 1.&lt;br&gt;activo = (state == SEND); es el estado,&lt;br&gt;sin un registro adicional de ocupación." vertex="1">
          <mxGeometry height="365" width="830" x="1690" y="300" as="geometry" />
        </mxCell>
        <mxCell id="fsm-idle" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;ellipse;aspect=fixed;align=center;verticalAlign=middle;fontSize=22;" value="&lt;b&gt;IDLE · state = 0&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;&lt;br&gt;cmd_ready = !rst&lt;br&gt;tx_byte_valid = 0; busy = 0&lt;br&gt;&lt;br&gt;LD_PACKET = CMD_FIRE&lt;br&gt;RST_BYTE = rst | CMD_FIRE&lt;br&gt;INC_BYTE = 0&lt;br&gt;&lt;br&gt;Si CMD_FIRE en ↑clk:&lt;br&gt;PAQUETE ← {ECC, H}&lt;br&gt;IDX_BYTE ← 0" vertex="1">
          <mxGeometry height="600" width="600" x="150" y="400" as="geometry" />
        </mxCell>
        <mxCell id="fsm-send" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;ellipse;aspect=fixed;align=center;verticalAlign=middle;fontSize=22;" value="&lt;b&gt;SEND · state = 1&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;&lt;br&gt;cmd_ready = 0&lt;br&gt;tx_byte_valid = !rst; busy = 1&lt;br&gt;&lt;br&gt;LD_PACKET = 0&lt;br&gt;RST_BYTE = rst&lt;br&gt;INC_BYTE = TX_FIRE &amp;amp; !Z_LAST&lt;br&gt;&lt;br&gt;PAQUETE conserva Q.&lt;br&gt;M2 selecciona Q según IDX_BYTE.&lt;br&gt;No se incrementa el índice en 3." vertex="1">
          <mxGeometry height="600" width="600" x="990" y="400" as="geometry" />
        </mxCell>
        <mxCell id="fsm-start" edge="1" parent="1" source="fsm-idle" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelWidth=340;endArrow=classic;endFill=1;labelBackgroundColor=default;exitX=1;exitY=0.45;entryX=0;entryY=0.45;" target="fsm-send" value="CMD_FIRE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fsm-idle-loop" edge="1" parent="1" source="fsm-idle" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelWidth=340;endArrow=classic;endFill=1;labelBackgroundColor=default;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" target="fsm-idle" value="!CMD_FIRE&lt;br&gt;esperar comando">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="310" />
              <mxPoint x="600" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fsm-stall-loop" edge="1" parent="1" source="fsm-send" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelWidth=340;endArrow=classic;endFill=1;labelBackgroundColor=default;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" target="fsm-send" value="!TX_FIRE&lt;br&gt;conservar byte / índice / last">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1140" y="310" />
              <mxPoint x="1440" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fsm-advance-loop" edge="1" parent="1" source="fsm-send" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelWidth=340;endArrow=classic;endFill=1;labelBackgroundColor=default;exitX=0.75;exitY=1;entryX=0.25;entryY=1;" target="fsm-send" value="TX_FIRE &amp;amp; !Z_LAST&lt;br&gt;transferir y avanzar">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1440" y="1100" />
              <mxPoint x="1140" y="1100" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fsm-finish" edge="1" parent="1" source="fsm-send" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelWidth=340;endArrow=classic;endFill=1;labelBackgroundColor=default;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" target="fsm-idle" value="FIN_EVT&lt;br&gt;transferir ECC; no incrementar">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="890" y="850" />
              <mxPoint x="890" y="1030" />
              <mxPoint x="850" y="1030" />
              <mxPoint x="850" y="850" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fsm-done" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;align=left;verticalAlign=top;spacing=25;" value="&lt;b&gt;PULSO REGISTRADO · packet_done&lt;/b&gt;&lt;br&gt;&lt;br&gt;En cada ↑clk:&lt;br&gt;si rst: packet_done ← 0&lt;br&gt;si no: packet_done ← FIN_EVT&lt;br&gt;&lt;br&gt;La entrega del ECC lleva SEND → IDLE&lt;br&gt;y activa packet_done durante un ciclo.&lt;br&gt;Al siguiente ↑clk vuelve a 0, incluso si&lt;br&gt;se acepta un nuevo comando.&lt;br&gt;&lt;br&gt;packet_done puede coincidir con cmd_ready.&lt;br&gt;No se añade un estado DONE." vertex="1">
          <mxGeometry height="455" width="830" x="1690" y="715" as="geometry" />
        </mxCell>
        <mxCell id="fsm-reset" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;align=left;verticalAlign=top;spacing=25;" value="&lt;b&gt;RESET INTERNO · PRIORIDAD GLOBAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mientras rst = 1:&lt;br&gt;cmd_ready = 0; tx_byte_valid = 0&lt;br&gt;LD_PACKET = 0; INC_BYTE = 0; RST_BYTE = 1&lt;br&gt;CMD_FIRE = 0; TX_FIRE = 0; FIN_EVT = 0&lt;br&gt;&lt;br&gt;En ↑clk con rst = 1, desde cualquier estado:&lt;br&gt;state ← IDLE; packet_done ← 0&lt;br&gt;PAQUETE ← 0; IDX_BYTE ← 0&lt;br&gt;&lt;br&gt;Reset síncrono del almacenamiento; prioritario sobre LD / INC.&lt;br&gt;busy = activo: pasa a 0 al registrar IDLE.&lt;br&gt;Aborta sin packet_done; no es el reset del panel." vertex="1">
          <mxGeometry height="495" width="1190" x="80" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="fsm-retention" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;align=left;verticalAlign=top;spacing=25;" value="&lt;b&gt;RETENCIÓN Y LÍMITES DEL BLOQUE&lt;/b&gt;&lt;br&gt;&lt;br&gt;tx_byte_data = M2(PAQUETE, IDX_BYTE)&lt;br&gt;tx_byte_last = Z_LAST; significativo con tx_byte_valid = 1.&lt;br&gt;&lt;br&gt;SEND y ready = 0: byte, last, valid e índice estables,&lt;br&gt;salvo reset. No hay timeout local.&lt;br&gt;IDX_BYTE: 0 → 1 → 2 → 3; solo avanza con TX_FIRE.&lt;br&gt;En el último byte, last puede esperar varios ciclos.&lt;br&gt;Z_LAST por sí solo no genera packet_done.&lt;br&gt;&lt;br&gt;Sin cola: cmd_ready = 0 durante SEND.&lt;br&gt;No acepta otra orden en el flanco que entrega el ECC.&lt;br&gt;packet_done es fin de entrega al adaptador, no fin LPDT." vertex="1">
          <mxGeometry height="495" width="1200" x="1320" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="fsm-trace" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;align=left;verticalAlign=top;spacing=25;" value="&lt;b&gt;EJEMPLO SIN PAUSAS · COMANDO 01 SIN PARÁMETRO → 05 01 00 10&lt;/b&gt;&lt;br&gt;&lt;br&gt;E0: CMD_FIRE; capturar paquete, IDX_BYTE ← 0; entrar en SEND. Se ofrece 05 después del flanco.&lt;br&gt;E1: TX_FIRE, índice previo = 0; transferir 05; IDX_BYTE ← 1. Se ofrece 01.&lt;br&gt;E2: TX_FIRE, índice previo = 1; transferir 01; IDX_BYTE ← 2. Se ofrece 00.&lt;br&gt;E3: TX_FIRE, índice previo = 2; transferir 00; IDX_BYTE ← 3. Se ofrece 10 y last = 1.&lt;br&gt;E4: TX_FIRE, índice previo = 3; transferir 10; entrar en IDLE y packet_done ← 1. Índice conserva 3.&lt;br&gt;E5: packet_done ← 0; puede aceptarse la siguiente orden y recargarse el índice a 0.&lt;br&gt;&lt;br&gt;Cada flanco con ready = 0 durante SEND retrasa la secuencia sin avanzar el índice.&lt;br&gt;Durante el ciclo E4–E5: cmd_ready = 1, tx_byte_valid = 0 y packet_done = 1." vertex="1">
          <mxGeometry height="370" width="2440" x="80" y="1800" as="geometry" />
        </mxCell>
        <mxCell id="fsm-footer" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=default;strokeColor=default;fillColor=none;strokeWidth=1.5;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=21;" value="Control de habilitaciones dependiente del estado y del handshake; packet_done es una salida registrada.&lt;br&gt;La cabecera y el ECC se forman antes de E0 y se capturan juntos; no requieren estados adicionales.&lt;br&gt;RTL: src/dsi_lp_packet_tx.v y src/packet_control.v. Simulación: pixi run test-dsi-packet." vertex="1">
          <mxGeometry height="90" width="2440" x="80" y="2220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
