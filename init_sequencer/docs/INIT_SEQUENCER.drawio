<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="init-flujo" name="Flujo">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1280" pageHeight="1420" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="INIT_SEQUENCER — flujo de inicialización" style="text;html=1;align=left;spacing=0;fontSize=32;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="38" y="22" width="1200" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="CTRL decide en ↑ de CLK_BYTE; A_COUNT y D_COUNT actualizan en ↓" style="text;html=1;align=left;spacing=0;fontSize=17;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="39" y="69" width="1200" height="28" as="geometry"/></mxCell>
        <mxCell id="reset" value="&lt;b&gt;RST_BYTE=1&lt;/b&gt; · INIT_REQ=0; INIT_DONE=0&lt;br&gt;↑ CTRL a READ; ↓ A_COUNT y D_COUNT a 0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="384" y="118" width="460" height="58" as="geometry"/></mxCell>
        <mxCell id="read" value="&lt;b&gt;Leer la ROM&lt;/b&gt;&lt;br&gt;OP[1:0] y LAST de la nueva entrada, estables en ↑" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="384" y="212" width="460" height="60" as="geometry"/></mxCell>
        <mxCell id="byte" value="&lt;b&gt;¿BYTE?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="454" y="295" width="320" height="66" as="geometry"/></mxCell>
        <mxCell id="offer" value="&lt;b&gt;INIT_REQ=1; INIT_LAST=0&lt;/b&gt;&lt;br&gt;Retener ADDR[7:0] y el primer INIT_BYTE[7:0]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="384" y="387" width="460" height="63" as="geometry"/></mxCell>
        <mxCell id="admit" value="&lt;b&gt;¿INIT_REQ ∧ INIT_READY?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="424" y="476" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="tx" value="&lt;b&gt;INIT_REQ=0; conservar ADDR[7:0]&lt;/b&gt;&lt;br&gt;LP_TX sigue consumiendo el paquete sin otra petición" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="384" y="578" width="460" height="64" as="geometry"/></mxCell>
        <mxCell id="wait" value="&lt;b&gt;¿WAIT?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="464" y="667" width="300" height="72" as="geometry"/></mxCell>
        <mxCell id="next" value="&lt;b&gt;¿BYTE ∧ INIT_NEXT?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=15;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="74" y="665" width="276" height="76" as="geometry"/></mxCell>
        <mxCell id="advance-byte" value="&lt;b&gt;↑: capturar ADV_BYTE&lt;/b&gt;&lt;br&gt;↓: INC_A hace avanzar ADDR[7:0]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="62" y="774" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="close" value="&lt;b&gt;INIT_LAST=1; conservar ADDR[7:0]&lt;/b&gt;&lt;br&gt;LP_TX cierra sin consumir el ARG de WAIT" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="384" y="765" width="460" height="62" as="geometry"/></mxCell>
        <mxCell id="ack" value="&lt;b&gt;¿INIT_DONE_TX=1?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="434" y="851" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="start-delay" value="&lt;b&gt;↑: presentar START_DELAY=1 durante un ciclo&lt;/b&gt;&lt;br&gt;↓: D_COUNT carga DELAY_MS[7:0] e inicia su fase" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="384" y="948" width="460" height="68" as="geometry"/></mxCell>
        <mxCell id="elapsed" value="&lt;b&gt;¿DONE_DELAY=1?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="464" y="1040" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="count" value="&lt;b&gt;COUNT_DELAY=1&lt;/b&gt;&lt;br&gt;Tick de 1 ms; no recargar la pausa" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="940" y="1041" width="302" height="68" as="geometry"/></mxCell>
        <mxCell id="advance-wait" value="&lt;b&gt;↑: presentar INC_A=1 para un ↓&lt;/b&gt;&lt;br&gt;↓: avanzar a la palabra siguiente; INIT_REQ=0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="384" y="1134" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;¿END?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="454" y="1212" width="320" height="68" as="geometry"/></mxCell>
        <mxCell id="done" value="&lt;b&gt;INIT_DONE=1; INIT_REQ=0&lt;/b&gt;&lt;br&gt;Vídeo habilitado; END retenido hasta reset" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="384" y="1303" width="460" height="64" as="geometry"/></mxCell>
        <mxCell id="note-reset" value="&lt;b&gt;Reset lógico en cualquier fase&lt;/b&gt;&lt;br&gt;&lt;br&gt;Abortar sin fin falso ni reanudar el paquete. RST_BYTE cubre ↑ y el ↓ siguiente; al liberar se vuelve a dir. 0." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="56" y="135" width="274" height="144" as="geometry"/></mxCell>
        <mxCell id="note-op" value="&lt;b&gt;Operaciones de INIT_MEM&lt;/b&gt;&lt;br&gt;&lt;br&gt;BYTE: OP=00, LAST=0&lt;br&gt;WAIT: OP=01, LAST=1&lt;br&gt;END: OP=10, LAST=0&lt;br&gt;&lt;br&gt;Si la lectura inicial no es BYTE, no se solicita un paquete." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="940" y="135" width="302" height="181" as="geometry"/></mxCell>
        <mxCell id="note-tx" value="&lt;b&gt;Admisión ≠ consumo&lt;/b&gt;&lt;br&gt;&lt;br&gt;INIT_READY solo admite el paquete en ↑. LP_TX puede cargar el primer BYTE mucho después; cada INIT_NEXT confirma una carga ya hecha en ↓.&lt;br&gt;&lt;br&gt;El último BYTE aún tiene LAST=0. La entrada siguiente es el WAIT." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="940" y="443" width="302" height="214" as="geometry"/></mxCell>
        <mxCell id="note-end" value="&lt;b&gt;Fin de paquete ≠ fin de init&lt;/b&gt;&lt;br&gt;&lt;br&gt;INIT_DONE_TX arranca la pausa. Solo después del WAIT de 7 ms y de leer END se activa INIT_DONE.&lt;br&gt;&lt;br&gt;Tablas de flancos en init_sequencer/README.md." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="940" y="1174" width="302" height="181" as="geometry"/></mxCell>
        <mxCell id="e-reset" value="Liberar reset" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="reset" target="read" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-read" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;" edge="1" source="read" target="byte" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-byte-yes" value="Sí" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="byte" target="offer" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-byte-no" value="No" style="edgeStyle=segmentEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="byte" target="read" parent="1"><mxGeometry x="-0.65" relative="1" as="geometry"><Array as="points"><mxPoint x="891" y="328"/><mxPoint x="891" y="242"/></Array></mxGeometry></mxCell>
        <mxCell id="e-ask" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;" edge="1" source="offer" target="admit" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-admit-yes" value="Sí · ↑" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="admit" target="tx" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-admit-no" value="No" style="edgeStyle=segmentEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="admit" target="offer" parent="1"><mxGeometry x="-0.7" relative="1" as="geometry"><Array as="points"><mxPoint x="891" y="514"/><mxPoint x="891" y="418.5"/></Array></mxGeometry></mxCell>
        <mxCell id="e-tx" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;" edge="1" source="tx" target="wait" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-wait-no" value="No" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="wait" target="next" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-next-no" value="No" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.875;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="next" target="tx" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="212" y="634"/></Array></mxGeometry></mxCell>
        <mxCell id="e-next-yes" value="Sí" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="next" target="advance-byte" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-byte-return" style="edgeStyle=segmentEdgeStyle;exitX=0;exitY=0.5;entryX=0;entryY=0.3125;strokeColor=#267744;endArrow=block;" edge="1" source="advance-byte" target="tx" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="44" y="806"/><mxPoint x="44" y="598"/></Array></mxGeometry></mxCell>
        <mxCell id="e-wait-yes" value="Sí" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="wait" target="close" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-close" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;" edge="1" source="close" target="ack" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ack-no" value="No" style="edgeStyle=segmentEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="ack" target="close" parent="1"><mxGeometry x="-0.7" relative="1" as="geometry"><Array as="points"><mxPoint x="891" y="886"/><mxPoint x="891" y="796"/></Array></mxGeometry></mxCell>
        <mxCell id="e-ack-yes" value="Sí · ↑" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="ack" target="start-delay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-delay" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;" edge="1" source="start-delay" target="elapsed" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-delay-no" value="No" style="edgeStyle=segmentEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="elapsed" target="count" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-count" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=0;entryX=0.75;entryY=0.25;entryPerimeter=0;strokeColor=#526778;endArrow=block;" edge="1" source="count" target="elapsed" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1091" y="1027"/><mxPoint x="689" y="1027"/></Array></mxGeometry></mxCell>
        <mxCell id="e-delay-yes" value="Sí · ↑" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="elapsed" target="advance-wait" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-next-op" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;" edge="1" source="advance-wait" target="end" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-end-yes" value="Sí" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="end" target="done" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-end-no" value="No · evaluar el nuevo OP" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#674594;strokeWidth=1.5;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="end" target="byte" parent="1"><mxGeometry x="-0.67" relative="1" as="geometry"><Array as="points"><mxPoint x="24" y="1246"/><mxPoint x="24" y="328"/></Array></mxGeometry></mxCell>
