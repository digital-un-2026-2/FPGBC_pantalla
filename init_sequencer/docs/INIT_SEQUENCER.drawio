  </diagram>
  <diagram id="init-datapath" name="Datapath">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1660" pageHeight="1080" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="INIT_SEQUENCER — datapath y conexiones" style="text;html=1;align=left;spacing=0;fontSize=32;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="32" y="21" width="1596" height="43" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Fuera de MIPI_TX · Vecinos mostrados solo como referencia · Un color por señal, trazo fino: 1 bit, grueso: bus" style="text;html=1;align=left;spacing=0;fontSize=17;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="33" y="70" width="1595" height="29" as="geometry"/></mxCell>
        <mxCell id="scope" value="INIT_SEQUENCER" style="rounded=0;html=1;fillColor=#F7FAFB;strokeColor=#8798A4;strokeWidth=1.5;dashed=1;dashPattern=2 5;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;fontSize=23;fontStyle=1;fontColor=#20313F;" vertex="1" connectable="0" parent="1"><mxGeometry x="246" y="121" width="1170" height="714" as="geometry"/></mxCell>
        <mxCell id="clk-name" value="CLK_BYTE" style="text;html=1;align=right;verticalAlign=middle;spacing=0;fontColor=#485663;fontSize=16;" vertex="1" connectable="0" parent="1"><mxGeometry x="39" y="163" width="153" height="22" as="geometry"/></mxCell>
        <mxCell id="rst-name" value="RST_BYTE" style="text;html=1;align=right;verticalAlign=middle;spacing=0;fontColor=#A23046;fontSize=16;" vertex="1" connectable="0" parent="1"><mxGeometry x="39" y="199" width="153" height="22" as="geometry"/></mxCell>
        <mxCell id="clk-port" style="ellipse;fillColor=#FFFFFF;strokeColor=#485663;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="198" y="169" width="10" height="10" as="geometry"/></mxCell>
        <mxCell id="rst-port" style="ellipse;fillColor=#FFFFFF;strokeColor=#A23046;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="198" y="205" width="10" height="10" as="geometry"/></mxCell>
        <mxCell id="link" value="LINK_FSM" style="rounded=0;html=1;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=11;spacingTop=7;fontSize=18;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="31" y="276" width="185" height="124" as="geometry"/></mxCell>
        <mxCell id="link-req" value="INIT_REQ" style="text;html=1;align=right;verticalAlign=middle;spacing=0;fontColor=#087888;fontSize=16;" vertex="1" connectable="0" parent="link"><mxGeometry x="8" y="32" width="165" height="22" as="geometry"/></mxCell>
        <mxCell id="link-ready" value="INIT_READY" style="text;html=1;align=right;verticalAlign=middle;spacing=0;fontColor=#7852A0;fontSize=16;" vertex="1" connectable="0" parent="link"><mxGeometry x="8" y="63" width="165" height="22" as="geometry"/></mxCell>
        <mxCell id="link-ack" value="INIT_DONE_TX" style="text;html=1;align=right;verticalAlign=middle;spacing=0;fontColor=#2054A3;fontSize=16;" vertex="1" connectable="0" parent="link"><mxGeometry x="8" y="93" width="165" height="22" as="geometry"/></mxCell>
        <mxCell id="lp-in" value="LP_TX" style="rounded=0;html=1;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=11;fontSize=17;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="31" y="419" width="185" height="38" as="geometry"/></mxCell>
        <mxCell id="lp-next" value="INIT_NEXT" style="text;html=1;align=right;verticalAlign=middle;spacing=0;fontColor=#885139;fontSize=16;" vertex="1" connectable="0" parent="lp-in"><mxGeometry x="85" y="8" width="88" height="22" as="geometry"/></mxCell>
        <mxCell id="video" value="VIDEO_TIMING" style="rounded=0;html=1;fillColor=#F3F2DB;strokeColor=#3B505C;strokeWidth=1.5;align=left;verticalAlign=bottom;spacingLeft=11;spacingBottom=7;fontSize=17;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="31" y="461" width="185" height="64" as="geometry"/></mxCell>
        <mxCell id="video-en" value="ENABLE" style="text;html=1;align=right;verticalAlign=middle;spacing=0;fontColor=#147455;fontSize=16;" vertex="1" connectable="0" parent="video"><mxGeometry x="8" y="2" width="165" height="22" as="geometry"/></mxCell>
        <mxCell id="ctrl" style="rounded=0;html=1;fillColor=#EAF4F8;strokeColor=#3B505C;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="325" y="254" width="350" height="250" as="geometry"/></mxCell>
        <mxCell id="ctrl-title" value="CTRL" style="text;html=1;align=center;spacing=0;fontSize=22;fontStyle=1;fontColor=#20313F;" vertex="1" connectable="0" parent="ctrl"><mxGeometry x="104" y="28" width="142" height="28" as="geometry"/></mxCell>
        <mxCell id="ctrl-caption" value="↑ CLK_BYTE&lt;br&gt;&lt;b&gt;STATE[2:0]&lt;/b&gt;&lt;br&gt;&lt;b&gt;ADV_BYTE&lt;/b&gt; (1 bit)&lt;br&gt;Reset: READ, 0&lt;br&gt;&lt;br&gt;Controles&lt;br&gt;combinacionales" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#344654;" vertex="1" connectable="0" parent="ctrl"><mxGeometry x="135" y="67" width="125" height="133" as="geometry"/></mxCell>
