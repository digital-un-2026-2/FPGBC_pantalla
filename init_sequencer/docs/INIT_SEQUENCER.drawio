        <mxCell id="e-last-lp" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.437956;strokeColor=#803966;strokeWidth=1.8;endArrow=block;" edge="1" source="tap-last" target="lp-out" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-last-ctrl" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.536;strokeColor=#803966;strokeWidth=1.8;jumpStyle=gap;jumpSize=11;endArrow=block;" edge="1" source="tap-last" target="ctrl" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1396" y="548"/><mxPoint x="929" y="548"/><mxPoint x="929" y="388"/></Array></mxGeometry></mxCell>
        <mxCell id="e-byte" style="edgeStyle=segmentEdgeStyle;exitX=1;exitY=0.596591;entryX=0;entryY=0.751825;strokeColor=#28724B;strokeWidth=3.5;endArrow=block;endSize=7;" edge="1" source="mem" target="lp-out" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-arg" style="edgeStyle=segmentEdgeStyle;exitX=0;exitY=0.698864;entryX=1;entryY=0.698864;strokeColor=#94630D;strokeWidth=3.5;endArrow=block;endSize=7;" edge="1" source="mem" target="d-count" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-start" style="edgeStyle=segmentEdgeStyle;exitX=0.174286;exitY=1;entryX=0.174286;entryY=0;strokeColor=#754B99;strokeWidth=1.8;endArrow=block;" edge="1" source="ctrl" target="d-count" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-count" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#24738C;strokeWidth=1.8;endArrow=block;" edge="1" source="ctrl" target="d-count" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ddone" style="edgeStyle=segmentEdgeStyle;exitX=0.825714;exitY=0;entryX=0.825714;entryY=1;strokeColor=#4E538C;strokeWidth=1.8;endArrow=block;" edge="1" source="d-count" target="ctrl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="clk-d" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.301136;strokeColor=#485663;strokeWidth=1.8;jumpStyle=gap;jumpSize=10;endArrow=block;" edge="1" source="tap-clk-d" target="d-count" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="679"/></Array></mxGeometry></mxCell>
        <mxCell id="rst-d" style="edgeStyle=segmentEdgeStyle;exitX=0.5;exitY=0.5;exitPerimeter=0;entryX=1;entryY=0.488636;strokeColor=#A23046;strokeWidth=1.8;jumpStyle=gap;jumpSize=10;endArrow=block;" edge="1" source="tap-rst-d" target="d-count" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="712"/></Array></mxGeometry></mxCell>
        <mxCell id="rom-note" value="&lt;b&gt;Imagen exacta · {OP[1:0], LAST, ARG[7:0]}&lt;/b&gt;&lt;br&gt;&lt;br&gt;INIT_BYTE = DELAY_MS = ARG; INIT_LAST = LAST.&lt;br&gt;WAIT (OP=01) no se transmite; END (OP=10) no se solicita.&lt;br&gt;&lt;br&gt;Tabla combinacional generada con las 223 palabras de init_mem.hex. No se recalculan bytes ni se inserta 87; LP_TX añade el selector." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="32" y="858" width="513" height="185" as="geometry"/></mxCell>
        <mxCell id="timer-note" value="&lt;b&gt;D_COUNT · TICK_MS, sin reloj derivado&lt;/b&gt;&lt;br&gt;&lt;br&gt;P = CLK_BYTE_HZ / 1000 ciclos; W = max(1, ⌈log₂ P⌉).&lt;br&gt;START_DELAY carga MS_LEFT e inicia PHASE en el primer ↓. Con P=1 ese ↓ también aplica el primer tick.&lt;br&gt;&lt;br&gt;Con COUNT_DELAY y MS_LEFT &gt; 0, avanzar PHASE. Al llegar a P−1, el tick vuelve PHASE a 0 y resta 1 a MS_LEFT en ↓." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="564" y="858" width="517" height="185" as="geometry"/></mxCell>
        <mxCell id="timing-note" value="&lt;b&gt;Reset y caminos de medio ciclo&lt;/b&gt;&lt;br&gt;&lt;br&gt;RST_ALL = RST_BYTE; activo en 1, síncrono en cada flanco propio. Cubrir ↑ y el ↓ siguiente. INIT_MEM no se registra ni se resetea.&lt;br&gt;&lt;br&gt;↓ LP_TX → ↑ CTRL → ↓ A_COUNT → ROM. LAST debe llegar estable antes del ↑ de frontera de byte de LP_TX." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1100" y="858" width="528" height="185" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="init-fsm" name="FSM">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1400" pageHeight="855" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="INIT_SEQUENCER — FSM de CTRL" style="text;html=1;align=left;spacing=0;fontSize=32;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="38" y="22" width="1320" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="STATE[2:0] y ADV_BYTE se actualizan en ↑ de CLK_BYTE · Controles decodificados en combinacional" style="text;html=1;align=left;spacing=0;fontSize=17;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="39" y="69" width="1320" height="27" as="geometry"/></mxCell>
        <mxCell id="reset" value="&lt;b&gt;Prioridad en cualquier ↑: RST_BYTE=1 → READ y ADV_BYTE=0&lt;/b&gt; · RST_ALL pone a cero A_COUNT y D_COUNT en ↓" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#9CAEBB;align=left;spacingLeft=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="62" y="113" width="1283" height="42" as="geometry"/></mxCell>
        <mxCell id="entry" style="ellipse;aspect=fixed;fillColor=#3B505C;strokeColor=#3B505C;" vertex="1" parent="1"><mxGeometry x="32" y="281" width="10" height="10" as="geometry"/></mxCell>
        <mxCell id="read" value="&lt;b style=&quot;font-size:20px&quot;&gt;READ&lt;/b&gt;&lt;br&gt;Primer OP[1:0] y LAST&lt;br&gt;INIT_REQ=0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="62" y="235" width="215" height="102" as="geometry"/></mxCell>
        <mxCell id="request" value="&lt;b style=&quot;font-size:20px&quot;&gt;REQUEST&lt;/b&gt;&lt;br&gt;INIT_REQ=1&lt;br&gt;Primer BYTE retenido" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="388" y="235" width="215" height="102" as="geometry"/></mxCell>
        <mxCell id="tx" value="&lt;b style=&quot;font-size:20px&quot;&gt;TX&lt;/b&gt;&lt;br&gt;INIT_REQ=0&lt;br&gt;INC_A = ADV_BYTE&lt;br&gt;WAIT → INIT_LAST=1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="735" y="235" width="215" height="102" as="geometry"/></mxCell>
        <mxCell id="load" value="&lt;b style=&quot;font-size:20px&quot;&gt;LOAD_DELAY&lt;/b&gt;&lt;br&gt;START_DELAY=1 para un ↓&lt;br&gt;Cargar DELAY_MS[7:0]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1100" y="235" width="245" height="102" as="geometry"/></mxCell>
        <mxCell id="delay" value="&lt;b style=&quot;font-size:20px&quot;&gt;DELAY&lt;/b&gt;&lt;br&gt;COUNT_DELAY=1&lt;br&gt;Retener la dirección de WAIT" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1100" y="524" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="advance" value="&lt;b style=&quot;font-size:20px&quot;&gt;ADV_WAIT&lt;/b&gt;&lt;br&gt;INC_A=1 para un ↓&lt;br&gt;Leer nueva palabra en ↑" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="735" y="524" width="215" height="100" as="geometry"/></mxCell>
        <mxCell id="done" value="&lt;b style=&quot;font-size:20px&quot;&gt;DONE&lt;/b&gt;&lt;br&gt;INIT_DONE=1; INIT_REQ=0&lt;br&gt;No se mueve ADDR[7:0]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="388" y="524" width="215" height="100" as="geometry"/></mxCell>
        <mxCell id="e-entry" style="edgeStyle=segmentEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3B505C;endArrow=block;" edge="1" source="entry" target="read" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-byte" value="BYTE" style="edgeStyle=segmentEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=15;" edge="1" source="read" target="request" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-admit" value="INIT_REQ ∧&lt;br&gt;INIT_READY" style="edgeStyle=segmentEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="request" target="tx" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ack" value="WAIT ∧&lt;br&gt;INIT_DONE_TX" style="edgeStyle=segmentEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="tx" target="load" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-read-loop" value="No BYTE" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.8;exitY=0;entryX=0.2;entryY=0;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="read" target="read" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="234" y="194"/><mxPoint x="105" y="194"/></Array></mxGeometry></mxCell>
        <mxCell id="e-req-loop" value="Sin admisión" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.8;exitY=0;entryX=0.2;entryY=0;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="request" target="request" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="194"/><mxPoint x="431" y="194"/></Array></mxGeometry></mxCell>
        <mxCell id="e-tx-loop" value="En otro caso" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.8;exitY=0;entryX=0.2;entryY=0;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="tx" target="tx" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="907" y="194"/><mxPoint x="778" y="194"/></Array></mxGeometry></mxCell>
        <mxCell id="e-load-delay" value="!DONE_DELAY" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="load" target="delay" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-load-final" value="DONE_DELAY tras la carga" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0;exitY=0.813725;entryX=0.5;entryY=0;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="load" target="advance" parent="1"><mxGeometry x="0.06" relative="1" as="geometry"><Array as="points"><mxPoint x="1029" y="318"/><mxPoint x="1029" y="410"/><mxPoint x="842.5" y="410"/></Array></mxGeometry></mxCell>
        <mxCell id="e-delay-loop" value="!DONE_DELAY" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.8;exitY=1;entryX=0.2;entryY=1;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="delay" target="delay" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1296" y="667"/><mxPoint x="1149" y="667"/></Array></mxGeometry></mxCell>
        <mxCell id="e-delay-final" value="DONE_DELAY" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="delay" target="advance" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-req-again" value="BYTE" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0;exitY=0.2;entryX=0.5;entryY=1;strokeColor=#674594;strokeWidth=1.5;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=15;" edge="1" source="advance" target="request" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="664" y="544"/><mxPoint x="664" y="457"/><mxPoint x="495.5" y="457"/></Array></mxGeometry></mxCell>
        <mxCell id="e-end" value="END" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#3B505C;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=15;" edge="1" source="advance" target="done" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-done-loop" value="Hasta reset" style="edgeStyle=segmentEdgeStyle;html=1;exitX=0.8;exitY=1;entryX=0.2;entryY=1;strokeColor=#526778;endArrow=block;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="done" target="done" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="667"/><mxPoint x="431" y="667"/></Array></mxGeometry></mxCell>
        <mxCell id="ops" value="&lt;b&gt;Decodificación de ROM&lt;/b&gt;&lt;br&gt;BYTE: OP=00 y LAST=0 · WAIT: OP=01 y LAST=1 · END: OP=10 y LAST=0.&lt;br&gt;OP inesperado en ADV_WAIT → READ, sin petición ni fin." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=middle;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="62" y="709" width="511" height="102" as="geometry"/></mxCell>
        <mxCell id="outputs" value="&lt;b&gt;Captura y controles&lt;/b&gt;&lt;br&gt;En cada ↑: ADV_BYTE = (STATE=TX ∧ BYTE ∧ INIT_NEXT). El dato llega a un único ↓ sin depender del nivel vivo de INIT_NEXT.&lt;br&gt;Controles a 0 por defecto y en reset. Estado no válido → READ." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=middle;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="593" y="709" width="752" height="102" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
