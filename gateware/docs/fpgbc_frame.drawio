<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="frame-flow" name="Flujo">
    <mxGraphModel page="1" pageWidth="1300" pageHeight="1260" grid="1" gridSize="10" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Cuadro FPGBC — flujo aprobado" style="text;html=1;align=left;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="45" as="geometry"/></mxCell>
        <mxCell id="reset" value="Reset común / pérdida de reloj&lt;br&gt;Pads aislados; EN/PWM=0&lt;br&gt;ROM, fuente, cuadro y prefijo → 0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FBE5E5;strokeColor=#A7303D;fontSize=19;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="init" value="Inicialización LP intacta&lt;br&gt;18 paquetes / 204 bytes&lt;br&gt;WAIT final 7 ms → END" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;fontSize=19;" vertex="1" parent="1"><mxGeometry x="420" y="240" width="420" height="95" as="geometry"/></mxCell>
        <mxCell id="admit" value="LINE_WAIT y sin INIT_REQ&lt;br&gt;READY y LOCK y&lt;br&gt;VID_REQ y VID_LINE_RDY" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF8E6;strokeColor=#B7A46A;fontSize=18;" vertex="1" parent="1"><mxGeometry x="410" y="390" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="capture" value="↑: admitir; CLK_PRE, ENTER_T=1&lt;br&gt;↓ d0: capturar tipo; avanzar índice módulo 743&lt;br&gt;CLK_REQ=1; sin lectura RGB" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;fontSize=19;" vertex="1" parent="1"><mxGeometry x="365" y="600" width="530" height="100" as="geometry"/></mxCell>
        <mxCell id="active" value="¿Tipo activo?" style="rhombus;html=1;fillColor=#FFF8E6;strokeColor=#B7A46A;fontSize=19;" vertex="1" parent="1"><mxGeometry x="500" y="750" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="sync" value="SoT por carril → VSS o HSS&lt;br&gt;2 palabras DSI&lt;br&gt;VID_RD=0" style="rounded=0;html=1;fillColor=#D8EAF0;strokeColor=#3B505C;fontSize=19;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="400" height="100" as="geometry"/></mxCell>
        <mxCell id="rgb" value="SoT → HSS → Blanking → RGB&lt;br&gt;1091 palabras DSI; 1080 lecturas RGB&lt;br&gt;CRC sobre píxeles exclusivamente" style="rounded=0;html=1;fillColor=#D8EAF0;strokeColor=#3B505C;fontSize=19;" vertex="1" parent="1"><mxGeometry x="800" y="890" width="440" height="100" as="geometry"/></mxCell>
        <mxCell id="close" value="Drenar última palabra; trail y retención CLK intactos&lt;br&gt;READY: d1167 activo / d78 sincronismo&lt;br&gt;Esperar hasta C_LINE=1168; volver a LINE_WAIT" style="rounded=0;html=1;fillColor=#E5F0E2;strokeColor=#3B505C;fontSize=19;" vertex="1" parent="1"><mxGeometry x="365" y="1060" width="530" height="110" as="geometry"/></mxCell>
        <mxCell id="r-i" edge="1" parent="1" source="reset" target="init" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-a" edge="1" parent="1" source="init" target="admit" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-w" value="No: conservar oferta" edge="1" parent="1" source="admit" target="admit" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=.5;entryX=.2;entryY=0;endArrow=block;fontSize=17;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="465"/><mxPoint x="230" y="365"/><mxPoint x="498" y="365"/></Array></mxGeometry></mxCell>
        <mxCell id="a-c" value="Sí" edge="1" parent="1" source="admit" target="capture" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=17;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-t" edge="1" parent="1" source="capture" target="active" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-s" value="No" edge="1" parent="1" source="active" target="sync" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=.5;entryX=.5;entryY=0;endArrow=block;fontSize=17;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-r" value="Sí" edge="1" parent="1" source="active" target="rgb" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=.5;entryX=.5;entryY=0;endArrow=block;fontSize=17;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e" edge="1" parent="1" source="sync" target="close" style="edgeStyle=orthogonalEdgeStyle;exitX=.5;exitY=1;entryX=.2;entryY=0;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e" edge="1" parent="1" source="rgb" target="close" style="edgeStyle=orthogonalEdgeStyle;exitX=.5;exitY=1;entryX=.8;entryY=0;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a" edge="1" parent="1" source="close" target="admit" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=.7;entryX=1;entryY=.5;endArrow=block;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="1137"/><mxPoint x="1270" y="465"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="Ante fallo: el corte asíncrono prevalece; reset común y nueva inicialización desde ROM 0. No se reanuda un cuadro parcial." style="text;html=1;fontSize=17;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="1200" width="1200" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="frame-datapath" name="Datapath">
    <mxGraphModel page="1" pageWidth="2040" pageHeight="1200" grid="1" gridSize="10" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="MIPI_TX — ampliación interna de cuadro, interfaces externas intactas" style="text;html=1;align=left;fontSize=29;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1980" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="CLK_BYTE=55 MHz · RST_BYTE activo alto, cubrir ↑ y ↓ · datapath ↓ / FSM ↑ / controles combinacionales · FRAME_MODE=1" style="text;html=1;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1980" height="35" as="geometry"/></mxCell>
        <mxCell id="tx" value="MIPI_TX" style="container=1;collapsible=0;recursiveResize=0;html=1;fillColor=#F7F9FA;strokeColor=#8798A4;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="1350" height="850" as="geometry"/></mxCell>
        <mxCell id="link" value="&lt;b&gt;LINK_FSM + TIMER&lt;/b&gt;&lt;br&gt;FSM ↑; timer 11 bits ↓&lt;br&gt;BURST_START en primer CLK_PRE&lt;br&gt;FRAME_TIMING: índice 10 bits, tipo 2 bits ↓&lt;br&gt;EN=BURST_START; reset índice 0, tipo VSS" style="rounded=0;html=1;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=2;fontSize=18;verticalAlign=top;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="430" height="260" as="geometry"/></mxCell>
        <mxCell id="source" value="&lt;b&gt;VIDEO_SOURCE&lt;/b&gt;&lt;br&gt;Barras / blanco&lt;br&gt;Dirección 11 bits ↓&lt;br&gt;EN=VID_RD; reset 0&lt;br&gt;No arma paquetes" style="rounded=0;html=1;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=2;fontSize=18;verticalAlign=bottom;spacingBottom=12;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="230" height="270" as="geometry"/></mxCell>
        <mxCell id="packer" value="&lt;b&gt;HS_PACKER&lt;/b&gt;&lt;br&gt;Prefijo: contador 4 bits ↓, reset 0&lt;br&gt;Avanza desde PK_START hasta 9; retiene&lt;br&gt;Fin de ráfaga → reinicia prefijo&lt;br&gt;MUX: VSS/HSS o HSS + Blanking&lt;br&gt;Luego datapath RGB original intacto&lt;br&gt;RGB_START después de ocho palabras" style="rounded=0;html=1;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=2;fontSize=18;verticalAlign=bottom;spacingBottom=65;" vertex="1" parent="1"><mxGeometry x="900" y="520" width="400" height="330" as="geometry"/></mxCell>
        <mxCell id="lp" value="&lt;b&gt;LP_TX&lt;/b&gt;&lt;br&gt;Sin cambios: 18 paquetes / 204 bytes&lt;br&gt;INIT_SEQUENCER externo: WAIT final 7 ms" style="rounded=0;html=1;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="370" y="850" width="430" height="110" as="geometry"/></mxCell>
        <mxCell id="phyif" value="&lt;b&gt;PHY_IF&lt;/b&gt;&lt;br&gt;Registro de salidas ↓&lt;br&gt;Reset HS=00, LP=11&lt;br&gt;SoT B8/B8 por ráfaga" style="rounded=0;html=1;fillColor=#F3F2DB;strokeColor=#3B505C;strokeWidth=2;fontSize=18;verticalAlign=bottom;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="1380" y="700" width="240" height="220" as="geometry"/></mxCell>
        <mxCell id="phy" value="&lt;b&gt;PHY GOWIN&lt;/b&gt;&lt;br&gt;Sin cambios de tiempos&lt;br&gt;Drenaje / trail / CLK&lt;br&gt;↓ slot → ↑ OSER8&lt;br&gt;Luego pads modelados" style="rounded=0;html=1;fillColor=#F3F2DB;strokeColor=#3B505C;strokeWidth=2;fontSize=18;verticalAlign=bottom;spacingBottom=20;" vertex="1" parent="1"><mxGeometry x="1750" y="700" width="260" height="220" as="geometry"/></mxCell>
        <mxCell id="src-req" value="VID_REQ" style="text;html=1;align=right;fontColor=#674594;fontSize=17;" vertex="1" parent="1"><mxGeometry x="100" y="525" width="150" height="25" as="geometry"/></mxCell>
        <mxCell id="dst-req" value="VID_REQ" style="text;html=1;align=left;fontColor=#674594;fontSize=17;" vertex="1" parent="1"><mxGeometry x="380" y="370" width="150" height="25" as="geometry"/></mxCell>
        <mxCell id="req" edge="1" parent="1" source="source" target="link" style="endArrow=block;strokeColor=#674594;strokeWidth=1.5;exitX=1;exitY=.1;entryX=0;entryY=.7;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="547"/><mxPoint x="280" y="392"/></Array></mxGeometry></mxCell>
        <mxCell id="src-ready" value="VID_LINE_RDY" style="text;html=1;align=right;fontColor=#137987;fontSize=17;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="180" height="25" as="geometry"/></mxCell>
        <mxCell id="dst-ready" value="VID_LINE_RDY" style="text;html=1;align=left;fontColor=#137987;fontSize=17;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="180" height="25" as="geometry"/></mxCell>
        <mxCell id="ready" edge="1" parent="1" source="source" target="link" style="endArrow=block;strokeColor=#137987;strokeWidth=1.5;exitX=1;exitY=.23;entryX=0;entryY=.85;jumpStyle=arc;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="582.1"/><mxPoint x="300" y="431"/></Array></mxGeometry></mxCell>
        <mxCell id="src-word" value="VID_WORD[15:0]" style="text;html=1;align=right;fontColor=#267744;fontSize=17;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="190" height="25" as="geometry"/></mxCell>
        <mxCell id="dst-word" value="VID_WORD[15:0]" style="text;html=1;align=left;fontColor=#267744;fontSize=17;" vertex="1" parent="1"><mxGeometry x="910" y="600" width="190" height="25" as="geometry"/></mxCell>
        <mxCell id="word" edge="1" parent="1" source="source" target="packer" style="endArrow=block;strokeColor=#267744;strokeWidth=3;exitX=1;exitY=.4;entryX=0;entryY=.32727;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="src-rd" value="VID_RD" style="text;html=1;align=left;fontColor=#1D5B9C;fontSize=17;" vertex="1" parent="1"><mxGeometry x="910" y="800" width="140" height="25" as="geometry"/></mxCell>
        <mxCell id="dst-rd" value="VID_RD" style="text;html=1;align=right;fontColor=#1D5B9C;fontSize=17;" vertex="1" parent="1"><mxGeometry x="100" y="640" width="150" height="25" as="geometry"/></mxCell>
        <mxCell id="rd" edge="1" parent="1" source="packer" target="source" style="endArrow=block;strokeColor=#1D5B9C;strokeWidth=1.5;exitX=0;exitY=.9;entryX=1;entryY=.53;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="817"/><mxPoint x="840" y="663.1"/></Array></mxGeometry></mxCell>
        <mxCell id="src-kind" value="BURST_KIND[1:0]" style="text;html=1;align=right;fontColor=#92621C;fontSize=17;" vertex="1" parent="1"><mxGeometry x="595" y="370" width="195" height="25" as="geometry"/></mxCell>
        <mxCell id="dst-kind" value="BURST_KIND[1:0]" style="text;html=1;align=left;fontColor=#92621C;fontSize=17;" vertex="1" parent="1"><mxGeometry x="910" y="525" width="195" height="25" as="geometry"/></mxCell>
        <mxCell id="kind" edge="1" parent="1" source="link" target="packer" style="endArrow=block;strokeColor=#92621C;strokeWidth=3;exitX=1;exitY=.7;entryX=0;entryY=.1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="392"/><mxPoint x="820" y="553"/></Array></mxGeometry></mxCell>
        <mxCell id="src-pk" value="PK_START" style="text;html=1;align=right;fontColor=#88445B;fontSize=17;" vertex="1" parent="1"><mxGeometry x="630" y="410" width="160" height="25" as="geometry"/></mxCell>
        <mxCell id="dst-pk" value="PK_START" style="text;html=1;align=left;fontColor=#88445B;fontSize=17;" vertex="1" parent="1"><mxGeometry x="910" y="560" width="160" height="25" as="geometry"/></mxCell>
        <mxCell id="pk" edge="1" parent="1" source="link" target="packer" style="endArrow=block;strokeColor=#88445B;strokeWidth=1.5;exitX=1;exitY=.85;entryX=0;entryY=.2;jumpStyle=arc;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="431"/><mxPoint x="860" y="586"/></Array></mxGeometry></mxCell>
        <mxCell id="src-done" value="PK_DONE" style="text;html=1;align=right;fontColor=#752D67;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1130" y="525" width="160" height="25" as="geometry"/></mxCell>
        <mxCell id="dst-done" value="PK_DONE" style="text;html=1;align=right;fontColor=#752D67;fontSize=17;" vertex="1" parent="1"><mxGeometry x="630" y="330" width="160" height="25" as="geometry"/></mxCell>
        <mxCell id="done" edge="1" parent="1" source="packer" target="link" style="endArrow=block;strokeColor=#752D67;strokeWidth=1.5;exitX=1;exitY=.1;entryX=1;entryY=.55;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="553"/><mxPoint x="1330" y="353"/></Array></mxGeometry></mxCell>
        <mxCell id="src-out" value="WORD[15:0]" style="text;html=1;align=right;fontColor=#53670C;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1110" y="780" width="180" height="25" as="geometry"/></mxCell>
        <mxCell id="dst-out" value="WORD[15:0]" style="text;html=1;align=left;fontColor=#53670C;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1390" y="780" width="180" height="25" as="geometry"/></mxCell>
        <mxCell id="out" edge="1" parent="1" source="packer" target="phyif" style="endArrow=block;strokeColor=#53670C;strokeWidth=3;exitX=1;exitY=.85;entryX=0;entryY=.457;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lp-phy" value="LP_D0[1:0]" edge="1" parent="1" source="lp" target="phyif" style="endArrow=block;strokeColor=#344654;strokeWidth=3;exitX=1;exitY=.6;entryX=0;entryY=.98;fontSize=17;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ifout" value="HS_BYTE0/1[7:0]&lt;br&gt;LP_P/N[2:0]" edge="1" parent="1" source="phyif" target="phy" style="endArrow=block;html=1;strokeColor=#3B505C;strokeWidth=3;exitX=1;exitY=.3;entryX=0;entryY=.3;fontSize=15;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Receta de ensayo: 3 VSS → 8 HSS → 720 activos → 12 HSS. Sin VSE/EoTp. No equivale a decodificar la captura.&lt;br&gt;Primer/último dato RGB: d52/d1131 en PHY_IF; CRC d1132 y captura serial d1133. Sincronismos: VID_RD=0.&lt;br&gt;Control PHY y selección PHY_IF conservados (ver diagrama TOP y contrato); este detalle resalta únicamente el nuevo camino de cuadro." style="rounded=0;html=1;fillColor=#FFF8E6;strokeColor=#B7A46A;align=left;spacing=15;fontSize=19;" vertex="1" parent="1"><mxGeometry x="30" y="1040" width="1980" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
