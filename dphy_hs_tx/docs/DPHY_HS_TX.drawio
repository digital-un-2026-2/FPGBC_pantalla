        </mxCell>
        <mxCell id="selects" value="M2: TIME_LOAD=1 → carga M0; 0 → Σ0. M3: POST_LOAD=1 → constante; 0 → Σ1.&#10;Enables: LOAD | (STEP &amp; Q≠0). Reset prioritario; retención sin realimentación externa." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;fontSize=15;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="450" y="570" width="1250" height="65" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
