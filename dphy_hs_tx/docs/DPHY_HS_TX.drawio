        <mxCell id="m3" value="M3&#10;2→1&#10;4 bits" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="680" y="670" width="100" height="100" />
