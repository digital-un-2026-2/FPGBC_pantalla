          <mxGeometry as="geometry" x="530" y="210" width="230" height="140" />
        </mxCell>
        <mxCell id="timer" value="TIME_LEFT[11:0]&#10;12 bits · reset 0&#10;load &gt; step &gt; hold" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="900" y="210" width="300" height="140" />
        </mxCell>
        <mxCell id="dec0" value="Σ0&#10;TIME_LEFT − 1&#10;12 bits" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="900" y="470" width="300" height="90" />
        </mxCell>
        <mxCell id="cmp0" value="C0: TIME_LEFT == 0&#10;TIME_LAST_INTERVAL" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;shape=rectangle;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1350" y="230" width="350" height="100" />
        </mxCell>
        <mxCell id="constmux" value="10 × 12 bits" source="constants" target="m0" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
