        <mxCell id="1" parent="0" />
        <mxCell id="title" value="dphy_hs_tx · DATAPATH RTL · Temporizadores y UC&#10;S320: 16 bits de temporizadores + 36 bits de palabras = 52 bits lógicos (sin UC/modelo serial)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="20" width="1710" height="80" />
        </mxCell>
        <mxCell id="constants" value="Constantes S320 N−1 [12]&#10;0 INIT:3999 · 1 LPX:1&#10;2 CLK_PREP:1 · 3 CLK_ZERO:9&#10;4 CLK_PRE:0 · 5 HS_PREP:2&#10;6 HS_ZERO:4 · 7 HS_TRAIL:2&#10;8 EXIT:3 · 9 CLK_TRAIL:2" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="170" width="400" height="220" />
