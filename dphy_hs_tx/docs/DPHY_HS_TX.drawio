          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="timerdec" value="Q[11:0]" source="timer" target="dec0" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="postconst" value="Constante POST&#10;N_POST−1 = 8 [4]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="670" width="400" height="100" />
        </mxCell>
        <mxCell id="post" value="POST_LEFT[3:0]&#10;4 bits · reset 0&#10;load &gt; step &gt; hold" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="900" y="650" width="300" height="140" />
        </mxCell>
        <mxCell id="dec1" value="Σ1&#10;POST_LEFT − 1&#10;4 bits" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="900" y="880" width="300" height="90" />
        </mxCell>
        <mxCell id="cmp1" value="C1: POST_LEFT == 0&#10;POST_LAST_INTERVAL" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;shape=rectangle;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1350" y="670" width="350" height="100" />
        </mxCell>
        <mxCell id="postcmp" value="4 bits" source="post" target="cmp1" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="postdec" value="Q[3:0]" source="post" target="dec1" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="selok" value="K1: TIME_SEL ≤ 9&#10;TIME_SEL_OK&#10;Códigos 10…15: fallo al cargar" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="450" width="400" height="100" />
        </mxCell>
        <mxCell id="convention" value="INTERVALOS COMPLETOS&#10;Cargar N−1 en frontera E.&#10;Cero = intervalo actual es el último.&#10;UC cambia de fase en E+N.&#10;N=1: cargar 0; terminar en E+1.&#10;Nunca usar cero para parar a mitad de ciclo." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="850" width="650" height="170" />
        </mxCell>
        <mxCell id="uc" value="FRONTERA UC&#10;TIME_SEL[3:0], TIME_LOAD, TIME_STEP · POST_LOAD, POST_STEP&#10;Recibe C0, C1 y TIME_SEL_OK. Evalúa condiciones en posedge.&#10;Al final de Trail de datos: cargar POST y cargar TIME para Exit simultáneamente." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;dashed=1;strokeColor=#2255aa;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1110" width="1680" height="130" />
        </mxCell>
        <mxCell id="ctrl0" value="TIME_LOAD / STEP" source="uc" target="timer" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#2255aa;exitX=0.4;exitY=0;entryX=0.4;entryY=1;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="800" y="1060" />
              <mxPoint x="800" y="400" />
              <mxPoint x="1020" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ctrl1" value="POST_LOAD / STEP" source="uc" target="post" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#2255aa;exitX=0.3;exitY=0;entryX=0.4;entryY=1;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="750" y="1050" />
              <mxPoint x="750" y="820" />
              <mxPoint x="1020" y="820" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="foot" value="POST avanza en paralelo a Exit y espera de parada del reloj; se satura en 0, sin wrap.&#10;TIME se comparte entre fases secuenciales. STATE, causas, ACK y propiedad permanecen en UC/árbitro." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1280" width="1680" height="80" />
        </mxCell>
        <mxCell id="m2" value="M2&#10;2→1&#10;12 bits" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="790" y="230" width="80" height="100" />
