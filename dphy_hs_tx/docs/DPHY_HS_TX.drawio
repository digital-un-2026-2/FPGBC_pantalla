        <mxCell id="causes" value="CAUSE, primera causa retenida:&#10;5 estado inválido &gt; 6 selector &gt; 4 pipeline &gt; 1 máscara &gt; 3 protocolo &gt; 2 underflow&#10;0: sin fallo local; 7 reservado. phy_error = (CAUSE≠0). clear_error no recupera la PHY." style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;rounded=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1290" width="1710" height="100" />
        </mxCell>
        <mxCell id="notes" value="rst/phy_abort enmascaran ACK y HS. HALTED permite reposo local tras Exit incluso con aborto sostenido.&#10;Composición: reposo local &amp; !lp_grant &amp; lp_D0=11. El árbitro produce hs_complete.&#10;CLK_TOGGLE separa oscilación de HS-0. No son controles de pads ni prueba de conformidad D-PHY." style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;rounded=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1440" width="1710" height="110" />
        </mxCell>
