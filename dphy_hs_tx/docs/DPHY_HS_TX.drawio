  <diagram id="hs-flow" name="Flujo HS propuesto">
    <mxGraphModel dx="1200" dy="1800" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="1654">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PHY HS · Flujo PROPUESTO · 2026-11-08&#10;Documento previo a datapath/FSM/RTL" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="20" width="700" height="70" />
        </mxCell>
        <mxCell id="idle" value="Validar perfil y confirmar reposo conjunto&#10;Esperar clk_start_req" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="140" width="560" height="85" />
        </mxCell>
        <mxCell id="clk" value="Preparar CLK: entrada, Zero, oscilación y CLK-PRE&#10;Confirmar clk_prepared; mantener reloj" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="270" width="560" height="85" />
        </mxCell>
        <mxCell id="eclk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;" edge="1" parent="1" source="idle" target="clk">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="data" value="Esperar data_start_req&#10;Ejecutar preparación de D0/D1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="400" width="560" height="85" />
        </mxCell>
        <mxCell id="edata" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;" edge="1" parent="1" source="clk" target="data">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="start" value="Cumplir Zero mínimo → data_prepared; mantener HS-0&#10;Capturar W0 → Sync un ciclo → emitir W0&#10;PENDING + ACTIVE: máximo dos palabras" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="530" width="560" height="85" />
        </mxCell>
        <mxCell id="estart" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;" edge="1" parent="1" source="data" target="start">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="send" value="Consumir palabras y serializar sin burbujas&#10;Comprobar valid, keep y propiedad hasta last" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="660" width="560" height="85" />
        </mxCell>
        <mxCell id="esend" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;" edge="1" parent="1" source="start" target="send">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="drain" value="Capturar last y terminar todos sus bits&#10;Conservar data_stop_req si llega durante drenaje" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="790" width="560" height="85" />
        </mxCell>
        <mxCell id="edrain" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;" edge="1" parent="1" source="send" target="drain">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="trail" value="Con parada solicitada y datos drenados:&#10;Trail + retorno D0/D1 → data_stopped" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="920" width="560" height="85" />
        </mxCell>
        <mxCell id="etrail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;" edge="1" parent="1" source="drain" target="trail">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="stop" value="Esperar clk_stop_req; cumplir CLK-POST&#10;Trail + retorno CLK → clk_stopped; cumplir Exit" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1050" width="560" height="85" />
        </mxCell>
        <mxCell id="estop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;" edge="1" parent="1" source="trail" target="stop">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="return" value="Reposo conjunto → stop_ready&#10;El árbitro genera hs_complete → nueva reserva" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1180" width="560" height="85" />
        </mxCell>
        <mxCell id="ereturn" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;" edge="1" parent="1" source="stop" target="return">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="fault" value="Desde cualquier fase:&#10;reset / phy_abort / fallo local&#10;↓&#10;Descartar operación; sin éxito&#10;Recuperación coordinada&#10;&#10;Respuesta eléctrica ante aborto:&#10;PENDIENTE del wrapper" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="500" width="330" height="260" />
        </mxCell>
        <mxCell id="limits" value="Modelo propuesto S320:&#10;40 MHz · 320 Mb/s/lane&#10;PENDING + ACTIVE&#10;&#10;Pendiente antes de perfil físico:&#10;• cotejo normativo Zero/Sync/Trail&#10;• política de lane parcial&#10;• primitivas, relojes y reset&#10;&#10;keep distinto de 11 → fallo&#10;sin emitir la palabra inválida." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="870" width="330" height="310" />
        </mxCell>
        <mxCell id="footer" value="Flujo de responsabilidades; no es una FSM ni una tabla eléctrica.&#10;Fuentes, límites y pruebas: especificacion.md y verificacion.md." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#4a5568;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1360" width="970" height="70" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
