  <diagram id="fsm-controls" name="FSM · Controles y recuperación">
    <mxGraphModel dx="1800" dy="1600" grid="1" page="1" pageWidth="1800" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="dphy_hs_tx · FSM RTL · Controles y recuperación&#10;STATE[4:0] + CAUSE[2:0] = 8 bits UC; total con datapath = 60 bits lógicos" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;rounded=0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="20" width="1710" height="90" />
        </mxCell>
        <mxCell id="normal" value="Desde cualquier estado normal&#10;rst tiene prioridad absoluta" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="50" y="160" width="500" height="100" />
        </mxCell>
        <mxCell id="abort" value="23 · ABORT_EXIT&#10;CLR + T(8) al entrar&#10;HS deshabilitado · LP-11 lógico&#10;Contar 4 T aunque phy_abort siga alto" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="650" y="160" width="500" height="140" />
        </mxCell>
        <mxCell id="halt" value="24 · HALTED&#10;Reposo local, sin éxito&#10;CAUSE retenida · solo sale por reset" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1250" y="160" width="480" height="140" />
        </mxCell>
        <mxCell id="na" value="phy_abort o fallo local" source="normal" target="abort" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="ah" value="Z" source="abort" target="halt" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="reset" value="rst → BOOT · CAUSE=0 · flags/contadores reset&#10;Prioridad: reset &gt; recuperación activa &gt; aborto externo &gt; fallo local &gt; avance normal.&#10;Aborto externo no crea CAUSE; fallo local conserva primera causa. Sin lazo abort→error." style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;rounded=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="360" width="1710" height="120" />
        </mxCell>
        <mxCell id="h0" value="Fases" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;rounded=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="530" width="550" height="60" />
        </mxCell>
        <mxCell id="h1" value="Datos HS / M1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#222222;fontSize=17;rounded=0;" parent="1" vertex="1">
