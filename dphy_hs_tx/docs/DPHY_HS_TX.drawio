        <mxCell id="notes" value="Pérdida normal de grant después de aceptar last: drenar ACTIVE, sin fallo.&#10;PENDING se lee con su valor anterior y recibe a la vez la siguiente palabra.&#10;Ocupación máxima: dos palabras. Sync espera a W0; el primer payload sigue sin hueco.&#10;Al acabar bits: Trail → LP-11/Exit → data_stopped; CLK respeta POST antes de parar." style="rounded=0;whiteSpace=wrap;html=0;fontSize=16;fillColor=#fff2cc;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="740" width="1510" height="140" />
        </mxCell>
        <mxCell id="n1" value="Caso N=1: C0 captura W0 y emite Sync; C1 solicita parada y serializa W0; C2 inicia Trail.&#10;Fuentes y supuestos: contrato_temporal.md. Perfil LCD y política de lane parcial pendientes." style="rounded=0;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8cecc;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="20" y="920" width="1510" height="90" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
