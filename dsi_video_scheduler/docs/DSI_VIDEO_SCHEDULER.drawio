        <mxCell id="policy-STOP" parent="1" value="CLR = START_ACCEPT; LD = ventana | CLR&#10;D = (CLR ? 0 : Q) | entrada; set domina clear; rst → 0&#10;STOP_PENDING → UC al fin del cuadro" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#7a869a;spacing=10;rounded=0;dashed=1;">
