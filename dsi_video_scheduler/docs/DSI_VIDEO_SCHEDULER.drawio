          <mxGeometry x="430" y="535" width="660" height="160" as="geometry" />
        </mxCell>
        <mxCell id="init" parent="1" value="INICIALIZAR PANEL POR LPDT&#10;Enviar comandos DCS desde software&#10;Esperar fin de cada envío y retardos del panel" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="430" y="770" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="initialized" parent="1" value="¿Secuencia completada&#10;sin fallo local?" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fff4d6;strokeColor=#b69a50;spacing=10;rhombus;">
          <mxGeometry x="430" y="990" width="660" height="160" as="geometry" />
        </mxCell>
        <mxCell id="config" parent="1" value="CONFIGURAR POR CSR CON VÍDEO DETENIDO&#10;Seleccionar perfil compatible y VC&#10;APPLY valida dimensiones y calendario del perfil" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="430" y="1230" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="accepted" parent="1" value="¿Configuración aceptada&#10;y ruta disponible?" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fff4d6;strokeColor=#b69a50;spacing=10;rhombus;">
          <mxGeometry x="430" y="1450" width="660" height="160" as="geometry" />
        </mxCell>
        <mxCell id="run" parent="1" value="AUTORIZAR E INICIAR VÍDEO&#10;panel_initialized ← 1; emitir START&#10;El RTL captura la configuración activa" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="430" y="1690" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="monitor" parent="1" value="SUPERVISAR POR CSR&#10;Leer estado, cuadros y causa de fallo&#10;Atender solicitudes de parada o cambios" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="430" y="1890" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="faultq" parent="1" value="¿Hay fallo?" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fff4d6;strokeColor=#b69a50;spacing=10;rhombus;">
          <mxGeometry x="430" y="2080" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stopq" parent="1" value="¿Parar o reconfigurar?" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fff4d6;strokeColor=#b69a50;spacing=10;rhombus;">
          <mxGeometry x="430" y="2300" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stop" parent="1" value="SOLICITAR STOP&#10;Esperar stopped y enlace libre&#10;Antes de reconfigurar o enviar DCS" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="1200" y="2310" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fault" parent="1" value="BLOQUEAR NUEVOS INICIOS&#10;Registrar causa; invalidar autorización&#10;Recuperación con reset coordinado&#10;y nueva inicialización" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fde9e7;strokeColor=#ba5d54;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="1200" y="900" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="blocked" parent="1" value="SIN PERFIL VÁLIDO&#10;Mantener salida física inhibida&#10;Usar perfil sintético solo en simulación" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fde9e7;strokeColor=#ba5d54;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="1200" y="525" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="csr" parent="1" value="PUENTE LITEX / CSR PROPUESTO&#10;&#10;CPU → RTL&#10;CONFIG + APPLY; START; STOP&#10;panel_initialized; reset coordinado&#10;&#10;RTL → CPU&#10;config_ok; running; stopped&#10;frame_count; error; error_cause&#10;&#10;Eventos persistentes o contadores:&#10;el software no debe perder pulsos.&#10;CSR concretos y mapa: por implementar." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="1200" y="1200" width="500" height="480" as="geometry" />
        </mxCell>
        <mxCell id="limits" parent="1" value="RESPONSABILIDADES&#10;&#10;RISC-V configura y supervisa.&#10;Los píxeles no pasan por la CPU.&#10;Inicialización LPDT solo con vídeo parado.&#10;Fin LPDT no confirma recepción del LCD.&#10;Cambios activos se rechazan: parar primero." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="1200" y="1730" width="500" height="310" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" value="PROPUESTA · Sin CPU, firmware ni CSR nuevos implementados. Reset o fallo global invalidan la autorización.&#10;La página 2 detalla el flujo RTL. El perfil real del LCD continúa pendiente." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="60" y="2570" width="1680" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
