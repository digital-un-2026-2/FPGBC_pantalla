        <mxCell id="reg-STOP" parent="1" value="R_STOP [1]&#10;LD = ventana | CLR&#10;rst → 0" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;rounded=0;">
          <mxGeometry x="1350" y="1220" width="380" height="150" as="geometry" />
