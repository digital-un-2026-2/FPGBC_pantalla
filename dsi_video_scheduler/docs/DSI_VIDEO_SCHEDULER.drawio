        <mxCell id="wait" parent="1" value="ESPERAR START AUTORIZADO&#10;Configuración válida + panel inicializado&#10;PHY disponible + cadena libre de fallos" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
