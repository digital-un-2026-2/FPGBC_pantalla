        <mxCell id="begin" parent="1" value="INICIAR CUADRO&#10;Conservar perfil activo; reiniciar línea y calendario&#10;Iniciar fuente con start_valid ∧ start_ready" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
