        </mxCell>
        <mxCell id="safe" parent="1" value="MANTENER VÍDEO DETENIDO&#10;Inicializar CPU, memoria y acceso a CSR&#10;Invalidar panel_initialized" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
