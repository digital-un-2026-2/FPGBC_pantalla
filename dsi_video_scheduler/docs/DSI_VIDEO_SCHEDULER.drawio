        <mxCell id="mux" parent="1" value="M_STATUS · N:1 [32]&#10;Entradas numeradas:&#10;0: estado; 1: frame_count&#10;2: causa; 3: perfil activo&#10;4: WIDTH; 5: HEIGHT&#10;Resto: 0" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;shape=trapezoid;direction=east;">
          <mxGeometry x="560" y="1510" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="status" parent="1" value="BUS DE ESTADO&#10;UC: config_ok, running, stopped&#10;R_FRAMES[32], R_ERROR[5]&#10;R_ACTIVE y ROM_META&#10;Cada entrada extendida a 32 bits" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#f3f5f7;strokeColor=#7a869a;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="1120" y="1550" width="600" height="220" as="geometry" />
        </mxCell>
        <mxCell id="uc" parent="1" value="FRONTERA UC ↔ DATAPATH&#10;UC recibe: cfg_match, órdenes CSR, panel_initialized, disponibilidad PHY y condiciones de las otras vistas.&#10;UC genera: START_ACCEPT, config_ok, running, stopped, comandos de fuente/paquete y enables.&#10;APPLY solo valida R_SHADOW. START_ACCEPT captura R_ACTIVE una vez por ejecución; repetir cuadros no lo recarga.&#10;CPU no alimenta bytes RGB. Para esta propuesta, CSR y vídeo comparten clk; otros dominios requieren un puente CDC." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#7a869a;spacing=10;rounded=0;dashed=1;">
          <mxGeometry x="60" y="1950" width="1660" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
