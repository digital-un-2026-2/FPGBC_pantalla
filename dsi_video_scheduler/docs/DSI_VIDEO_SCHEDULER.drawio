          <mxGeometry x="660" y="1790" width="480" height="210" as="geometry" />
        </mxCell>
        <mxCell id="frame-add" parent="1" value="A4 · +1 [32]&#10;Entrada: R_FRAMES" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="1250" y="1720" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="frames" parent="1" value="R_FRAMES [32]&#10;D=A4; LD=FRAME_COMPLETE&#10;rst → 0; módulo 2³²&#10;→ CSR frame_count" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;rounded=0;">
          <mxGeometry x="1250" y="1870" width="480" height="160" as="geometry" />
        </mxCell>
        <mxCell id="uc" parent="1" value="FRONTERA CON UC · FSM EN PÁGINAS 7–8&#10;Entradas: released, late, event_legal, BCNT/WC, LINE/HEIGHT, seen_next, FAULT_REQ y autorización.&#10;Salidas: START_ACCEPT, FRAME_BEGIN, EVENT_LOAD/ADVANCE, G, cmd_valid, RGB_COMPLETE, FRAME_COMPLETE.&#10;RGB_COMPLETE: UC emite una vez al comprobar paquete+HS completos y BCNT==WC sin fallo.&#10;FRAME_COMPLETE: END liberado, todas las líneas+fuente completas, enlace libre y sin fallo. Emitir una vez.&#10;STOP conserva el nivel hasta terminar cuadro. Ante fallo, bloquear nuevos paquetes y exigir reset coordinado.&#10;Un fallo del planificador no conmuta directamente pads ni borra el diagnóstico del wrapper Gowin." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#7a869a;spacing=10;rounded=0;dashed=1;">
          <mxGeometry x="60" y="2180" width="1670" height="350" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
