        </mxCell>
        <mxCell id="footer" parent="1" value="PROPUESTA · Registros en ↑clk; rst síncrono prioritario. LD=0 conserva Q.&#10;Buses [n]; controles discontinuos. Redes con el mismo nombre se conectan entre páginas. Ecuaciones: datapath.md." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
