        <mxCell id="add-IP" parent="1" value="A1 · +1 [16]&#10;Entrada: IP" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="360" y="1140" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mux-IP" parent="1" value="M1 · 2:1 [16]&#10;0: constante 0&#10;1: A1&#10;SEL = !FRAME_BEGIN" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;shape=trapezoid;direction=east;">
          <mxGeometry x="770" y="930" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="reg-IP" parent="1" value="R_IP [16]&#10;D = M1; rst → 0&#10;LD = FRAME_BEGIN | EVENT_ADVANCE" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;rounded=0;">
          <mxGeometry x="1250" y="940" width="460" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ctrl-IP" parent="1" value="FRAME_BEGIN; EVENT_ADVANCE; SEL_M1&#10;Índice 0 … N_EVENTS−1" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#7a869a;spacing=10;rounded=0;dashed=1;">
          <mxGeometry x="60" y="1360" width="1640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rom" parent="1" value="ROM_EVENT [N_PROFILES × E_MAX × 66]&#10;Dirección: {active_profile_id[8], IP[16]}&#10;Salida: KIND[2], RELEASE[32], DEADLINE[32]&#10;Fuera de rango: código inválido&#10;Lectura combinacional" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;rounded=0;">
          <mxGeometry x="60" y="1600" width="650" height="240" as="geometry" />
        </mxCell>
        <mxCell id="evt" parent="1" value="R_EVT [66]&#10;D = ROM_EVENT&#10;LD = EVENT_LOAD&#10;Reset → 0&#10;UC conserva event_valid" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;rounded=0;">
          <mxGeometry x="850" y="1620" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bounds" parent="1" value="C_IP / C_KIND&#10;IP &lt; N_EVENTS&#10;Avance: IP+1 [17]&#10;&lt; N_EVENTS&#10;KIND ≠ 3&#10;→ UC: event_legal" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="1400" y="1590" width="330" height="260" as="geometry" />
        </mxCell>
        <mxCell id="time" parent="1" value="C_TIME · COMPARACIONES [32]&#10;released = TICK ≥ R_EVT.RELEASE&#10;late = TICK &gt; R_EVT.DEADLINE&#10;frame_late = TICK &gt; T_FRAME&#10;overflow = TICK == 0xFFFFFFFF" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="60" y="2020" width="650" height="240" as="geometry" />
        </mxCell>
        <mxCell id="conditions" parent="1" value="CONDICIONES → UC&#10;event_legal; kind[2]; released; late&#10;frame_late; overflow&#10;WAIT termina al alcanzar RELEASE&#10;RGB solo inicia desde RELEASE&#10;END requiere cuadro y enlace completos" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#f3f5f7;strokeColor=#7a869a;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="850" y="2020" width="880" height="240" as="geometry" />
        </mxCell>
        <mxCell id="policy" parent="1" value="LÍMITES DE AVANCE&#10;TICK_EN = frame_active &amp; !overflow; se satura antes de envolver. El tiempo avanza también bajo backpressure.&#10;EVENT_ADVANCE solo al terminar WAIT o RGB. Antes de IP+1, comprobar IP+1 &lt; N_EVENTS; END no incrementa IP.&#10;La tabla debe incluir carga de R_EVT y ciclos de control. END cumple RELEASE ≤ TICK ≤ DEADLINE ≤ T_FRAME.&#10;Fuentes combinacionales se estabilizan antes de EVENT_LOAD; no se presupone la latencia de una BRAM síncrona." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="60" y="2380" width="1660" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
