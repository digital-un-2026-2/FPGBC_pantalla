        <mxCell id="reg-TICK" parent="1" value="R_TICK [32]&#10;D = M0; rst → 0&#10;LD = FRAME_BEGIN | TICK_EN" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;rounded=0;">
