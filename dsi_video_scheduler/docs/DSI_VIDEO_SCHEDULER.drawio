        </mxCell>
        <mxCell id="subtitle" parent="1" value="PROPUESTA · Calendario de eventos según el modo del panel, sin fijar porches, fps ni bitrate.&#10;Fuente inicial: dsi_test_pattern; reloj de vídeo y relación con CSR por definir al integrar." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
