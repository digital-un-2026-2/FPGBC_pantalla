        <mxCell id="cause" parent="1" value="P_ERR · PRIORIDAD COMBINACIONAL&#10;1: PHY / aborto; 2: transporte&#10;3: overflow; 4: plazo; 5: evento ilegal&#10;6: contador; 7: marcas; 8: fuente&#10;FAULT_REQ; CAUSE[4]" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;ellipse;">
