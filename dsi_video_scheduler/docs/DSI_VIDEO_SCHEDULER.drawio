        <mxCell id="physical" parent="1" value="ESPERAR FIN DEL TRANSPORTE&#10;Retener eventos de fin aunque lleguen antes&#10;Esperar hs_complete y transporte disponible" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="430" y="2220" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="deadline" parent="1" value="¿Se cumple el calendario&#10;sin error de la cadena?" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fff4d6;strokeColor=#b69a50;spacing=10;rhombus;">
          <mxGeometry x="430" y="2440" width="660" height="160" as="geometry" />
        </mxCell>
        <mxCell id="advance" parent="1" value="AVANZAR EVENTO / LÍNEA&#10;Solo después del paquete completo&#10;No iniciar otro cuadro con fin local del payload" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="430" y="2700" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="frame" parent="1" value="CUADRO TRANSMITIDO LOCALMENTE&#10;Incrementar frame_count&#10;Incluye finalización del último evento" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="1200" y="1000" width="510" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stopq" parent="1" value="¿STOP pendiente?" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fff4d6;strokeColor=#b69a50;spacing=10;rhombus;">
          <mxGeometry x="1200" y="1240" width="510" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stopped" parent="1" value="DETENIDO&#10;Publicar stopped con enlace libre&#10;Aceptar configuración o inicialización" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#e8edf4;strokeColor=#5c708a;spacing=10;rounded=1;arcSize=50;">
          <mxGeometry x="1200" y="1480" width="510" height="140" as="geometry" />
        </mxCell>
        <mxCell id="delay" parent="1" value="ESPERAR PLAZO&#10;Contador RTL&#10;Al vencer: avanzar" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="50" y="1280" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="fault" parent="1" value="FALLO PERSISTENTE&#10;Bloquear nuevos descriptores&#10;Publicar primera causa por CSR&#10;Si falla PHY: aplicar aborto existente&#10;Recuperar con reset de toda la cadena" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fde9e7;strokeColor=#ba5d54;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="1200" y="2410" width="510" height="220" as="geometry" />
        </mxCell>
        <mxCell id="meaning" parent="1" value="DOS FINALES DIFERENTES&#10;&#10;packet_done: CRC final aceptado por el consumidor del preparador.&#10;hs_done: última palabra entregada al PHY.&#10;hs_complete: secuencia HS finalizada.&#10;&#10;El planificador debe conservar estos eventos, no exigir pulsos simultáneos.&#10;Ninguno confirma recepción del LCD." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="1200" y="1750" width="510" height="440" as="geometry" />
        </mxCell>
        <mxCell id="global" parent="1" value="PRIORIDADES GLOBALES&#10;&#10;1. Reset coordinado → RESET.&#10;2. Fallo / aborto → FALLO.&#10;3. STOP → retener solicitud y terminar cuadro.&#10;&#10;Fallo o plazo perdido no se reintentan como cuadro correcto." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="1200" y="2800" width="510" height="300" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" value="CONTRATO DE LA PROPUESTA&#10;&#10;• Esperas y ready: conservar datos y descriptor; reset/fallo tienen prioridad global.&#10;• Un paquete en vuelo; el transporte actual no carga el siguiente durante HS.&#10;• Configuración activa inmutable; STOP se atiende al terminar el cuadro.&#10;• Si un plazo vence en cualquier operación, registrar fallo; no acumular retraso silencioso.&#10;• El calendario debe incluir carga del paquete, arranque/parada HS y tiempo de enlace." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="60" y="2980" width="1060" height="340" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" value="LÍMITES · El calendario exacto depende de Video/Command Mode y del panel. Eventos no RGB requieren&#10;preparación adicional. Este flujo no demuestra que el transporte actual alcance la frecuencia de imagen requerida." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="60" y="3340" width="1680" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
