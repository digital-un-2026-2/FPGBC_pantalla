        <mxCell id="subtitle" parent="1" value="PROPUESTA · Inicialización y supervisión por software; vídeo coordinado por RTL.&#10;Una caja representa una operación, no un ciclo ni un estado definitivo." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
