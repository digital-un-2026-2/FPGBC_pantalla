        <mxCell id="title" parent="1" value="DATAPATH 3/4 · BYTES, LÍNEAS Y CADENA DSI" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
