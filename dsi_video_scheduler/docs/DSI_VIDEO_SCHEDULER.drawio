        <mxCell id="iswait" parent="1" value="¿Evento = espera?" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fff4d6;strokeColor=#b69a50;spacing=10;rhombus;">
