        <mxCell id="descriptor" parent="1" value="OFRECER DESCRIPTOR DEL PAQUETE&#10;Mantener campos y valid hasta ready&#10;RGB888: DT=0x3E; WC=3×WIDTH; VC del perfil" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="430" y="1520" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="payload" parent="1" value="PREPARAR Y CARGAR PAQUETE COMPLETO&#10;Para RGB: conectar payload de la fuente&#10;Solo valid ∧ ready consume bytes; comprobar marcas" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#5b7fa6;spacing=10;rounded=1;arcSize=12;">
