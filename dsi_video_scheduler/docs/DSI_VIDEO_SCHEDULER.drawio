        <mxCell id="add-TICK" parent="1" value="A0 · +1 [32]&#10;Entrada: TICK" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#344563;spacing=10;ellipse;">
