        </mxCell>
        <mxCell id="subtitle" parent="1" value="ROM_EVENT: calendario expandido de un cuadro. WAIT=0, RGB=1, END=2; 3 es inválido.&#10;Registro de evento estable durante su ejecución; no se programa esta ROM por CSR." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
