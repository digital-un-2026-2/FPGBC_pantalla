        <mxCell id="title" parent="1" value="FSM · PLANIFICADOR DSI · TRANSICIONES" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="60" y="20" width="1680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" value="PROPUESTA · STATE[3:0], diez códigos usados. Registros en ↑clk; rst síncrono activo alto.&#10;Toda transición normal exige !FAULT_REQ. Los controles de handshake son combinacionales antes del flanco." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="60" y="100" width="1680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="IDLE" parent="1" value="IDLE · 0000&#10;Configurar / esperar START" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="430" y="260" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ARM" parent="1" value="ARM · 0001&#10;Solicitar inicio de fuente" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="430" y="520" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="LOAD" parent="1" value="LOAD · 0010&#10;Cargar evento desde ROM" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="430" y="780" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="RELEASE" parent="1" value="RELEASE · 0011&#10;Esperar instante y decodificar&#10;END aceptado: FRAME_COMPLETE" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="430" y="1070" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="CMD" parent="1" value="CMD · 0100&#10;Ofrecer descriptor RGB" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="430" y="1410" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PAYLOAD" parent="1" value="PAYLOAD · 0101&#10;Consumir bytes con handshake" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="430" y="1690" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TX_WAIT" parent="1" value="TX_WAIT · 0110&#10;Esperar finales retenidos" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="430" y="1970" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ADVANCE" parent="1" value="ADVANCE · 0111&#10;Incrementar IP una vez" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="430" y="2250" width="630" height="160" as="geometry" />
        </mxCell>
        <mxCell id="FINISH" parent="1" value="FINISH · 1000&#10;Resolver STOP / repetición" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#eaf2fc;strokeColor=#344563;spacing=10;ellipse;">
          <mxGeometry x="1230" y="1070" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="FAULT" parent="1" value="FAULT · 1001&#10;Bloqueado hasta reset" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fde9e7;strokeColor=#ba5d54;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="1230" y="2250" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="reset" parent="1" value="rst desde cualquier estado → IDLE&#10;Limpiar registros y autorización&#10;Prioridad absoluta" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#e8edf4;strokeColor=#5c708a;spacing=10;rounded=1;arcSize=50;">
          <mxGeometry x="60" y="2600" width="700" height="150" as="geometry" />
        </mxCell>
        <mxCell id="global" parent="1" value="FALLO GLOBAL → FAULT&#10;PHY, transporte, plazo, contadores o marcas&#10;LOAD / ADVANCE sin índice válido → causa 5&#10;KIND inválido o STATE=10…15 → causa 5&#10;Solo reset coordinado permite salir" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=#fde9e7;strokeColor=#ba5d54;spacing=10;rounded=1;arcSize=12;">
          <mxGeometry x="1130" y="1830" width="610" height="250" as="geometry" />
        </mxCell>
        <mxCell id="holds" parent="1" value="RETENCIÓN Y PRIORIDAD&#10;Sin guard habilitado, conservar STATE. LOAD, ADVANCE y FINISH resuelven en un ciclo sin fallo.&#10;1. rst; 2. FAULT_REQ; 3. transición normal. FAULT es absorbente; STOP no aborta el cuadro.&#10;SF = source.start_valid &amp; source.start_ready. DF = cmd_valid &amp; cmd_ready. LAST_BF = BF &amp; (BCNT=WC−1)." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="60" y="2790" width="1680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="guards" parent="1" value="GUARDS DEL DATAPATH&#10;&#10;PKT_OK: tres finales retenidos,&#10;transporte libre y BCNT=WC.&#10;&#10;END_OK: KIND=END, released,&#10;LINE=HEIGHT, FRAME_SEEN_NEXT,&#10;fuente y enlace libres, sin paquete&#10;pendiente y END en último índice.&#10;&#10;Plazo de evento solo en RELEASE,&#10;CMD, PAYLOAD y TX_WAIT.&#10;&#10;TICK avanza también bajo pausas.&#10;En FINISH, STOP = STOP_NEXT." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="1200" y="1300" width="530" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fsm_controles" name="8 · FSM · CONTROLES">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="2650">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="FSM · CONTROLES Y CONDICIONES DE SALIDA" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
          <mxGeometry x="60" y="20" width="1680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" value="Todos los pulsos son enables presentes antes del flanco que ejecuta la operación; no registros ACTION.&#10;Señales no indicadas = 0. La captura de eventos y los contadores siguen las ecuaciones del datapath." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;spacing=10;text;align=left;spacing=0;">
