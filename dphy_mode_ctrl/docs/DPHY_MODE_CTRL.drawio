      <mxCell id="status" parent="1" value="&lt;b&gt;ESTADO EXTERNO · COMBINACIONAL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;phy_abort = rst | FAULT_ACTIVE | HS_FAULT&lt;br/&gt;error = !rst &amp;amp; FAULT_ACTIVE&lt;br/&gt;busy = BUSY_CTRL&lt;br/&gt;&lt;br/&gt;FAULT_ACTIVE y BUSY_CTRL son decodificaciones de fase de UC, [1] cada una." vertex="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#344563;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;">
