        <mxCell id="fault" parent="1" value="&lt;b&gt;VIGILANCIA GLOBAL DURANTE TODO HS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Si !pll_locked o hs_error:&lt;br/&gt;retirar grants y órdenes inmediatamente,&lt;br/&gt;pedir aborto y saltar a F (página 4).&lt;br/&gt;&lt;br/&gt;Aplica también mientras se espera reposo.&lt;br/&gt;rst tiene prioridad sobre este fallo." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#fdecea;strokeColor=#bd6a64;">
          <mxGeometry x="1010" y="300" width="420" height="290" as="geometry" />
        </mxCell>
        <mxCell id="ack" parent="1" value="&lt;b&gt;CONFIRMACIONES DE LA PHY&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Cada ACK confirma que la fase solicitada terminó.&lt;br/&gt;&lt;br/&gt;Las operaciones internas Prepare / Zero / Trail / Exit y sus tiempos se definirán después.&lt;br/&gt;&lt;br/&gt;Estas cajas no son fases eléctricas completas." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
          <mxGeometry x="1010" y="690" width="420" height="290" as="geometry" />
        </mxCell>
        <mxCell id="continuous" parent="1" value="&lt;b&gt;CONTINUIDAD DE LA TRANSFERENCIA&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Una vez concedido HS, hs_data_ready no permite pausar el flujo.&lt;br/&gt;&lt;br/&gt;Mantener continuidad o avisar con hs_error.&lt;br/&gt;&lt;br/&gt;Una solicitud LP pendiente no interrumpe esta operación." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
          <mxGeometry x="1010" y="1060" width="420" height="280" as="geometry" />
        </mxCell>
        <mxCell id="wait" parent="1" value="&lt;b&gt;ESPERAR NO ES REEMITIR&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Cada orden se mantiene mientras se espera su confirmación; no inicia una nueva operación en cada vuelta.&lt;br/&gt;&lt;br/&gt;No se admite otro dueño durante preparación, transferencia ni parada." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
          <mxGeometry x="1010" y="1490" width="420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="safety" parent="1" value="&lt;b&gt;ABSTRACCIÓN ACTUAL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Las órdenes son lógicas para un modelo de simulación.&lt;br/&gt;&lt;br/&gt;No son OE/OEN, GPIO LP ni señales serie HS.&lt;br/&gt;No fijan clock lane continuo/no continuo para el panel real." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
