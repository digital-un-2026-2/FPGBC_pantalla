      <mxCell id="eligible" parent="1" value="&lt;b&gt;ELEGIBILIDAD · COMBINACIONAL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;LP_E = lp_req &amp;amp; R_LP&lt;br/&gt;&lt;br/&gt;HS_E = hs_req &amp;amp; R_HS&lt;br/&gt;&amp;amp; pll_locked &amp;amp; hs_data_ready &amp;amp; !hs_error&lt;br/&gt;&lt;br/&gt;R_LP / R_HS: Q de los registros inferiores" vertex="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#344563;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;">
