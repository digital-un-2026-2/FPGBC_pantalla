        <mxCell id="lp" parent="1" value="&lt;b&gt;L · RECORRIDO LPDT&lt;/b&gt;&lt;br/&gt;Continuar en página 2" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#e8f4ed;strokeColor=#5c9476;">
