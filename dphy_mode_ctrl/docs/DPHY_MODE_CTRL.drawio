      <mxCell id="subtitle" parent="1" value="&lt;b&gt;PROPUESTA PARA REVISIÓN · FSM 2 / 2&lt;/b&gt;&lt;br/&gt;Prioridad en ↑clk: rst → HS_FAULT → codificación inválida → transición normal.&lt;br/&gt;Moore para intenciones por estado; condiciones combinacionales para cargas, eventos y protección de salidas." vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#172b4d;fontSize=21;fontColor=#42526e;">
