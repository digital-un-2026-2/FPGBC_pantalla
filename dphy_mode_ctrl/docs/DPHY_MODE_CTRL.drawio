        <mxCell id="reserve" parent="1" value="&lt;b&gt;RESERVAR EN ↑clk&lt;/b&gt;&lt;br/&gt;busy ← 1; guardar acción de aceptación&lt;br/&gt;En ↓clk: consumir / rearmar solicitud&lt;br/&gt;y preferir el otro modo" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;">
