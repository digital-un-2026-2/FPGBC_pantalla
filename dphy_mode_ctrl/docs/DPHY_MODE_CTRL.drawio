        <mxCell id="release" parent="1" value="&lt;b&gt;RETIRAR PERMISO LPDT&lt;/b&gt;&lt;br/&gt;lp_grant ← 0&lt;br/&gt;Esperar reposo sin admitir otro dueño" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#e8f4ed;strokeColor=#5c9476;">
