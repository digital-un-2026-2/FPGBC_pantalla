        </mxCell>
        <mxCell id="bridge" parent="1" value="&lt;b&gt;CONEXIÓN DE PRUEBA&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;dsi_lpdt_bridge.lp_req → lp_req&lt;br/&gt;lp_grant → permiso_arranque&lt;br/&gt;tx_done → lp_done&lt;br/&gt;&lt;br/&gt;El puente conserva el paquete completo; el motor añade 87 y genera estados D0." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
