      <mxCell id="head1" parent="1" value="&lt;b&gt;STATE después&lt;/b&gt;" vertex="1" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#5b7fa6;strokeWidth=2;fillColor=#ffffff;spacing=16;fontFamily=Helvetica;fontSize=22;fontColor=#172b4d;fillColor=#edf2f8;fontSize=20;spacing=7;">
