        <mxCell id="global" parent="1" value="&lt;b&gt;PRIORIDAD GLOBAL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Desde cualquier punto, rst = 1 lleva al reset interno.&lt;br/&gt;&lt;br/&gt;Durante una operación HS, PLL perdido o hs_error lleva a F (página 4), sin fin de éxito." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
          <mxGeometry x="1070" y="275" width="370" height="245" as="geometry" />
        </mxCell>
        <mxCell id="rearm" parent="1" value="&lt;b&gt;REARME · EN CADA ↓clk&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Si lp_req = 0: rearmar LP.&lt;br/&gt;Si hs_req = 0: rearmar HS.&lt;br/&gt;&lt;br/&gt;La aceptación se decide en ↑clk y se aplica en ↓clk mediante ACTION.&lt;br/&gt;req sostenido en 1 no duplica operaciones." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
          <mxGeometry x="60" y="290" width="350" height="260" as="geometry" />
        </mxCell>
        <mxCell id="return" parent="1" value="&lt;b&gt;R · RETORNO DESDE PÁGINAS 2–4&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Volver a ESPERAR ENLACE LIBRE.&lt;br/&gt;El pulso de fin, si corresponde, dura un ciclo; después vuelve a cero." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
          <mxGeometry x="1060" y="650" width="380" height="210" as="geometry" />
        </mxCell>
        <mxCell id="scope" parent="1" value="&lt;b&gt;REPOSO CONFIRMADO&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;stop_ready representa las tres lanes en reposo, incluidas las esperas que deba garantizar la PHY.&lt;br/&gt;&lt;br/&gt;En esta fase es una confirmación del modelo de simulación." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
