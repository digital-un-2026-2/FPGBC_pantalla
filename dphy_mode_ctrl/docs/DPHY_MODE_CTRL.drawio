  <diagram id="flow-3" name="4 · Reset y fallos">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
