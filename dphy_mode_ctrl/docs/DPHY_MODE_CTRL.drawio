        <mxCell id="ownership" parent="1" value="&lt;b&gt;PROPIEDAD HASTA TERMINAR&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Una solicitud HS pendiente no interrumpe LPDT.&lt;br/&gt;&lt;br/&gt;La PLL HS no es condición para LPDT.&lt;br/&gt;&lt;br/&gt;Se ignora hs_done durante este recorrido." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
