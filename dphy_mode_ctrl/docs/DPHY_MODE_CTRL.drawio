        <mxCell id="title" parent="1" value="&lt;b&gt;DPHY_MODE_CTRL · RESET Y RECUPERACIÓN&lt;/b&gt;" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fontSize=29;">
          <mxGeometry x="60" y="25" width="1380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" value="&lt;b&gt;PROPUESTA PARA REVISIÓN · 4 / 4&lt;/b&gt;&lt;br/&gt;Prioridad: reset interno → fallo durante HS → recorrido normal. Un aborto no produce un fin de éxito." vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fontSize=17;fontColor=#42526e;">
          <mxGeometry x="60" y="90" width="1380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="reset-title" parent="1" value="&lt;b&gt;1 · RESET DESDE CUALQUIER PUNTO&lt;/b&gt;" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fontSize=22;">
          <mxGeometry x="80" y="185" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reset-entry" parent="1" value="&lt;b&gt;rst == 1&lt;/b&gt;" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;arcSize=50;fillColor=#e8edf4;strokeColor=#5c708a;">
          <mxGeometry x="230" y="300" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="block" parent="1" value="&lt;b&gt;BLOQUEAR INMEDIATAMENTE&lt;/b&gt;&lt;br/&gt;Grants, req_ready y órdenes HS ← 0&lt;br/&gt;phy_abort ← 1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;">
          <mxGeometry x="110" y="440" width="490" height="110" as="geometry" />
        </mxCell>
        <mxCell id="clear" parent="1" value="&lt;b&gt;RESET EN AMBOS FLANCOS&lt;/b&gt;&lt;br/&gt;↑clk: fase ← IDLE; acción ← NONE&lt;br/&gt;↓clk: borrar causa y fin; rearmar&lt;br/&gt;solicitudes y preferir LP" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;">
          <mxGeometry x="110" y="635" width="490" height="130" as="geometry" />
        </mxCell>
        <mxCell id="rst-end" parent="1" value="&lt;b&gt;¿rst == 0?&lt;/b&gt;" vertex="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#fff4d6;strokeColor=#b69a50;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;">
          <mxGeometry x="170" y="865" width="370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="reset-release" parent="1" value="&lt;b&gt;RETIRAR PETICIÓN DE ABORTO&lt;/b&gt;&lt;br/&gt;Esperar que la PHY confirme reposo&lt;br/&gt;No emitir lp_complete ni hs_complete" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;">
          <mxGeometry x="110" y="1110" width="490" height="115" as="geometry" />
        </mxCell>
        <mxCell id="reset-R" parent="1" value="&lt;b&gt;R · VOLVER A PÁGINA 1&lt;/b&gt;" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;arcSize=50;fillColor=#e8edf4;strokeColor=#5c708a;">
          <mxGeometry x="140" y="1375" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fault-title" parent="1" value="&lt;b&gt;2 · FALLO DURANTE OPERACIÓN HS&lt;/b&gt;" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fontSize=22;">
          <mxGeometry x="810" y="185" width="610" height="60" as="geometry" />
        </mxCell>
        <mxCell id="F" parent="1" value="&lt;b&gt;F · !pll_locked o hs_error&lt;/b&gt;&lt;br/&gt;Desde cualquier paso HS; rst = 0" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#fdecea;strokeColor=#bd6a64;">
          <mxGeometry x="860" y="300" width="490" height="80" as="geometry" />
        </mxCell>
        <mxCell id="abort" parent="1" value="&lt;b&gt;ABORTAR SIN ÉXITO&lt;/b&gt;&lt;br/&gt;Grants y órdenes HS ← 0; phy_abort ← 1&lt;br/&gt;Conservar enlace bloqueado; busy ← 1" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#fdecea;strokeColor=#bd6a64;">
          <mxGeometry x="860" y="445" width="490" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cause" parent="1" value="&lt;b&gt;CONSERVAR LA CAUSA DECIDIDA&lt;/b&gt;&lt;br/&gt;↑clk: registrar FAULT y acción PLL/HS&lt;br/&gt;↓clk: capturar error_code desde acción&lt;br/&gt;error depende de la fase FAULT" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#fdecea;strokeColor=#bd6a64;">
          <mxGeometry x="860" y="635" width="490" height="130" as="geometry" />
        </mxCell>
        <mxCell id="recovery" parent="1" value="&lt;b&gt;ESPERAR RECUPERACIÓN&lt;/b&gt;&lt;br/&gt;Mantener error y petición de aborto&lt;br/&gt;Sin nuevas reservas; sin pulsos de éxito" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#fdecea;strokeColor=#bd6a64;">
          <mxGeometry x="860" y="865" width="490" height="110" as="geometry" />
        </mxCell>
        <mxCell id="recover-ok" parent="1" value="&lt;b&gt;¿clear_error y&lt;br/&gt;stop_ready?&lt;/b&gt;" vertex="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#fff4d6;strokeColor=#b69a50;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;">
          <mxGeometry x="910" y="1110" width="390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fault-clear" parent="1" value="&lt;b&gt;LIMPIAR EL FALLO&lt;/b&gt;&lt;br/&gt;↑clk: fase ← IDLE; acción ← CLEAR&lt;br/&gt;↓clk: error_code ← 0&lt;br/&gt;Sin reintento automático" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#fdecea;strokeColor=#bd6a64;">
          <mxGeometry x="860" y="1375" width="490" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fault-R" parent="1" value="&lt;b&gt;R · VOLVER A PÁGINA 1&lt;/b&gt;" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;arcSize=50;fillColor=#e8edf4;strokeColor=#5c708a;">
          <mxGeometry x="890" y="1620" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" value="&lt;b&gt;CONDICIONES DE RECUPERACIÓN&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;clear_error por sí solo no libera el enlace. También se necesita stop_ready del modelo de PHY.&lt;br/&gt;El productor debe observar el fallo y rearmar su solicitud antes de reintentar.&lt;br/&gt;La causa 1 tiene prioridad si PLL perdido y hs_error coinciden. Reserva de causa 3: condición interna inválida." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
          <mxGeometry x="80" y="1800" width="1340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="reset-model" parent="1" value="&lt;b&gt;RESET COMPARTIDO&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;El motor LPDT, el puente, el productor y la PHY de prueba también deben resetearse o procesar el aborto.&lt;br/&gt;&lt;br/&gt;Retirar un grant no revierte por sí solo una transmisión física." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
          <mxGeometry x="110" y="1540" width="490" height="190" as="geometry" />
        </mxCell>
