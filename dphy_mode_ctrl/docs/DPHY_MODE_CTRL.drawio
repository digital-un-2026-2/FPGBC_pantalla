        </mxCell>
        <mxCell id="meaning" parent="1" value="&lt;b&gt;SIGNIFICADO DEL FIN&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;lp_done: el productor terminó el envío local.&lt;br/&gt;lp_complete: el árbitro ya confirmó reposo y liberó el enlace.&lt;br/&gt;&lt;br/&gt;Ninguno confirma recepción por el LCD." vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;align=left;verticalAlign=top;fontSize=16;fillColor=#f6f8fb;strokeColor=#c1cbd8;">
