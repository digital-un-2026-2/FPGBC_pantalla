      </mxCell>
      <mxCell id="subtitle" parent="1" value="&lt;b&gt;RTL · DATAPATH 1 / 2&lt;/b&gt;&lt;br/&gt;Registros ↓clk · UC ↑clk · 40 MHz · buses [n]. Líneas azules discontinuas: control / reloj / reset. Nombres repetidos: misma red." vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fontSize=20;fontColor=#42526e;">
        <mxGeometry x="70" y="105" width="3280" height="90" as="geometry" />
      </mxCell>
      <mxCell id="inputs" parent="1" value="&lt;b&gt;ENTRADAS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;lp_req [1]&lt;br/&gt;hs_req [1]&lt;br/&gt;pll_locked [1]&lt;br/&gt;hs_data_ready [1]&lt;br/&gt;hs_error [1]" vertex="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#344563;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;">
