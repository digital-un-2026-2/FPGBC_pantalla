        <mxCell id="complete" parent="1" value="&lt;b&gt;FINALIZAR OPERACIÓN LP&lt;/b&gt;&lt;br/&gt;En ↑clk: liberar y guardar acción FIN_LP&lt;br/&gt;En ↓clk: lp_complete ← 1 por un ciclo" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;spacing=12;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#e8f4ed;strokeColor=#5c9476;">
