<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="lp-tx-flow" name="Flujo">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1240" pageHeight="1150" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="LP_TX — flujo de un paquete LPDT" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=33;fontStyle=1;fontColor=#20313F;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="20" width="1176" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Flancos acordados · ↑ posedge y ↓ negedge de CLK_BYTE · los pares se leen como {P,N}" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#344654;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="73" width="1176" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="idle" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;LP_D0[1:0] = 11; espera el inicio" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="255" y="124" width="442" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;↑ ¿LP_START = 1&lt;br&gt;e INIT_LAST = 0?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F5F0DD;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="337" y="217" width="278" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;ENTRY&lt;/b&gt;&lt;br&gt;Desde LP11: ↓ publica 10 → 00 → 01 → 00" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="255" y="342" width="442" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cmd" value="&lt;b&gt;CMD&lt;/b&gt;&lt;br&gt;↓ carga y emite 0x87 una vez, LSB primero&lt;br&gt;INIT_NEXT se mantiene en 0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="255" y="442" width="442" height="79" as="geometry"/>
        </mxCell>
        <mxCell id="load" value="&lt;b&gt;DATA — toma un byte&lt;/b&gt;&lt;br&gt;↓ carga INIT_BYTE[7:0] y publica su bit 0&lt;br&gt;INIT_NEXT = 1 después de la carga" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="255" y="551" width="442" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="finish-byte" value="&lt;b&gt;DATA — termina el byte capturado&lt;/b&gt;&lt;br&gt;↓ alterna marca y espacio hasta el 00 de b7" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="255" y="661" width="442" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="last" value="&lt;b&gt;¿INIT_LAST = 1?&lt;/b&gt;&lt;br&gt;↑ en frontera de byte" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F5F0DD;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="337" y="753" width="278" height="91" as="geometry"/>
        </mxCell>
        <mxCell id="exit" value="&lt;b&gt;EXIT&lt;/b&gt;&lt;br&gt;↓ publica 10 → 11; retiene LP11&lt;br&gt;LP_DONE = 1 tras el ↓ de resguardo" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="255" y="884" width="442" height="81" as="geometry"/>
        </mxCell>
        <mxCell id="handoff" value="&lt;b&gt;↑ LINK_FSM toma LP_DONE&lt;/b&gt;&lt;br&gt;LP_TX vuelve a IDLE; LINK_FSM puede&lt;br&gt;retirar la selección LPDT hacia reposo LP11" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="255" y="999" width="442" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="idle-start" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="idle" target="start"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="start-wait" value="No" style="edgeStyle=segmentEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;fontSize=17;fontColor=#674594;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#674594;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="start" target="idle">
          <mxGeometry x="-0.64" y="11" relative="1" as="geometry">
            <Array as="points"><mxPoint x="753" y="263"/><mxPoint x="753" y="155"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="start-entry" value="Sí" style="edgeStyle=segmentEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;fontSize=17;fontColor=#394E5D;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="entry">
          <mxGeometry x="0" y="20" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="entry-cmd" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry" target="cmd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cmd-load" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cmd" target="load"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="load-finish" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="load" target="finish-byte"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="finish-last" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="finish-byte" target="last"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="last-load" value="No" style="edgeStyle=segmentEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;fontSize=17;fontColor=#674594;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#674594;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="last" target="load">
          <mxGeometry x="-0.71" y="12" relative="1" as="geometry">
            <Array as="points"><mxPoint x="753" y="798.5"/><mxPoint x="753" y="592"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="last-exit" value="Sí · WAIT" style="edgeStyle=segmentEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;fontSize=17;fontColor=#394E5D;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="last" target="exit">
          <mxGeometry x="0" y="50" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="exit-handoff" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="exit" target="handoff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="handoff-idle" value="Próximo paquete" style="edgeStyle=segmentEdgeStyle;html=1;labelBackgroundColor=#FFFFFF;fontSize=17;fontColor=#674594;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#674594;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="handoff" target="idle">
          <mxGeometry x="0.05" y="0" relative="1" as="geometry">
            <Array as="points"><mxPoint x="156" y="1041.5"/><mxPoint x="156" y="155"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-reset" value="&lt;b&gt;Inicio y reset&lt;/b&gt;&lt;br&gt;LINK_FSM presenta LP_START con LPDT seleccionado; el primer BYTE ya está estable. RST_BYTE activo en 1 aborta el envío: IDLE en ↑ y LP11 en ↓, sin LP_DONE." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#20313F;fontSize=18;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="815" y="124" width="393" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="flow-symbols" value="&lt;b&gt;Dos fases por bit&lt;/b&gt;&lt;br&gt;1 → 10 → 00 · 0 → 01 → 00.&lt;br&gt;Cada fase dura LP_DIV ciclos de CLK_BYTE (valor por validar). No hay LP11 entre bytes ni filtro por valor: un 0x87 en DATA se transmite." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#20313F;fontSize=18;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="815" y="342" width="393" height="179" as="geometry"/>
        </mxCell>
        <mxCell id="flow-lookahead" value="&lt;b&gt;Siguiente entrada de ROM&lt;/b&gt;&lt;br&gt;El ↑ posterior a la carga toma INIT_NEXT y avanza una vez. INIT_LAST = 1 marca WAIT, no el byte cargado. Se consulta al acabar ese byte; nunca se carga el argumento de WAIT." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#20313F;fontSize=18;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="815" y="551" width="393" height="199" as="geometry"/>
        </mxCell>
        <mxCell id="flow-phy" value="&lt;b&gt;El cierre llega a PHY_IF&lt;/b&gt;&lt;br&gt;PHY_IF captura el LP_D0[1:0] previo a cada ↓. Mantener la selección LPDT hasta LP_DONE conserva el último 00, el 10 de salida y la captura de LP11. Las esperas de 7/9/65 ms quedan en INIT_SEQUENCER." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#20313F;fontSize=18;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="815" y="884" width="393" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
