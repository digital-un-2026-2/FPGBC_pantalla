        <mxCell id="use-mark-line" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeColor=#0B737E;strokeWidth=1.8;exitX=1;exitY=0.879717;exitPerimeter=0;entryX=0.389881;entryY=0;entryPerimeter=0;" edge="1" parent="lp-tx" source="step" target="enc">
