        <mxCell id="we-line" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeColor=#515C7F;strokeWidth=1.8;exitX=1;exitY=0.943396;exitPerimeter=0;entryX=0.110119;entryY=0;entryPerimeter=0;" edge="1" parent="lp-tx" source="step" target="enc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="841" y="470"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="shift-line" style="edgeStyle=segmentEdgeStyle;endArrow=block;endFill=1;strokeColor=#257A56;strokeWidth=1.8;jumpStyle=gap;jumpSize=11;exitX=0.139535;exitY=1;exitPerimeter=0;entryX=0.849112;entryY=0;entryPerimeter=0;" edge="1" parent="lp-tx" source="bits" target="shift-reg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="reg-note" value="&lt;div style=&quot;font-size:20px;margin-bottom:6px&quot;&gt;&lt;b&gt;Registros de CLK_BYTE · valores de reset y habilitación&lt;/b&gt;&lt;/div&gt;
          &lt;div style=&quot;line-height:1.45&quot;&gt;
          &lt;b&gt;STATE[2:0] ↑&lt;/b&gt;: IDLE en reset; conserva el estado salvo en las transiciones de STEP_SEQ.&lt;br&gt;
          &lt;b&gt;FIX_IDX[2:0] ↓&lt;/b&gt;: 0 en reset o IDLE; incrementa con FIX_STEP; si no, retiene.&lt;br&gt;
          &lt;b&gt;TAKEN (1 bit) ↓&lt;/b&gt;: 0 en reset; cada ↓ captura si LD_BYTE y STATE = DATA.&lt;br&gt;
          &lt;b&gt;P_CNT[W−1:0] ↓&lt;/b&gt;: 0 en reset o sin DIV_EN; con TICK carga D−1; si no, decrementa.&lt;br&gt;
          &lt;b&gt;BIT_IDX[2:0] y SPACE_NEXT (1 bit) ↓&lt;/b&gt;: 0 en reset. BIT_EN alterna fase; SHIFT incrementa mod 8.&lt;br&gt;
          &lt;b&gt;Q[7:0] ↓&lt;/b&gt;: 00 en reset; LD_BYTE carga; si no, SHIFT desplaza a la derecha; si no, retiene.&lt;br&gt;
          &lt;b&gt;LP_D0[1:0] ↓&lt;/b&gt;: 11 en reset; LP_WE carga el símbolo; si no, retiene.
          &lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;spacingTop=12;spacingLeft=15;spacingRight=15;fontColor=#20313F;fontSize=17;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="855" width="860" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="comb-note" value="&lt;div style=&quot;font-size:20px;margin-bottom:6px&quot;&gt;&lt;b&gt;Selección y codificación combinacionales&lt;/b&gt;&lt;/div&gt;
          &lt;div style=&quot;line-height:1.45&quot;&gt;
          &lt;b&gt;PHASE_DIV:&lt;/b&gt; D = LP_DIV ≥ 1 (por validar), W = máx(1, ⌈log₂ D⌉). TICK = (P_CNT = 0).&lt;br&gt;
          &lt;b&gt;BIT_CNT:&lt;/b&gt; MARK0 = !SPACE_NEXT &amp;amp;&amp;amp; (BIT_IDX = 0); SHIFT = BIT_EN &amp;amp;&amp;amp; SPACE_NEXT.&lt;br&gt;
          &lt;b&gt;BYTE_SEL:&lt;/b&gt; SEL_CMD = 1 selecciona 0x87; con 0, INIT_BYTE[7:0].&lt;br&gt;
          &lt;b&gt;SHIFT_REG:&lt;/b&gt; BIT = LD_BYTE ? BYTE[0] : Q[0]. La carga publica b0 en el mismo ↓.&lt;br&gt;
          &lt;b&gt;SYMBOL_ENC:&lt;/b&gt; USE_MARK elige {BIT,!BIT}; si está en 0, elige FIX_CODE[1:0].&lt;br&gt;
          &lt;b&gt;Reset:&lt;/b&gt; RST_BYTE = 1 es síncrono y prioritario; mantenerlo activo en ↑ y ↓.
          &lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;spacingTop=12;spacingLeft=15;spacingRight=15;fontColor=#20313F;fontSize=17;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="910" y="855" width="827" height="240" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lp-tx-fsm" name="FSM">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1540" pageHeight="870" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="LP_TX — FSM de STEP_SEQ" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=33;fontStyle=1;fontColor=#20313F;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="20" width="1474" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="STATE[2:0] se registra en ↑ CLK_BYTE. Las transiciones se deciden en el bloque secuencial, sin lógica NEXT_STATE aparte." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#344654;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="72" width="1474" height="29" as="geometry"/>
        </mxCell>
        <mxCell id="reset" value="&lt;b&gt;Desde cualquier estado:&lt;/b&gt; RST_BYTE = 1 en ↑ → IDLE (prioritario). Sin transición habilitada, el estado se conserva." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=0;spacingLeft=15;fontColor=#20313F;fontSize=17;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="114" width="1474" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="idle" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;Espera LP_START&lt;br&gt;LP_D0[1:0] = 11" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="32" y="202" width="220" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;ENTRY&lt;/b&gt;&lt;br&gt;11 → 10 → 00 → 01 → 00&lt;br&gt;FIX_IDX: 0 … 3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="345" y="202" width="225" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="cmd" value="&lt;b&gt;CMD&lt;/b&gt;&lt;br&gt;Emite un selector 0x87&lt;br&gt;Sin INIT_NEXT" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="650" y="202" width="216" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;DATA&lt;/b&gt;&lt;br&gt;Emite bytes LSB primero&lt;br&gt;Pulso INIT_NEXT al cargar" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="959" y="202" width="221" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="exit" value="&lt;b&gt;EXIT&lt;/b&gt;&lt;br&gt;10 → 11; retiene LP11&lt;br&gt;FIX_IDX: 4 … 6" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=2;fontColor=#20313F;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="1271" y="202" width="235" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="idle-entry" value="LP_START ∧ !INIT_LAST" style="edgeStyle=segmentEdgeStyle;html=1;fontSize=17;fontStyle=1;fontColor=#344654;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="idle" target="entry">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-75" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="entry-cmd" value="TICK ∧ (FIX_IDX = 4)" style="edgeStyle=segmentEdgeStyle;html=1;fontSize=17;fontStyle=1;fontColor=#344654;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="entry" target="cmd">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-75" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="cmd-data" value="TICK ∧ MARK0" style="edgeStyle=segmentEdgeStyle;html=1;fontSize=17;fontStyle=1;fontColor=#344654;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cmd" target="data">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-75" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="data-exit" value="TICK ∧ MARK0 ∧ INIT_LAST" style="edgeStyle=segmentEdgeStyle;html=1;fontSize=17;fontStyle=1;fontColor=#344654;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#394E5D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data" target="exit">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-75" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="exit-idle" value="FIX_IDX = 7 · LINK_FSM lee LP_DONE" style="edgeStyle=segmentEdgeStyle;html=1;fontSize=17;fontColor=#674594;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#674594;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="exit" target="idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1388.5" y="369"/><mxPoint x="142" y="369"/></Array>
            <mxPoint x="0" y="-16" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="decode" value="&lt;div style=&quot;font-size:21px;margin-bottom:9px&quot;&gt;&lt;b&gt;Controles combinacionales de STEP_SEQ&lt;/b&gt;&lt;/div&gt;
          &lt;table cellpadding=&quot;7&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;text-align:left&quot;&gt;
            &lt;tr style=&quot;background:#D8EAF0&quot;&gt;&lt;th&gt;STATE&lt;/th&gt;&lt;th&gt;DIV_EN&lt;/th&gt;&lt;th&gt;BIT_EN&lt;/th&gt;&lt;th&gt;FIX_STEP&lt;/th&gt;&lt;th&gt;FIX_CODE[1:0]&lt;/th&gt;&lt;/tr&gt;
            &lt;tr style=&quot;background:#FFFFFF&quot;&gt;&lt;td&gt;IDLE&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;00 (no se carga)&lt;/td&gt;&lt;/tr&gt;
            &lt;tr style=&quot;background:#EBEFF3&quot;&gt;&lt;td&gt;ENTRY&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;TICK ∧ (FIX_IDX &amp;lt; 4)&lt;/td&gt;&lt;td&gt;10, 00, 01, 00&lt;/td&gt;&lt;/tr&gt;
            &lt;tr style=&quot;background:#FFFFFF&quot;&gt;&lt;td&gt;CMD&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;TICK&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;00 (espacio)&lt;/td&gt;&lt;/tr&gt;
            &lt;tr style=&quot;background:#EBEFF3&quot;&gt;&lt;td&gt;DATA&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;TICK ∧ (!MARK0 ∨ !INIT_LAST)&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;00 (espacio)&lt;/td&gt;&lt;/tr&gt;
            &lt;tr style=&quot;background:#FFFFFF&quot;&gt;&lt;td&gt;EXIT&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;TICK ∧ (FIX_IDX &amp;lt; 7)&lt;/td&gt;&lt;td&gt;4: 10 · 5 y 6: 11&lt;/td&gt;&lt;/tr&gt;
          &lt;/table&gt;
          &lt;div style=&quot;margin-top:10px;line-height:1.43&quot;&gt;
          SEL_CMD = (STATE = CMD) · LD_BYTE = BIT_EN ∧ MARK0&lt;br&gt;
          USE_MARK = BIT_EN ∧ !SPACE_NEXT · LP_WE = BIT_EN ∨ FIX_STEP&lt;br&gt;
          INIT_NEXT = TAKEN · LP_DONE = (FIX_IDX = 7)&lt;br&gt;
          RST_BYTE fuerza controles y pulsos a 0. Asignaciones por defecto para evitar latches.
          &lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;spacingTop=13;spacingLeft=15;spacingRight=15;fontColor=#20313F;fontSize=17;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="405" width="920" height="407" as="geometry"/>
        </mxCell>
        <mxCell id="half-cycle" value="&lt;div style=&quot;font-size:21px;margin-bottom:9px&quot;&gt;&lt;b&gt;Caminos de medio ciclo&lt;/b&gt;&lt;/div&gt;
          &lt;div style=&quot;line-height:1.36&quot;&gt;
          &lt;b&gt;↓ → ↑:&lt;/b&gt; el datapath produce TICK y MARK0 para decidir en el ↑ anterior a la próxima fase. INIT_NEXT se ve durante un ciclo desde la carga; LP_DONE, desde el ↓ de resguardo hasta el primer ↓ en IDLE.&lt;br&gt;&lt;br&gt;
          &lt;b&gt;↑ → ↓:&lt;/b&gt; el nuevo STATE habilita la carga o la publicación del símbolo en ↓. INIT_BYTE[7:0] e INIT_LAST se mantienen estables desde antes del ↑ de frontera hasta la captura en ↓.&lt;br&gt;&lt;br&gt;
          &lt;b&gt;MARK0:&lt;/b&gt; CMD y DATA entran con TICK; el ↓ siguiente emite b0 y deja SPACE_NEXT = 1. MARK0 no vuelve hasta después del espacio de b7, así que INIT_LAST no corta un byte en curso.
          &lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;spacingTop=13;spacingLeft=15;spacingRight=15;fontColor=#20313F;fontSize=17;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="976" y="405" width="530" height="407" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
