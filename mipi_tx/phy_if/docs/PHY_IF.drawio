        <mxCell id="rst-hs" style="edgeStyle=segmentEdgeStyle;rounded=0;endArrow=block;endSize=9;endFill=1;strokeColor=#8F305B;strokeWidth=2;jumpStyle=gap;jumpSize=10;exitX=0.5;exitY=0.5;exitPerimeter=0;entryX=0.7508897;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="tap-rst" target="hs-reg">
