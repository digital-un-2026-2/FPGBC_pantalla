  <diagram id="link-fsm-fsm" name="FSM">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1760" pageHeight="910" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="LINK_FSM — estados y controles" style="text;html=1;align=left;spacing=0;fontSize=32;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="36" y="19" width="1688" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Transiciones en ↑ CLK_BYTE · Decodificación combinacional · Sin la condición del arco, se mantiene el estado" style="text;html=1;align=left;spacing=0;fontSize=17;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="37" y="71" width="1687" height="27" as="geometry"/></mxCell>
        <mxCell id="reset" value="&lt;b&gt;Desde cualquier estado&lt;/b&gt;&lt;br&gt;RST_BYTE=1 en ↑&lt;br&gt;También al recuperar un estado inválido" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;fontSize=15;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="38" y="157" width="203" height="88" as="geometry"/></mxCell>
        <mxCell id="lp-begin" value="&lt;b&gt;LP_BEGIN&lt;/b&gt;&lt;br&gt;SEL_OUT=01&lt;br&gt;LP_START=1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="324" y="158" width="235" height="83" as="geometry"/></mxCell>
        <mxCell id="lp-run" value="&lt;b&gt;LP_RUN&lt;/b&gt;&lt;br&gt;SEL_OUT=01&lt;br&gt;LP_START=0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="635" y="158" width="226" height="83" as="geometry"/></mxCell>
        <mxCell id="lp-ack" value="&lt;b&gt;LP_ACK&lt;/b&gt;&lt;br&gt;SEL_OUT=00&lt;br&gt;INIT_DONE_TX=1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="970" y="158" width="230" height="83" as="geometry"/></mxCell>
        <mxCell id="admit-note" value="&lt;b&gt;Arbitraje en LINE_WAIT&lt;/b&gt;&lt;br&gt;L: INIT_REQ ∧ INIT_READY (prioritario).&lt;br&gt;H: no L, VID_REQ ∧ VID_LINE_RDY ∧ READY ∧ LOCK. Si H y L fallan, sigue en LP11." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1325" y="146" width="398" height="117" as="geometry"/></mxCell>
        <mxCell id="line-wait" value="&lt;b&gt;LINE_WAIT&lt;/b&gt;&lt;br&gt;SEL_OUT=00&lt;br&gt;INIT_READY = READY ∧ LOCK" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="38" y="362" width="201" height="106" as="geometry"/></mxCell>
        <mxCell id="lp01" value="&lt;b&gt;LP01&lt;/b&gt;&lt;br&gt;SEL_OUT=10&lt;br&gt;LP_FORCE=01&lt;br&gt;N=T_LPX" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="282" y="362" width="135" height="106" as="geometry"/></mxCell>
        <mxCell id="lp00-prep" value="&lt;b&gt;LP00_PREP&lt;/b&gt;&lt;br&gt;SEL_OUT=10&lt;br&gt;LP_FORCE=00&lt;br&gt;N=T_PREP" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="466" y="362" width="159" height="106" as="geometry"/></mxCell>
        <mxCell id="lp00-zero" value="&lt;b&gt;LP00_ZERO&lt;/b&gt;&lt;br&gt;SEL_OUT=10&lt;br&gt;LP_FORCE=00&lt;br&gt;N=T_ZERO" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="674" y="362" width="160" height="106" as="geometry"/></mxCell>
        <mxCell id="sot" value="&lt;b&gt;SOT&lt;/b&gt;&lt;br&gt;SEL_OUT=11&lt;br&gt;SOT_EN=1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="883" y="362" width="131" height="106" as="geometry"/></mxCell>
        <mxCell id="data0" value="&lt;b&gt;DATA0&lt;/b&gt;&lt;br&gt;SEL_OUT=11&lt;br&gt;PK_START=1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1063" y="362" width="135" height="106" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;DATA&lt;/b&gt;&lt;br&gt;SEL_OUT=11&lt;br&gt;PK_START=0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1249" y="362" width="136" height="106" as="geometry"/></mxCell>
        <mxCell id="eot" value="&lt;b&gt;EOT&lt;/b&gt;&lt;br&gt;SEL_OUT=10; LP_FORCE=00&lt;br&gt;N=N_DRAIN + T_TRAIL" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1490" y="362" width="213" height="106" as="geometry"/></mxCell>
        <mxCell id="lp11" value="&lt;b&gt;LP11&lt;/b&gt;&lt;br&gt;SEL_OUT=00&lt;br&gt;N=T_GAP" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1490" y="546" width="213" height="94" as="geometry"/></mxCell>
        <mxCell id="clock-ribbon" value="CLK_REQ=1 desde LP01 hasta EOT · propuesta para el reloj reenviado" style="rounded=0;html=1;fillColor=#DBEFF0;strokeColor=#0B6872;strokeWidth=1.5;fontSize=16;fontColor=#0B6872;" vertex="1" connectable="0" parent="1"><mxGeometry x="282" y="316" width="1421" height="27" as="geometry"/></mxCell>
        <mxCell id="hs-ribbon" value="HS_REQ=1 desde LP00_ZERO hasta DATA · propuesta de petición de modo" style="rounded=0;html=1;fillColor=#F8EDE5;strokeColor=#9D431E;strokeWidth=1.5;fontSize=16;fontColor=#9D431E;" vertex="1" connectable="0" parent="1"><mxGeometry x="674" y="488" width="711" height="27" as="geometry"/></mxCell>
        <mxCell id="notes-defaults" value="&lt;b&gt;Salidas por defecto&lt;/b&gt;&lt;br&gt;&lt;br&gt;SEL_OUT=00, LP_FORCE=11. Los demás controles en 0, salvo lo indicado. RST_BYTE=1 los enmascara al valor seguro; no hay fin espurio.&lt;br&gt;&lt;br&gt;00 reposo · 01 LPDT · 10 LP forzado · 11 HS." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="38" y="694" width="507" height="166" as="geometry"/></mxCell>
        <mxCell id="notes-timer" value="&lt;b&gt;Arcos temporizados&lt;/b&gt;&lt;br&gt;&lt;br&gt;D = TIMER_DONE leído en ↑. Al entrar a un estado con N, LOAD_T carga N−1 en el primer ↓. Se reutiliza el mismo CNT.&lt;br&gt;&lt;br&gt;SOT y DATA0 duran un ciclo cada uno, sin TIMER. PHY_IF captura B8/B8 y W0 en ↓ consecutivos." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="570" y="694" width="531" height="166" as="geometry"/></mxCell>
        <mxCell id="notes-pending" value="&lt;b&gt;Cierre propuesto, por validar con el PHY&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK_DONE tras ↓1082 dice que se capturó el CRC. En ↑1082 se quita la selección HS; no se apagan los drivers ahí.&lt;br&gt;&lt;br&gt;El PHY toma el CRC en ↓1083 y empieza trail en ↓1084 sin consumir otro byte. El retorno a LP11 respeta el cierre." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#B68F5D;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1126" y="694" width="597" height="166" as="geometry"/></mxCell>
        <mxCell id="s-reset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.3;exitY=1;entryX=0.303;entryY=0;strokeColor=#526778;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="reset" target="line-wait" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-lp-admit" value="L · paquete LP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.74;exitY=0;entryX=0.5;entryY=1;strokeColor=#3B505C;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=15;" edge="1" source="line-wait" target="lp-begin" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="187" y="286"/><mxPoint x="441.5" y="286"/></Array></mxGeometry></mxCell>
        <mxCell id="s-lp-launch" value="1 ↑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="lp-begin" target="lp-run" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-lp-done" value="LP_DONE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="lp-run" target="lp-ack" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-lp-return" value="1 ↑ · el secuenciador toma INIT_DONE_TX" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.35;strokeColor=#674594;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="lp-ack" target="line-wait" parent="1"><mxGeometry x="-0.60" relative="1" as="geometry"><Array as="points"><mxPoint x="1085" y="126"/><mxPoint x="18" y="126"/><mxPoint x="18" y="399.1"/></Array></mxGeometry></mxCell>
        <mxCell id="s-hs-admit" value="H" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="line-wait" target="lp01" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
