<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="link-fsm-flujo" name="Flujo">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1510" pageHeight="1460" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="LINK_FSM + TIMER — flujo de MIPI_TX" style="text;html=1;align=left;spacing=0;fontSize=32;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="38" y="19" width="1426" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Diseño para revisión · Un paquete LPDT o una línea HS a la vez · Las decisiones se toman en ↑ de CLK_BYTE" style="text;html=1;align=left;spacing=0;fontSize=17;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="39" y="71" width="1425" height="26" as="geometry"/></mxCell>
        <mxCell id="init-title" value="Inicialización LPDT" style="text;html=1;align=left;spacing=0;fontSize=23;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="106" y="272" width="348" height="32" as="geometry"/></mxCell>
        <mxCell id="reset" value="&lt;b&gt;RST_BYTE = 1&lt;/b&gt;&lt;br&gt;SEL_OUT=00; arranques y fin en 0&lt;br&gt;STATE → LINE_WAIT en ↑; CNT → 0 en ↓" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="116" width="390" height="72" as="geometry"/></mxCell>
        <mxCell id="wait" value="&lt;b&gt;LINE_WAIT&lt;/b&gt;&lt;br&gt;SEL_OUT=00; INIT_READY=READY ∧ LOCK" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=17;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="226" width="390" height="59" as="geometry"/></mxCell>
        <mxCell id="init-req" value="&lt;b&gt;¿INIT_REQ e INIT_READY?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=15;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="612" y="320" width="296" height="76" as="geometry"/></mxCell>
        <mxCell id="lp-begin" value="&lt;b&gt;LP_BEGIN&lt;/b&gt;&lt;br&gt;SEL_OUT=01; LP_START=1; INIT_READY=0&lt;br&gt;LP_TX lo lee en el ↑ siguiente" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="106" y="324" width="348" height="68" as="geometry"/></mxCell>
        <mxCell id="lp-run" value="&lt;b&gt;LP_RUN&lt;/b&gt;&lt;br&gt;LP_START=0; mantiene SEL_OUT=01&lt;br&gt;PHY_IF captura LP_D0 un ↓ después" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="106" y="438" width="348" height="68" as="geometry"/></mxCell>
        <mxCell id="lp-done" value="&lt;b&gt;¿LP_DONE = 1?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=15;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="158" y="544" width="244" height="70" as="geometry"/></mxCell>
        <mxCell id="lp-ack" value="&lt;b&gt;LP_ACK&lt;/b&gt;&lt;br&gt;SEL_OUT=00; INIT_DONE_TX=1&lt;br&gt;El secuenciador lo lee en el ↑ siguiente" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="106" y="660" width="348" height="68" as="geometry"/></mxCell>
        <mxCell id="hs-admit" value="&lt;b&gt;¿VID_REQ y&lt;br&gt;VID_LINE_RDY y&lt;br&gt;READY y LOCK?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=15;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="577" y="425" width="366" height="100" as="geometry"/></mxCell>
        <mxCell id="lp01" value="&lt;b&gt;LP01&lt;/b&gt;&lt;br&gt;SEL_OUT=10; LP_FORCE=01; CLK_REQ=1*&lt;br&gt;Cargar T_LPX" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="570" width="390" height="68" as="geometry"/></mxCell>
        <mxCell id="lp00" value="&lt;b&gt;LP00 · PREP → ZERO&lt;/b&gt;&lt;br&gt;SEL_OUT=10; LP_FORCE=00&lt;br&gt;Cargar T_PREP, luego T_ZERO&lt;br&gt;HS_REQ sube al entrar a ZERO*" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="678" width="390" height="89" as="geometry"/></mxCell>
        <mxCell id="sot" value="&lt;b&gt;SoT&lt;/b&gt;&lt;br&gt;SEL_OUT=11; SOT_EN=1; PK_START=0&lt;br&gt;PHY_IF captura B8 / B8 en ↓−1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="806" width="390" height="66" as="geometry"/></mxCell>
        <mxCell id="data0" value="&lt;b&gt;DATA0&lt;/b&gt;&lt;br&gt;SEL_OUT=11; SOT_EN=0; PK_START=1&lt;br&gt;PHY_IF captura W0 en ↓0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="908" width="390" height="67" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;DATA&lt;/b&gt;&lt;br&gt;SEL_OUT=11; PK_START=0&lt;br&gt;W1…W1082, CRC capturado en ↓1082" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="1008" width="390" height="67" as="geometry"/></mxCell>
        <mxCell id="pk-done" value="&lt;b&gt;¿PK_DONE = 1?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=15;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="612" y="1110" width="296" height="68" as="geometry"/></mxCell>
        <mxCell id="eot" value="&lt;b&gt;EoT*&lt;/b&gt;&lt;br&gt;SEL_OUT=10; LP_FORCE=00; HS_REQ=0&lt;br&gt;Cargar N_EOT = N_DRAIN + T_TRAIL" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="1210" width="390" height="75" as="geometry"/></mxCell>
        <mxCell id="lp11" value="&lt;b&gt;LP11&lt;/b&gt;&lt;br&gt;SEL_OUT=00; CLK_REQ=0*&lt;br&gt;Cargar T_GAP: solo el resto del período" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="565" y="1323" width="390" height="69" as="geometry"/></mxCell>
        <mxCell id="lp-note" value="&lt;b&gt;Por paquete, no por byte&lt;/b&gt;&lt;br&gt;&lt;br&gt;INIT_READY anuncia disponibilidad. INIT_DONE_TX pulsa tras el cierre.&lt;br&gt;&lt;br&gt;INIT_NEXT va de LP_TX a INIT_SEQUENCER sin pasar por LINK_FSM. El secuenciador gobierna los WAIT de 7/9/65 ms." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="106" y="840" width="348" height="218" as="geometry"/></mxCell>
        <mxCell id="admission-note" value="&lt;b&gt;Arbitraje en reposo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si coinciden LP y HS, se acepta LP. No se guarda una petición rechazada.&lt;br&gt;&lt;br&gt;Propuesta: READY y LOCK ya son válidos en CLK_BYTE antes de aceptar. No se usan para pausar una ráfaga." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1075" y="226" width="390" height="193" as="geometry"/></mxCell>
        <mxCell id="select-note" value="&lt;b&gt;SEL_OUT[1:0] → PHY_IF&lt;/b&gt;&lt;br&gt;&lt;br&gt;00: reposo (LP11) · 01: LPDT en D0&lt;br&gt;10: LP_FORCE en D0 y D1 · 11: HS&lt;br&gt;&lt;br&gt;LP_FORCE[1:0] en orden {P,N}. La selección es lógica; no habilita los drivers." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1075" y="468" width="390" height="180" as="geometry"/></mxCell>
        <mxCell id="phy-note" value="&lt;b&gt;* Por acordar con el PHY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Propuesta: CLK_REQ desde LP01 hasta EoT. El reloj reenviado debe preceder al SoT y sostenerse durante el cierre.&lt;br&gt;&lt;br&gt;PK_DONE confirma captura, no salida del último bit. Quitar la selección HS en ↑1082; el PHY consumiría el CRC en ↓1083 y empezaría trail en ↓1084. No se carga otro byte ni se añaden puertos.&lt;br&gt;&lt;br&gt;Pendientes: READY, flanco real de consumo, reloj y límites físicos de zero / trail / salida." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F8F2E2;strokeColor=#B68F5D;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1075" y="760" width="390" height="292" as="geometry"/></mxCell>
        <mxCell id="tables-note" value="&lt;b&gt;Tablas de flancos LP y HS&lt;/b&gt;&lt;br&gt;Ver mipi_tx/link_fsm/README.md.&lt;br&gt;↑n está entre ↓n y ↓(n+1)." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=14;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="1075" y="1083" width="390" height="102" as="geometry"/></mxCell>
        <mxCell id="f-reset" value="Liberar reset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="reset" target="wait" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-arb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;" edge="1" source="wait" target="init-req" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-init-yes" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="init-req" target="lp-begin" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-init-no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="init-req" target="hs-admit" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-lp-launch" value="Siguiente ↑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="lp-begin" target="lp-run" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-lp-check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;" edge="1" source="lp-run" target="lp-done" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-lp-no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#526778;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="lp-done" target="lp-run" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="81" y="579"/><mxPoint x="81" y="472"/></Array></mxGeometry></mxCell>
        <mxCell id="f-lp-yes" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="lp-done" target="lp-ack" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-lp-return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.18;entryY=0;strokeColor=#674594;endArrow=block;endFill=1;" edge="1" source="lp-ack" target="wait" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="772"/><mxPoint x="43" y="772"/><mxPoint x="43" y="208"/><mxPoint x="635" y="208"/></Array></mxGeometry></mxCell>
        <mxCell id="f-hs-no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#526778;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="hs-admit" target="wait" parent="1"><mxGeometry x="-0.7" relative="1" as="geometry"><Array as="points"><mxPoint x="1007" y="475"/><mxPoint x="1007" y="255.5"/></Array></mxGeometry></mxCell>
        <mxCell id="f-hs-yes" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="hs-admit" target="lp01" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-lpx" value="Fin de T_LPX" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="lp01" target="lp00" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-zero" value="Fin de T_ZERO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="lp00" target="sot" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-hs-launch" value="↑−1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="sot" target="data0" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-hs-stream" value="↑0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="data0" target="data" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-hs-check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;" edge="1" source="data" target="pk-done" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-pk-no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#526778;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=14;" edge="1" source="pk-done" target="data" parent="1"><mxGeometry x="-0.66" relative="1" as="geometry"><Array as="points"><mxPoint x="1007" y="1144"/><mxPoint x="1007" y="1041.5"/></Array></mxGeometry></mxCell>
        <mxCell id="f-pk-yes" value="Sí · ↑1082" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="pk-done" target="eot" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-trail" value="Fin de N_EOT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B505C;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="eot" target="lp11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-line-return" value="Fin de T_GAP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.82;entryY=0;strokeColor=#674594;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=13;" edge="1" source="lp11" target="wait" parent="1"><mxGeometry x="-0.87" relative="1" as="geometry"><Array as="points"><mxPoint x="1036" y="1357.5"/><mxPoint x="1036" y="208"/><mxPoint x="885" y="208"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="link-fsm-datapath" name="Datapath">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1760" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="LINK_FSM + TIMER — conexiones y flancos" style="text;html=1;align=left;spacing=0;fontSize=32;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="36" y="19" width="1688" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Dentro de MIPI_TX · Los puertos de cada vecino se muestran por dirección · Trazo fino: 1 bit · Trazo grueso: bus" style="text;html=1;align=left;spacing=0;fontSize=17;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="37" y="71" width="1687" height="27" as="geometry"/></mxCell>
        <mxCell id="in-title" value="VECINOS · EMISORES" style="text;html=1;align=left;spacing=0;fontSize=16;fontStyle=1;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="36" y="168" width="220" height="28" as="geometry"/></mxCell>
        <mxCell id="out-title" value="VECINOS · RECEPTORES" style="text;html=1;align=left;spacing=0;fontSize=16;fontStyle=1;fontColor=#344654;" vertex="1" parent="1"><mxGeometry x="1490" y="168" width="234" height="28" as="geometry"/></mxCell>
        <mxCell id="module" value="LINK_FSM + TIMER" style="rounded=0;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#D8EAF0;strokeColor=#3B505C;strokeWidth=2;align=left;verticalAlign=top;spacing=0;spacingLeft=18;spacingTop=11;fontSize=24;fontStyle=1;fontColor=#20313F;" vertex="1" connectable="0" parent="1"><mxGeometry x="300" y="146" width="1140" height="698" as="geometry"/></mxCell>
        <mxCell id="fsm" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#3B505C;strokeWidth=1.5;" vertex="1" parent="module"><mxGeometry x="64" y="76" width="360" height="394" as="geometry"/></mxCell>
        <mxCell id="fsm-caption" value="&lt;b style=&quot;font-size:21px&quot;&gt;STATE_REG&lt;/b&gt;&lt;br&gt;Transiciones en ↑ CLK_BYTE&lt;br&gt;5 bits, sin habilitación global&lt;br&gt;Reset a LINE_WAIT y 0" style="text;html=1;align=center;verticalAlign=top;spacing=0;fontSize=15;fontColor=#20313F;" vertex="1" connectable="0" parent="fsm"><mxGeometry x="144" y="50" width="205" height="100" as="geometry"/></mxCell>
        <mxCell id="decode" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#3B505C;strokeWidth=1.5;" vertex="1" parent="module"><mxGeometry x="538" y="67" width="554" height="401" as="geometry"/></mxCell>
        <mxCell id="dec-caption" value="&lt;b style=&quot;font-size:21px&quot;&gt;OUTPUT_DECODE + T_MUX&lt;/b&gt;&lt;br&gt;Combinacional · selección de N por estado&lt;br&gt;LOAD_T desde ENTER_T" style="text;html=1;align=center;verticalAlign=top;spacing=0;fontSize=15;fontColor=#20313F;" vertex="1" connectable="0" parent="decode"><mxGeometry x="29" y="36" width="338" height="72" as="geometry"/></mxCell>
        <mxCell id="timer" value="TIMER · un contador y un comparador" style="rounded=0;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F4F8FA;strokeColor=#9CAEBB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;spacingLeft=227;spacingTop=8;fontSize=19;fontStyle=1;fontColor=#20313F;" vertex="1" connectable="0" parent="module"><mxGeometry x="88" y="518" width="1002" height="170" as="geometry"/></mxCell>
        <mxCell id="compare" value="&lt;b style=&quot;font-size:19px&quot;&gt;COMPARE&lt;/b&gt;&lt;br&gt;CNT = 0 · combinacional" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B505C;strokeWidth=1.5;align=center;verticalAlign=bottom;spacingBottom=11;fontSize=16;fontColor=#20313F;" vertex="1" parent="timer"><mxGeometry x="40" y="45" width="237" height="112" as="geometry"/></mxCell>
        <mxCell id="counter" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#3B505C;strokeWidth=1.5;" vertex="1" parent="timer"><mxGeometry x="385" y="45" width="547" height="112" as="geometry"/></mxCell>
        <mxCell id="cnt-caption" value="&lt;b style=&quot;font-size:19px&quot;&gt;CNT · ↓ CLK_BYTE&lt;/b&gt;&lt;br&gt;W bits · prioridad: reset a 0, carga N−1,&lt;br&gt;decremento hasta 0, mantiene" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#20313F;" vertex="1" connectable="0" parent="counter"><mxGeometry x="143" y="26" width="376" height="62" as="geometry"/></mxCell>
        <mxCell id="in-init" value="INIT_SEQUENCER" style="rounded=0;html=1;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=3;spacingLeft=9;fontSize=16;fontStyle=1;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="36" y="227" width="220" height="55" as="geometry"/></mxCell>
