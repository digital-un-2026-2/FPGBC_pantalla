        <mxCell id="clk-timer-label" value="CLK_BYTE" style="text;html=1;align=center;spacing=0;fontSize=17;fontColor=#526476;" vertex="1" connectable="0" parent="1"><mxGeometry x="855" y="879" width="92" height="22" as="geometry"/></mxCell>
        <mxCell id="rst-timer-label" value="RST_BYTE" style="text;html=1;align=center;spacing=0;fontSize=17;fontColor=#8F305B;" vertex="1" connectable="0" parent="1"><mxGeometry x="1127.5" y="879" width="92" height="22" as="geometry"/></mxCell>
        <mxCell id="clk-timer" style="ellipse;aspect=fixed;fillColor=#FFFFFF;strokeColor=#526476;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="896" y="865" width="10" height="10" as="geometry"/></mxCell>
        <mxCell id="rst-timer" style="ellipse;aspect=fixed;fillColor=#FFFFFF;strokeColor=#8F305B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1168.5" y="865" width="10" height="10" as="geometry"/></mxCell>
        <mxCell id="routing-note" value="&lt;b&gt;Límites del módulo&lt;/b&gt;&lt;br&gt;&lt;br&gt;INIT_NEXT: LP_TX → INIT_SEQUENCER, fuera de LINK_FSM.&lt;br&gt;&lt;br&gt;CLK_BYTE y RST_BYTE son redes comunes. El reset activo en 1 cubre ↑ y ↓." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=12;fontSize=15;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="36" y="650" width="220" height="188" as="geometry"/></mxCell>
        <mxCell id="count-note" value="&lt;b&gt;Un ↓ de carga por fase&lt;/b&gt;&lt;br&gt;&lt;br&gt;Al entrar en ↑: ENTER_T=1. El primer ↓ carga CNT=N−1. CNT_EN habilita el decremento hasta 0; TIMER_DONE se lee en ↑.&lt;br&gt;&lt;br&gt;Para N=1: el primer ↓ carga 0; el próximo ↑ avanza. La fase dura exactamente un ciclo de CLK_BYTE." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="36" y="922" width="816" height="143" as="geometry"/></mxCell>
        <mxCell id="time-note" value="&lt;b&gt;Un MUX de límites · W representa el mayor N&lt;/b&gt;&lt;br&gt;&lt;br&gt;LP01: T_LPX · LP00: T_PREP y T_ZERO en dos cargas · EOT: N_DRAIN + T_TRAIL · LP11: T_GAP.&lt;br&gt;&lt;br&gt;T_GAP = C_LINE − (T_LPX + T_PREP + T_ZERO + 1 + 1083 + N_EOT) − 1 ≥ 1. El último −1 reserva el ciclo de arbitraje en LINE_WAIT. Límites físicos por acordar." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F8FA;strokeColor=#9CAEBB;align=left;verticalAlign=top;spacing=13;fontSize=16;fontColor=#20313F;" vertex="1" parent="1"><mxGeometry x="875" y="922" width="849" height="143" as="geometry"/></mxCell>
        <mxCell id="e-init-req" style="noEdgeStyle=1;html=1;strokeColor=#B15316;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0.6545;entryX=0;entryY=0.1041;" edge="1" parent="1" source="in-init" target="fsm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-vid-req" style="noEdgeStyle=1;html=1;strokeColor=#654EA3;strokeWidth=1.6;endArrow=block;endFill=1;exitX=1;exitY=0.6545;entryX=0;entryY=0.2614;" edge="1" parent="1" source="in-vid-timing" target="fsm"><mxGeometry relative="1" as="geometry"/></mxCell>
