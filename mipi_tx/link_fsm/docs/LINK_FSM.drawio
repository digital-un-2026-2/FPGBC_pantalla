        <mxCell id="dec-note" value="&lt;b&gt;Valor por defecto / reset&lt;/b&gt;&lt;br&gt;SEL_OUT=00; LP_FORCE=11.&lt;br&gt;Demás controles en 0.&lt;br&gt;&lt;br&gt;INIT_READY solo en LINE_WAIT&lt;br&gt;si READY ∧ LOCK." style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#344654;" vertex="1" connectable="0" parent="decode"><mxGeometry x="131" y="125" width="236" height="132" as="geometry"/></mxCell>
