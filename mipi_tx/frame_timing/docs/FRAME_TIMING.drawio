        <mxCell id="consumer-label" value="BURST_KIND[1:0]" style="text;html=1;align=left;fontSize=15;fontColor=#137987;" vertex="1" parent="1"><mxGeometry x="1360" y="550" width="170" height="25" as="geometry"/></mxCell>
