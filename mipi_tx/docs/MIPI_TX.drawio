        <mxCell id="wire-hs1" style="edgeStyle=segmentEdgeStyle;rounded=0;endArrow=block;endSize=7;endFill=1;strokeColor=#2E4F80;strokeWidth=3.2;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="adapter-hs1" target="phy-hs1">
