        <mxCell id="lp-notes" value="&lt;b style=&quot;font-size:18px&quot;&gt;LP — captura y espera&lt;/b&gt;&lt;br&gt;&lt;br&gt;D0: LP11 → 10 → 00 → 01 → 00; selector 87, bytes DSI LSB primero, cierre 10 → 11.&lt;br&gt;PHY_IF captura LP_D0 un ↓ después. D1 y CLK quedan en LP11 durante LPDT.&lt;br&gt;INIT_NEXT confirma solo BYTE. INIT_DONE_TX habilita el WAIT, que no se transmite.&lt;br&gt;Solo tras el WAIT final de 7 ms y END, INIT_DONE habilita VIDEO_SOURCE." style="rounded=0;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=16;fillColor=#F0F5F8;strokeColor=#A9BBC7;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="907" width="816" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="hs-notes" value="&lt;b style=&quot;font-size:18px&quot;&gt;HS — captura y consumo (contrato de simulación)&lt;/b&gt;&lt;br&gt;&lt;br&gt;z: ↓ que detecta el ascenso de HS_REQ. El PHY empieza a consumir en z + T_ZERO + 1.&lt;br&gt;↓−1 registra B8/B8; ↓0 registra W0 (3E/70) con PK_START y el PHY consume el SoT previo.&lt;br&gt;↓1082 registra CRC; ↓1083 detecta HS_REQ=0 y consume ese CRC, sin otra palabra.&lt;br&gt;1 SoT + 1083 palabras (D0 bajo, D1 alto). El reset aborta antes de consumir." style="rounded=0;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=16;fillColor=#F0F5F8;strokeColor=#A9BBC7;strokeWidth=1.5;fontSize=16;fontColor=#20313F;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="872" y="907" width="816" height="144" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
