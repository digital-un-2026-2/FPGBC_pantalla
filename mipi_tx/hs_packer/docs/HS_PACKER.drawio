        <mxCell id="packet-title" value="Paquete de línea · 1 palabra por ciclo" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontColor=#20313F;fontSize=19;fontStyle=1;" vertex="1" connectable="0" parent="1">
