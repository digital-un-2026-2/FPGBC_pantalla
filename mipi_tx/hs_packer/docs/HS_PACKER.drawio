        <mxCell id="w0" value="&lt;b style=&quot;font-size:18px&quot;&gt;W0&lt;/b&gt;&lt;br&gt;D0/D1: 3E / 70&lt;br&gt;WORD = 0x703E" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;fontColor=#20313F;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="32" y="863" width="269" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="w1" value="&lt;b style=&quot;font-size:18px&quot;&gt;W1&lt;/b&gt;&lt;br&gt;D0/D1: 08 / 13&lt;br&gt;WORD = 0x1308" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBEFF3;strokeColor=#3B505C;strokeWidth=1.5;fontColor=#20313F;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="311" y="863" width="269" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="pixels" value="&lt;b style=&quot;font-size:18px&quot;&gt;W2 … W1081&lt;/b&gt;&lt;br&gt;1080 palabras · 2160 bytes de píxeles&lt;br&gt;WORD = VID_WORD · solo aquí VID_RD = CRC_EN = 1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E5F0E2;strokeColor=#3B505C;strokeWidth=1.5;fontColor=#20313F;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="590" y="863" width="681" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="w1082" value="&lt;b style=&quot;font-size:18px&quot;&gt;W1082&lt;/b&gt;&lt;br&gt;D0/D1: CRC_L / CRC_H&lt;br&gt;WORD = CRC final" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F6EADC;strokeColor=#3B505C;strokeWidth=1.5;fontColor=#20313F;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1281" y="863" width="385" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="timing-note" value="&lt;b&gt;Decodificación:&lt;/b&gt; CNT 0–1 selecciona HDR; 2–1081, PIX (VID_RD = CRC_EN = 1); 1082, CRC. CNT = 1083 activa PK_DONE, sin transferir una palabra.&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; CRC_CLR = PK_START ∧ (CNT = 0). CNT_EN = CRC_CLR ∨ (1 ≤ CNT ≤ 1083). RST_BYTE es síncrono, activo en 1, y devuelve CNT a 0.&lt;br&gt;&lt;b&gt;CRC16:&lt;/b&gt; RST_BYTE o CRC_CLR carga 0xFFFF. Con CRC_EN, se incorpora D0 y luego D1 (LSB primero en cada byte). Salida sin XOR final.&lt;br&gt;&lt;b&gt;Flancos propuestos:&lt;/b&gt; LINK_FSM actúa en ↑ y PHY_IF captura en ↓. W0 se captura en el ↓ que acepta PK_START. VID_WORD está estable antes de cada ↓ con VID_RD = 1; VIDEO_SOURCE avanza en ese ↓.&lt;br&gt;Tras capturar W1082 en ↓ se activa PK_DONE. LINK_FSM lo lee en el ↑ intermedio; en el siguiente ↓, CNT vuelve a 0 y PK_DONE baja." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2F7FA;strokeColor=#A9B8C1;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontColor=#344654;fontSize=15;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="32" y="967" width="1634" height="119" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
