        <mxCell id="fsm-title" parent="1" style="text;html=1;align=left;fontSize=32;" value="DPHY LPDT TX · lpdt_control.v" vertex="1">
          <mxGeometry height="60" width="3400" x="80" y="30" as="geometry" />
        </mxCell>
        <mxCell id="fsm-key" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;" value="↑clk: state, enviando_selector, salida_pendiente, reinicio, inicio, avance_fase, ultimo_bit, ultimo_byte, selector_previo, fin_transaccion&lt;br&gt;always @(*): ld_len, sel_87, ld_byte, rst_byte, inc_byte, rst_bit, inc_bit, ld_t, inc_t, sel_fijo, lp_fijo, ld_lp, aceptado, ocupado, terminado&lt;br&gt;rst = 1: state &amp;lt;= IDLE; reinicio &amp;lt;= 1; demás flags &amp;lt;= 0" vertex="1">
          <mxGeometry height="100" width="3400" x="80" y="100" as="geometry" />
