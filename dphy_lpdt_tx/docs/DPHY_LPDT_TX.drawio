  <diagram id="lpdt-control" name="CONTROL">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="3600" pageHeight="3500" math="0" shadow="0">
