        <mxCell id="reset" parent="1" value="&lt;b&gt;RESET INTERNO&lt;/b&gt;&lt;br/&gt;Bloquear aceptación de bytes y publicación&lt;br/&gt;Descartar grupo parcial o pendiente&lt;br/&gt;Limpiar datos y marcas; no generar éxito" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
