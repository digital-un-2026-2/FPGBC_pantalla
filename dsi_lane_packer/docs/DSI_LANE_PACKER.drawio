        </mxCell>
        <mxCell id="uc-in" parent="1" value="&lt;b&gt;HACIA UC&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;tx_byte_valid [1]&lt;br/&gt;tx_byte_last [1]&lt;br/&gt;tx_word_ready [1]&lt;br/&gt;clk, rst [1 cada una]" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;rounded=0;fillColor=none;strokeColor=#344563;strokeWidth=2;spacing=18;align=left;">
          <mxGeometry x="70" y="1660" width="370" height="230" as="geometry" />
        </mxCell>
        <mxCell id="uc" parent="1" value="&lt;b&gt;UNIDAD DE CONTROL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Recuerda la fase de agrupación.&lt;br/&gt;Decide cuándo aceptar y publicar.&lt;br/&gt;La memoria de fase no pertenece&lt;br/&gt;a los 18 bits del datapath." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;rounded=0;fillColor=none;strokeColor=#344563;strokeWidth=2;align=center;">
          <mxGeometry x="640" y="1660" width="530" height="230" as="geometry" />
        </mxCell>
        <mxCell id="uc-out" parent="1" value="&lt;b&gt;DESDE UC&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;LD_FIRST, LD_SECOND, RST_DP [1 cada una]&lt;br/&gt;tx_byte_ready [1]&lt;br/&gt;tx_word_valid [1]&lt;br/&gt;&lt;br/&gt;LD_FIRST y LD_SECOND son excluyentes." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;rounded=0;fillColor=none;strokeColor=#344563;strokeWidth=2;spacing=18;align=left;">
          <mxGeometry x="1370" y="1660" width="730" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ucin" parent="1" source="uc-in" target="uc" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=18;strokeColor=#344563;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ucout" parent="1" source="uc" target="uc-out" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=18;strokeColor=#344563;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" value="&lt;b&gt;MEMORIA:&lt;/b&gt; WORD [16] + SECOND_VALID [1] + LAST [1] = 18 bits de datapath.&lt;br/&gt;Líneas discontinuas: controles. Nombres repetidos identifican la misma red; no son memorias adicionales.&lt;br/&gt;Sin carga se conserva Q. Los metadatos solo son significativos con tx_word_valid = 1." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;">
          <mxGeometry x="70" y="1940" width="2050" height="110" as="geometry" />
        </mxCell>
      </root>
