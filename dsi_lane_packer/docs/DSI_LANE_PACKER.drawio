  <diagram id="lane-datapath" name="DATAPATH">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b&gt;DSI_LANE_PACKER · DATAPATH&lt;/b&gt;" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=32;">
