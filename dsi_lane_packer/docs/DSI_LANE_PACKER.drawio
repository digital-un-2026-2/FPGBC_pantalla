        <mxCell id="events" parent="1" value="&lt;b&gt;EVENTOS Y CONTROLES DERIVADOS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;BYTE_FIRE = tx_byte_valid &amp;amp; tx_byte_ready&lt;br/&gt;WORD_FIRE = tx_word_valid &amp;amp; tx_word_ready&lt;br/&gt;LD_META = LD_FIRST | LD_SECOND&lt;br/&gt;LD_LO = LD_FIRST · LD_HI = LD_META&lt;br/&gt;SEL_M0 = LD_SECOND&lt;br/&gt;&lt;br/&gt;Cargas combinacionales antes del ↑clk de aceptación.&lt;br/&gt;Sin registro ACTION ni evento retrasado." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=1.5;rounded=0;align=left;verticalAlign=top;spacing=22;">
          <mxGeometry x="70" y="1480" width="1080" height="360" as="geometry" />
        </mxCell>
        <mxCell id="reset" parent="1" value="&lt;b&gt;PRIORIDADES GLOBALES · SOBRE EL RECORRIDO NORMAL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;1. rst = 1: en ↑clk → EMPTY y datapath a cero.&lt;br/&gt;   Handshakes y cargas bloqueados mientras rst = 1.&lt;br/&gt;&lt;br/&gt;2. STATE = 11: handshakes / cargas = 0.&lt;br/&gt;   En ↑clk → EMPTY y datapath a cero; sin éxito.&lt;br/&gt;&lt;br/&gt;RST_DP = rst | (STATE == 2'b11)&lt;br/&gt;RST_DP es el reset síncrono de los 18 bits de datapath." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=1.5;rounded=0;align=left;verticalAlign=top;spacing=22;">
          <mxGeometry x="1210" y="1480" width="1420" height="360" as="geometry" />
        </mxCell>
        <mxCell id="actions" parent="1" value="&lt;b&gt;EFECTO DE CADA ACEPTACIÓN EN EL DATAPATH&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;LD_FIRST: WORD ← {00, tx_byte_data}; SECOND_VALID ← 0; LAST ← tx_byte_last.&lt;br/&gt;LD_SECOND: WORD[15:8] ← tx_byte_data; conservar WORD[7:0]; SECOND_VALID ← 1; LAST ← tx_byte_last.&lt;br/&gt;WORD_FIRE: conservar los 18 bits; solo se libera la fase de salida.&lt;br/&gt;&lt;br/&gt;No se acepta otra entrada en el flanco de entrega. Cada paquete comienza en el byte bajo.&lt;br/&gt;STATE [2] + WORD [16] + SECOND_VALID [1] + LAST [1] = 20 bits lógicos; sin FIFO ni contador." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=1.5;rounded=0;align=left;verticalAlign=top;spacing=22;">
          <mxGeometry x="70" y="1890" width="2560" height="290" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" value="Transiciones: registro STATE en always @(posedge clk). Salidas de UC: decodificación en always @(*), con valores por defecto.&lt;br/&gt;tx_word_data = WORD · tx_word_keep = {SECOND_VALID, 1'b1} · tx_word_last = LAST.&lt;br/&gt;Metadatos válidos solo con tx_word_valid. Fin de entrega local no confirma transmisión física ni recepción del LCD." vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=1.5;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;">
          <mxGeometry x="70" y="2220" width="2560" height="110" as="geometry" />
        </mxCell>
      </root>
