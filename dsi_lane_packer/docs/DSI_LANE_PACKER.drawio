        </mxCell>
        <mxCell id="reset_any" parent="1" value="&lt;b&gt;rst = 1&lt;/b&gt;&lt;br/&gt;Desde cualquier punto&lt;br/&gt;Prioridad sobre transferencias" vertex="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#e8edf4;strokeColor=#5c708a;strokeWidth=2;">
