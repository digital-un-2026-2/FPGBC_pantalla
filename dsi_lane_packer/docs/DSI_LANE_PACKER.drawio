        </mxCell>
        <mxCell id="a_in" parent="1" value="&lt;b&gt;A&lt;/b&gt;" vertex="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#e8edf4;strokeColor=#5c708a;strokeWidth=2;">
          <mxGeometry x="300" y="610" width="60" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wait_first" parent="1" value="&lt;b&gt;ESPERAR PRIMER BYTE DEL GRUPO&lt;/b&gt;&lt;br/&gt;tx_byte_ready ← 1; tx_word_valid ← 0" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="490" y="610" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="first_fire" parent="1" value="&lt;b&gt;¿tx_byte_valid = 1&lt;br/&gt;y tx_byte_ready = 1&lt;br/&gt;en ↑clk?&lt;/b&gt;" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;">
          <mxGeometry x="550" y="750" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capture_first" parent="1" value="&lt;b&gt;CONSERVAR PRIMER BYTE ACEPTADO&lt;/b&gt;&lt;br/&gt;Primer byte ← tx_byte_data&lt;br/&gt;Segundo byte ← 00; último ← tx_byte_last" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="490" y="920" width="520" height="105" as="geometry" />
        </mxCell>
        <mxCell id="first_last" parent="1" value="&lt;b&gt;¿El byte aceptado&lt;br/&gt;es el último&lt;br/&gt;del paquete?&lt;/b&gt;" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;">
          <mxGeometry x="550" y="1075" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="partial" parent="1" value="&lt;b&gt;PREPARAR GRUPO PARCIAL&lt;/b&gt;&lt;br/&gt;Palabra ← {00, primer byte}&lt;br/&gt;keep ← 01; last ← 1" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="90" y="1260" width="350" height="115" as="geometry" />
        </mxCell>
        <mxCell id="wait_second" parent="1" value="&lt;b&gt;ESPERAR SEGUNDO BYTE DEL GRUPO&lt;/b&gt;&lt;br/&gt;tx_byte_ready ← 1; tx_word_valid ← 0&lt;br/&gt;Conservar el primer byte" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="490" y="1260" width="520" height="105" as="geometry" />
        </mxCell>
        <mxCell id="second_fire" parent="1" value="&lt;b&gt;¿tx_byte_valid = 1&lt;br/&gt;y tx_byte_ready = 1&lt;br/&gt;en ↑clk?&lt;/b&gt;" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;">
          <mxGeometry x="550" y="1420" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capture_second" parent="1" value="&lt;b&gt;CONSERVAR SEGUNDO BYTE ACEPTADO&lt;/b&gt;&lt;br/&gt;Segundo byte ← tx_byte_data&lt;br/&gt;último ← tx_byte_last" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="490" y="1590" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="full" parent="1" value="&lt;b&gt;PREPARAR GRUPO COMPLETO&lt;/b&gt;&lt;br/&gt;Palabra ← {segundo byte, primer byte}&lt;br/&gt;keep ← 11; last ← último" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="490" y="1740" width="520" height="105" as="geometry" />
        </mxCell>
        <mxCell id="offer" parent="1" value="&lt;b&gt;OFRECER PALABRA AL RECEPTOR&lt;/b&gt;&lt;br/&gt;tx_byte_ready ← 0; tx_word_valid ← 1&lt;br/&gt;Conservar palabra, keep y last hasta aceptación" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="490" y="1910" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="output_fire" parent="1" value="&lt;b&gt;¿tx_word_valid = 1&lt;br/&gt;y tx_word_ready = 1&lt;br/&gt;en ↑clk?&lt;/b&gt;" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;">
          <mxGeometry x="540" y="2080" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="release" parent="1" value="&lt;b&gt;FINALIZAR ENTREGA DEL GRUPO&lt;/b&gt;&lt;br/&gt;tx_word_valid ← 0; liberar grupo&lt;br/&gt;Habilitar otra entrada después de esta entrega" vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="490" y="2260" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a_out" parent="1" value="&lt;b&gt;A&lt;/b&gt;" vertex="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#e8edf4;strokeColor=#5c708a;strokeWidth=2;">
          <mxGeometry x="720" y="2430" width="60" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" value="&lt;b&gt;REGLAS DEL RECORRIDO&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;← indica asignación.&lt;br/&gt;↑clk: flanco de aceptación.&lt;br/&gt;Cada rombo tiene salidas Sí / No.&lt;br/&gt;&lt;br/&gt;Sin valid no se acepta un byte.&lt;br/&gt;El productor conserva dato y last mientras espera ready.&lt;br/&gt;&lt;br/&gt;El primer byte ocupa [7:0] (D0); el segundo [15:8] (D1).&lt;br/&gt;keep = 01: el byte alto no se transmite como relleno.&lt;br/&gt;&lt;br/&gt;Cada paquete comienza en D0. No se combinan bytes de paquetes distintos.&lt;br/&gt;&lt;br/&gt;No se acepta entrada simultáneamente con la entrega de salida." vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="1110" y="700" width="330" height="610" as="geometry" />
        </mxCell>
        <mxCell id="limits" parent="1" value="&lt;b&gt;ALCANCE&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Agrupación lógica por paquete.&lt;br/&gt;No calcula ECC ni CRC.&lt;br/&gt;No genera símbolos ni bits HS.&lt;br/&gt;&lt;br/&gt;Aceptar la última palabra no confirma envío físico ni recepción del LCD.&lt;br/&gt;&lt;br/&gt;La formación de ráfagas, la continuidad HS y la terminación física del grupo parcial corresponden al futuro transporte." vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="1110" y="1450" width="330" height="380" as="geometry" />
        </mxCell>
        <mxCell id="reset_note" parent="1" value="&lt;b&gt;RESET GLOBAL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Bloquear handshakes mientras rst = 1.&lt;br/&gt;Descartar la operación sin éxito.&lt;br/&gt;Coordinar reset con productor y receptor.&lt;br/&gt;&lt;br/&gt;La asignación de operaciones a registros, estados y flancos del datapath se definirá después de revisar este flujo." vertex="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;">
          <mxGeometry x="1110" y="2050" width="330" height="350" as="geometry" />
        </mxCell>
