        <mxCell id="uc-title" parent="1" value="&lt;b&gt;3. FRONTERA CON LA UNIDAD DE CONTROL · FSM EN LA PÁGINA 3&lt;/b&gt;" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23;">
