        <mxCell id="title" parent="1" value="&lt;b&gt;DSI_LANE_PACKER · FSM&lt;/b&gt;" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=1.5;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=34;">
