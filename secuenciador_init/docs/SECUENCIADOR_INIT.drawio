        <mxCell id="f-mux" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=18;fontSize=20;" value="&lt;b&gt;sel_t [3]&lt;/b&gt;&lt;br&gt;0: T_ESTABILIZACION&lt;br&gt;1: T_REPOSO_INICIAL&lt;br&gt;2: espera_activa&lt;br&gt;3: TIMEOUT_PREPARACION&lt;br&gt;4: TIMEOUT_ACEPTACION&lt;br&gt;5: TIMEOUT_TRANSMISION" vertex="1">
          <mxGeometry height="290" width="550" x="140" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="f-errors" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=18;fontSize=20;" value="&lt;b&gt;CAPTURA Y ENCLAVAMIENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;En el posedge de detección:&lt;br&gt;CAUSA_FALLO ← causa_E; estado ← FALLO.&lt;br&gt;solicitud = 0; permiso_arranque = 0; abortar_motor = 1.&lt;br&gt;Ningún avance, carga de descriptor o temporización en ese flanco.&lt;br&gt;&lt;br&gt;En FALLO: no volver a cargar la causa. Sin reintentos.&lt;br&gt;Solo rst borra la causa y reinicia desde ARRANQUE.&lt;br&gt;Prioridad de causas simultáneas: 5, 6, 4, 1, 2, 3.&lt;br&gt;Transiciones normales: NOT E y NOT rst." vertex="1">
          <mxGeometry height="340" width="1140" x="770" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="f-handshake" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=18;fontSize=20;" value="&lt;b&gt;Incoherencia de handshake&lt;/b&gt;&lt;br&gt;&lt;br&gt;SOLICITAR: terminado OR (aceptado XOR ocupado)&lt;br&gt;TRANSMITIR: aceptado OR (ocupado == terminado)&lt;br&gt;Resto tras pedir LP: aceptado OR ocupado OR terminado&lt;br&gt;No evaluar durante rst, ARRANQUE, ESTABILIZAR ni FALLO.&lt;br&gt;&lt;br&gt;Entrada válida en TRANSMITIR: aceptado observado con ocupado.&lt;br&gt;Salida válida: terminado observado sin ocupado." vertex="1">
          <mxGeometry height="340" width="1200" x="1990" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="f-time" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontSize=19;" value="LD tiene prioridad sobre DEC. Carga N en E0; Q llega a 0 tras N periodos; transición por fin_t en el posedge siguiente.&lt;br&gt;N=0: transición en el posedge siguiente, sin descuento. Espera DCS desde la observación de terminado, no desde aceptado.&lt;br&gt;Especificación gráfica, sin RTL. Motor de 15 bytes y validación física pendientes." vertex="1">
          <mxGeometry height="105" width="3050" x="140" y="2950" as="geometry" />
        </mxCell>
        <mxCell id="err-prep-f" value="F" style="ellipse;html=1;fontSize=22;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2210" y="960" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="err-prep-edge" source="s-prep" target="err-prep-f" value="fin_t AND NOT lp_preparada&lt;br&gt;causa_E = 1 (timeout preparación)" edge="1" parent="1" style="html=1;endArrow=classic;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="err-valid-f" value="F" style="ellipse;html=1;fontSize=22;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2210" y="1640" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="err-valid-edge" source="s-valid" target="err-valid-f" value="NOT descriptor_valido&lt;br&gt;causa_E = 4 (descriptor inválido)" edge="1" parent="1" style="html=1;endArrow=classic;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
