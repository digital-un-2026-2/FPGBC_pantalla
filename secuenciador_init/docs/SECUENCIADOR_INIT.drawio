  <diagram id="init-fsm" name="FSM">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="3400" pageHeight="3150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f-title" parent="1" style="text;html=1;fontSize=30;" value="SECUENCIADOR INIT · FSM IMPLEMENTADA" vertex="1">
          <mxGeometry height="50" width="2800" x="100" y="30" as="geometry" />
        </mxCell>
        <mxCell id="f-clock" parent="1" style="text;html=1;fontSize=19;" value="Estado y flags registrados en posedge; controles decodificados combinacionalmente; datapath captura en negedge. fin_t_reg captura fin_t en posedge. Salidas no indicadas = 0." vertex="1">
          <mxGeometry height="40" width="3150" x="100" y="100" as="geometry" />
        </mxCell>
        <mxCell id="f-global" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=19;" value="Prioridad: rst; pérdida LP; incoherencia; descriptor inválido; evento válido antes de timeout.&lt;br&gt;E = cualquier error habilitado. Cada conector F conduce a FALLO; no es un estado adicional.&lt;br&gt;En la transición F: capturar primera causa, retirar solicitud/permiso, abortar motor y anular otras habilitaciones.&lt;br&gt;init_en_curso = 1 salvo LISTO/FALLO. preparar_lp = 1 salvo ARRANQUE/ESTABILIZAR. rst_motor = rst OR abortar_motor." vertex="1">
          <mxGeometry height="105" width="3150" x="100" y="160" as="geometry" />
        </mxCell>
        <mxCell id="f-start" parent="1" style="ellipse;html=1;fontSize=20;" value="rst" vertex="1">
          <mxGeometry height="65" width="65" x="90" y="305" as="geometry" />
        </mxCell>
        <mxCell id="s-boot" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;ARRANQUE&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;rst_paso = 1&lt;br&gt;sel_t = 0&lt;br&gt;rst_t = 1&lt;br&gt;preparar_lp = 0&lt;br&gt;init_en_curso = 1" vertex="1">
          <mxGeometry height="400" width="400" x="180" y="360" as="geometry" />
        </mxCell>
        <mxCell id="s-stab" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;ESTABILIZAR&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;sel_t = 0&lt;br&gt;inc_t = NOT fin_t_reg&lt;br&gt;preparar_lp = 0" vertex="1">
          <mxGeometry height="400" width="400" x="800" y="360" as="geometry" />
        </mxCell>
        <mxCell id="s-prepload" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;ARMAR_PREPARACION&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;sel_t = 3&lt;br&gt;rst_t = 1&lt;br&gt;preparar_lp = 1" vertex="1">
          <mxGeometry height="400" width="400" x="1420" y="360" as="geometry" />
        </mxCell>
        <mxCell id="s-prep" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;PREPARAR_LP&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;sel_t = 3&lt;br&gt;inc_t = NOT fin_t_reg&lt;br&gt;&lt;br&gt;Al salir por lp_preparada:&lt;br&gt;rst_t = 1; inc_t = 0&lt;br&gt;sel_t = 1" vertex="1">
          <mxGeometry height="400" width="400" x="2040" y="360" as="geometry" />
        </mxCell>
        <mxCell id="s-rest" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;REPOSO_INICIAL&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;sel_t = 1&lt;br&gt;inc_t = NOT fin_t_reg&lt;br&gt;solicitud = 0&lt;br&gt;permiso_arranque = 0" vertex="1">
          <mxGeometry height="400" width="400" x="2660" y="360" as="geometry" />
        </mxCell>
        <mxCell id="s-desc" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;CARGAR_DESCRIPTOR&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;ld_desc = 1&lt;br&gt;D = ROM_DESC[paso]" vertex="1">
          <mxGeometry height="400" width="400" x="2660" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="s-valid" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;VALIDAR_DESCRIPTOR&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;ld_desc = 0&lt;br&gt;Evaluar descriptor_valido" vertex="1">
          <mxGeometry height="400" width="400" x="2040" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="s-data" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;PREPARAR_PAQUETE&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;solicitud = 0&lt;br&gt;permiso_arranque = 0&lt;br&gt;Base y longitud estables&lt;br&gt;ROM combinacional → motor" vertex="1">
          <mxGeometry height="400" width="400" x="1420" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="s-reqload" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;ARMAR_ACEPTACION&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;sel_t = 4&lt;br&gt;rst_t = 1&lt;br&gt;solicitud = 0" vertex="1">
          <mxGeometry height="400" width="400" x="800" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="s-req" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=19;" value="&lt;b&gt;SOLICITAR&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;solicitud = 1&lt;br&gt;permiso_arranque = 1&lt;br&gt;sel_t = 4&lt;br&gt;inc_t = NOT fin_t_reg&lt;br&gt;&lt;br&gt;Al salir por aceptado:&lt;br&gt;solicitud = 0&lt;br&gt;permiso_arranque = 0&lt;br&gt;rst_t = 1; inc_t = 0; sel_t = 5" vertex="1">
          <mxGeometry height="400" width="400" x="180" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="s-tx" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=19;" value="&lt;b&gt;TRANSMITIR&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;solicitud = 0&lt;br&gt;permiso_arranque = 0&lt;br&gt;sel_t = 5&lt;br&gt;inc_t = NOT fin_t_reg&lt;br&gt;&lt;br&gt;Al salir por terminado:&lt;br&gt;rst_t = 1; inc_t = 0; sel_t = 2" vertex="1">
          <mxGeometry height="400" width="400" x="180" y="1800" as="geometry" />
        </mxCell>
        <mxCell id="s-wait" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=20;" value="&lt;b&gt;ESPERAR_COMANDO&lt;/b&gt;&lt;br&gt;______________________&lt;br&gt;&lt;br&gt;sel_t = 2&lt;br&gt;inc_t = NOT fin_t_reg&lt;br&gt;solicitud = 0&lt;br&gt;ld_desc = 0" vertex="1">
          <mxGeometry height="400" width="400" x="800" y="1800" as="geometry" />
