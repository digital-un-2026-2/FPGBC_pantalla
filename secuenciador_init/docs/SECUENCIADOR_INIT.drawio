        </mxCell>
        <mxCell id="estabilizar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="init_en_curso = 1&lt;br&gt;Contador a 0; contar hasta T_ESTABILIZACION" vertex="1">
          <mxGeometry height="60" width="300" x="460" y="490" as="geometry" />
        </mxCell>
        <mxCell id="preparar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="preparar_lp = 1&lt;br&gt;Iniciar timeout de preparación" vertex="1">
          <mxGeometry height="60" width="300" x="460" y="590" as="geometry" />
        </mxCell>
        <mxCell id="lp" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿lp_preparada == 1?" vertex="1">
          <mxGeometry height="80" width="220" x="500" y="690" as="geometry" />
        </mxCell>
        <mxCell id="reposo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="Contador a 0; contar hasta T_REPOSO_INICIAL&lt;br&gt;Sin solicitar envío" vertex="1">
          <mxGeometry height="60" width="300" x="460" y="810" as="geometry" />
        </mxCell>
        <mxCell id="descriptor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="base_activa = ROM_DESC[paso].base&lt;br&gt;longitud_activa = ROM_DESC[paso].longitud&lt;br&gt;espera_activa = ROM_DESC[paso].espera" vertex="1">
          <mxGeometry height="80" width="380" x="420" y="910" as="geometry" />
        </mxCell>
        <mxCell id="valido" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿Descriptor válido?" vertex="1">
          <mxGeometry height="80" width="220" x="500" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="paquete" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="cantidad_bytes = longitud_activa&lt;br&gt;Preparar lectura de ROM_PAQUETES&lt;br&gt;Respetar latencia antes de solicitar" vertex="1">
          <mxGeometry height="80" width="340" x="440" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="solicitar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="permiso_arranque = 1&lt;br&gt;solicitud = 1&lt;br&gt;Iniciar timeout de aceptación" vertex="1">
          <mxGeometry height="70" width="300" x="460" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="aceptado" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿aceptado == 1?" vertex="1">
          <mxGeometry height="80" width="200" x="510" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="transmitir" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="solicitud = 0&lt;br&gt;permiso_arranque = 0&lt;br&gt;Conservar base y longitud activas&lt;br&gt;Iniciar timeout de transmisión" vertex="1">
          <mxGeometry height="90" width="320" x="450" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="terminado" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿terminado == 1?" vertex="1">
          <mxGeometry height="80" width="200" x="510" y="1630" as="geometry" />
        </mxCell>
        <mxCell id="espera" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="Contador a 0; contar hasta espera_activa&lt;br&gt;Desde que se observa terminado&lt;br&gt;Sin solicitar otro envío" vertex="1">
          <mxGeometry height="80" width="320" x="450" y="1750" as="geometry" />
        </mxCell>
        <mxCell id="ultimo" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿paso == 10?" vertex="1">
          <mxGeometry height="80" width="180" x="520" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="avanzar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="paso = paso + 1" vertex="1">
          <mxGeometry height="50" width="180" x="250" y="1885" as="geometry" />
        </mxCell>
        <mxCell id="fin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="init_completa = 1&lt;br&gt;init_en_curso = 0&lt;br&gt;Mantener preparar_lp = 1&lt;br&gt;Sin nuevos envíos; esperar reset o fallo" vertex="1">
          <mxGeometry height="90" width="340" x="440" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="tlp" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿Timeout?" vertex="1">
          <mxGeometry height="70" width="140" x="220" y="695" as="geometry" />
        </mxCell>
        <mxCell id="ta" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿Timeout?" vertex="1">
          <mxGeometry height="70" width="140" x="220" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="tt" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿Timeout?" vertex="1">
          <mxGeometry height="70" width="140" x="220" y="1635" as="geometry" />
        </mxCell>
        <mxCell id="flp" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;" value="F" vertex="1">
          <mxGeometry height="40" width="40" x="270" y="805" as="geometry" />
        </mxCell>
        <mxCell id="fa" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;" value="F" vertex="1">
          <mxGeometry height="40" width="40" x="270" y="1495" as="geometry" />
        </mxCell>
        <mxCell id="ft" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;" value="F" vertex="1">
          <mxGeometry height="40" width="40" x="270" y="1745" as="geometry" />
        </mxCell>
        <mxCell id="fv" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;" value="F" vertex="1">
          <mxGeometry height="40" width="40" x="820" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="motor" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=12;" value="MOTOR LPDT (externo)&lt;br&gt;&lt;br&gt;Recibe: solicitud, permiso_arranque,&lt;br&gt;cantidad_bytes, byte_almacen.&lt;br&gt;Entrega: aceptado, ocupado, terminado, pos.&lt;br&gt;&lt;br&gt;Añade 87 y transmite el paquete.&lt;br&gt;estado_D0 → interfaz física → D0_P/N.&lt;br&gt;El supervisor no controla sus bits.&lt;br&gt;&lt;br&gt;Retirar permiso NO aborta.&lt;br&gt;Motor: control posedge, datos negedge.&lt;br&gt;Conservar caminos de medio ciclo: 12,5 ns." vertex="1">
          <mxGeometry height="280" width="420" x="970" y="100" as="geometry" />
        </mxCell>
        <mxCell id="rom" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=12;" value="ROM_PAQUETES (interna)&lt;br&gt;&lt;br&gt;dirección = base_activa + pos&lt;br&gt;byte_almacen = ROM_PAQUETES[dirección]&lt;br&gt;&lt;br&gt;75 bytes con ECC/CRC, sin selector 87.&lt;br&gt;Lectura combinacional anticipada.&lt;br&gt;Sin handshake por byte ni registro adicional.&lt;br&gt;&lt;br&gt;Motor externo: ANCHO_LONGITUD = 4.&lt;br&gt;Admite 1–15 bytes, sin fragmentar paquetes.&lt;br&gt;Timing físico de 12,5 ns pendiente de validar." vertex="1">
          <mxGeometry height="280" width="420" x="970" y="410" as="geometry" />
        </mxCell>
        <mxCell id="phy" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=12;" value="INTERFAZ FÍSICA LP (externa)&lt;br&gt;&lt;br&gt;preparar_lp → petición de configuración.&lt;br&gt;lp_preparada → condición interna de drivers.&lt;br&gt;No es respuesta del panel ni power-good.&lt;br&gt;&lt;br&gt;CLK/D1 en LP-11; D0 sigue al motor.&lt;br&gt;Drivers HS sin conducir.&lt;br&gt;Sin RESET físico ni GPIO de backlight.&lt;br&gt;Seguridad eléctrica pendiente de validar." vertex="1">
          <mxGeometry height="230" width="420" x="970" y="720" as="geometry" />
        </mxCell>
        <mxCell id="secuencia" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=12;" value="ROM_DESC · REFERENCIA POR VALIDAR&lt;br&gt;Paso: comando y parámetros hex → espera&lt;br&gt;&lt;br&gt;0: 01 → 20 ms&lt;br&gt;1: B0 00 → 5 ms&lt;br&gt;2: E4 00 00 00 00 08 → 0&lt;br&gt;3: D0 45 45 71 → 0&lt;br&gt;4: 6F 01 → 0&lt;br&gt;5: 11 → 120 ms&lt;br&gt;6: D0 52 4A 71 → 0&lt;br&gt;7: BE FF 0F 00 18 04 04 00 5D → 0&lt;br&gt;8: BB 2F → 0&lt;br&gt;9: B0 2F → 20 ms&lt;br&gt;10: 29 → 120 ms&lt;br&gt;&lt;br&gt;0: sin espera DCS adicional; no elimina&lt;br&gt;restricciones entre transacciones.&lt;br&gt;20 ms tras 01: propuesta dentro de 10–20 ms.&lt;br&gt;285 ms + preparación + transmisión." vertex="1">
          <mxGeometry height="380" width="420" x="970" y="980" as="geometry" />
        </mxCell>
        <mxCell id="fallo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;align=left;spacing=12;" value="F · FALLO ENCLAVADO&lt;br&gt;&lt;br&gt;Guardar primera causa; fallo = 1&lt;br&gt;init_completa = 0; init_en_curso = 0&lt;br&gt;solicitud = 0; permiso_arranque = 0&lt;br&gt;Mantener reset del motor, no del supervisor.&lt;br&gt;Conservar petición LP si estaba activa.&lt;br&gt;&lt;br&gt;Sin avance ni reintentos automáticos.&lt;br&gt;Salir únicamente mediante reset interno.&lt;br&gt;Todos los círculos F remiten a este bloque.&lt;br&gt;No garantiza recuperar físicamente el panel." vertex="1">
          <mxGeometry height="260" width="420" x="970" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="global" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" value="REGLAS GLOBALES&lt;br&gt;&lt;br&gt;rst tiene prioridad: volver al inicio.&lt;br&gt;Reset motor: un posedge y el negedge siguiente.&lt;br&gt;Reset aborta sin terminado.&lt;br&gt;&lt;br&gt;Tras adquirir lp_preparada, perderla → F.&lt;br&gt;También en LISTO mientras se conserve LP.&lt;br&gt;Incoherencia de handshake → F.&lt;br&gt;ocupado no sustituye terminado.&lt;br&gt;Timeouts configurables: valores de trabajo.&lt;br&gt;Controles síncronos al reloj de 40 MHz." vertex="1">
          <mxGeometry height="240" width="420" x="970" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="tiempos" parent="1" style="text;html=1;whiteSpace=wrap;align=left;" value="T_ESTABILIZACION: 20 ms configurable.&lt;br&gt;No mide ni garantiza alimentaciones.&lt;br&gt;T_REPOSO_INICIAL: 200 µs configurable.&lt;br&gt;Valores físicos pendientes de validar." vertex="1">
          <mxGeometry height="100" width="290" x="80" y="490" as="geometry" />
        </mxCell>
        <mxCell id="pie" parent="1" style="text;html=1;whiteSpace=wrap;align=left;" value="FLUJO DEL RTL IMPLEMENTADO · VERIFICACIÓN LÓGICA EN SIMULACIÓN&lt;br&gt;Notación: = asignación; == comparación. Una caja no representa necesariamente un ciclo ni un estado.&lt;br&gt;init_completa indica secuencia emitida y tiempos cumplidos; no confirma recepción ni imagen visible.&lt;br&gt;Sin CPU, PC, drivers LP/HS, BTA ni control de backlight. Interfaz física y validación eléctrica pendientes." vertex="1">
          <mxGeometry height="110" width="1190" x="200" y="2180" as="geometry" />
        </mxCell>
