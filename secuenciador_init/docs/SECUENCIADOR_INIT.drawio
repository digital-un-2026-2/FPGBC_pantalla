        <mxCell id="f-mux" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=18;fontSize=20;" value="&lt;b&gt;sel_t [3]&lt;/b&gt;&lt;br&gt;0: T_ESTABILIZACION&lt;br&gt;1: T_REPOSO_INICIAL&lt;br&gt;2: espera_activa&lt;br&gt;3: TIMEOUT_PREPARACION&lt;br&gt;4: TIMEOUT_ACEPTACION&lt;br&gt;5: TIMEOUT_TRANSMISION" vertex="1">
          <mxGeometry height="290" width="550" x="140" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="f-errors" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=18;fontSize=20;" value="&lt;b&gt;CAPTURA Y ENCLAVAMIENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Posedge de detección: estado ← FALLO.&lt;br&gt;Registrar ld_causa = 1; causa_fsm = causa_E.&lt;br&gt;Registrar solicitud = 0; permiso_arranque = 0; abortar_motor = 1.&lt;br&gt;Anular LD/INC/RST locales restantes.&lt;br&gt;Negedge siguiente: reg_0.v captura CAUSA_FALLO.&lt;br&gt;Posedge posterior: ld_causa = 0; conservar causa.&lt;br&gt;&lt;br&gt;Sin reintentos. Solo rst borra la causa y reinicia.&lt;br&gt;Prioridad de causas simultáneas: 5, 6, 4, 1, 2, 3.&lt;br&gt;Transiciones normales: NOT E y NOT rst." vertex="1">
          <mxGeometry height="340" width="1140" x="770" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="f-handshake" parent="1" style="whiteSpace=wrap;html=1;align=left;spacing=18;fontSize=20;" value="&lt;b&gt;Incoherencia de handshake&lt;/b&gt;&lt;br&gt;&lt;br&gt;SOLICITAR: terminado OR (aceptado XOR ocupado)&lt;br&gt;TRANSMITIR: aceptado OR (ocupado == terminado)&lt;br&gt;Resto tras pedir LP: aceptado OR ocupado OR terminado&lt;br&gt;No evaluar durante rst, ARRANQUE, ESTABILIZAR ni FALLO.&lt;br&gt;&lt;br&gt;Entrada válida en TRANSMITIR: aceptado observado con ocupado.&lt;br&gt;Salida válida: terminado observado sin ocupado." vertex="1">
          <mxGeometry height="340" width="1200" x="1990" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="f-time" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontSize=19;" value="fin_t = (TIEMPO == limite_t). fin_t_reg se captura en posedge; evita realimentación combinacional al contador negedge. RST &gt; INC.&lt;br&gt;reiniciar_intervalo fuerza rst_t=1 e inc_t=0 durante el primer ciclo del nuevo intervalo; reinicio anula controles tras reset.&lt;br&gt;Espera tras terminado: P0 emite rst_t; D0 borra; D1…DN cuentan; P(N+1) termina: (N+1) ciclos desde P0. N=0: sin incrementos.&lt;br&gt;Estado/flags en posedge; count.v/reg_0.v en negedge; salidas y mux.v/comp.v combinacionales. Sin validación de timing físico." vertex="1">
          <mxGeometry height="105" width="3050" x="140" y="2950" as="geometry" />
        </mxCell>
        <mxCell id="err-prep-f" parent="1" style="ellipse;html=1;fontSize=22;strokeWidth=2;" value="F" vertex="1">
          <mxGeometry height="60" width="60" x="2210" y="960" as="geometry" />
        </mxCell>
        <mxCell id="err-prep-edge" edge="1" parent="1" source="s-prep" style="html=1;endArrow=classic;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" target="err-prep-f" value="fin_t AND NOT lp_preparada&lt;br&gt;causa_E = 1 (timeout preparación)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="err-valid-f" parent="1" style="ellipse;html=1;fontSize=22;strokeWidth=2;" value="F" vertex="1">
          <mxGeometry height="60" width="60" x="2210" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="err-valid-edge" edge="1" parent="1" source="s-valid" style="html=1;endArrow=classic;fontSize=19;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" target="err-valid-f" value="NOT descriptor_valido&lt;br&gt;causa_E = 4 (descriptor inválido)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="err-ack-f" parent="1" style="ellipse;html=1;fontSize=22;strokeWidth=2;" value="F" vertex="1">
          <mxGeometry height="60" width="60" x="620" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="err-ack-edge" edge="1" parent="1" source="s-req" style="html=1;endArrow=classic;fontSize=19;exitX=0.85;exitY=0.85;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;" target="err-ack-f" value="fin_t AND NOT aceptado&lt;br&gt;causa_E = 2 (timeout aceptación)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="err-tx-f" parent="1" style="ellipse;html=1;fontSize=22;strokeWidth=2;" value="F" vertex="1">
