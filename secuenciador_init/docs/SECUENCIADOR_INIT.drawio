  <diagram id="init-datapath" name="Datapath">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2600" pageHeight="2550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dp-title" parent="1" style="text;html=1;align=left;fontSize=26;" value="SECUENCIADOR INIT · DATAPATH PROPUESTO" vertex="1">
          <mxGeometry height="50" width="2200" x="70" y="30" as="geometry" />
        </mxCell>
        <mxCell id="dp-step" parent="1" style="whiteSpace=wrap;html=1;fontSize=20;strokeWidth=1;" value="&lt;b&gt;PASO&lt;/b&gt;&lt;br&gt;CONTADOR [4]" vertex="1">
          <mxGeometry height="140" width="220" x="180" y="300" as="geometry" />
        </mxCell>
        <mxCell id="step-rst" parent="dp-step" style="text;html=1;fontSize=15;" value="RST" vertex="1">
          <mxGeometry height="25" width="45" as="geometry" />
        </mxCell>
        <mxCell id="step-inc" parent="dp-step" style="text;html=1;fontSize=15;" value="INC" vertex="1">
          <mxGeometry height="25" width="45" y="25" as="geometry" />
        </mxCell>
        <mxCell id="step-q" parent="dp-step" style="text;html=1;fontSize=17;align=right;" value="Q" vertex="1">
          <mxGeometry height="25" width="30" x="185" y="75" as="geometry" />
        </mxCell>
        <mxCell id="step-clk" parent="dp-step" style="text;html=1;fontSize=15;" value="▷CLK" vertex="1">
          <mxGeometry height="25" width="70" x="145" y="115" as="geometry" />
