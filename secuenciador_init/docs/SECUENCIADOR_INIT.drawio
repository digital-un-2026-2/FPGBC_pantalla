<mxfile host="Electron" pages="3">
  <diagram id="init-flujo" name="SECUENCIADOR_INIT">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="SECUENCIADOR DE INICIALIZACIÓN" style="text;html=1;whiteSpace=wrap;align=center;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="360" y="30" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="inicio" value="SECUENCIADOR&lt;br&gt;INIT" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reset" value="solicitud = 0&lt;br&gt;permiso_arranque = 0&lt;br&gt;preparar_lp = 0&lt;br&gt;init_completa = 0&lt;br&gt;init_en_curso = 0&lt;br&gt;fallo = 0; paso = 0&lt;br&gt;Reset coordinado del motor" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="200" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rst" value="¿rst == 0?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="530" y="380" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="estabilizar" value="init_en_curso = 1&lt;br&gt;Esperar T_ESTABILIZACION" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="490" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="preparar" value="preparar_lp = 1&lt;br&gt;Iniciar timeout de preparación" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="590" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lp" value="¿lp_preparada == 1?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="500" y="690" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="reposo" value="Esperar T_REPOSO_INICIAL&lt;br&gt;Sin solicitar envío" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="810" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="descriptor" value="base_activa = ROM_DESC[paso].base&lt;br&gt;longitud_activa = ROM_DESC[paso].longitud&lt;br&gt;espera_activa = ROM_DESC[paso].espera" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="910" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="valido" value="¿Descriptor válido?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="500" y="1030" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="paquete" value="cantidad_bytes = longitud_activa&lt;br&gt;Preparar lectura de ROM_PAQUETES&lt;br&gt;Respetar latencia antes de solicitar" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="1150" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="solicitar" value="permiso_arranque = 1&lt;br&gt;solicitud = 1&lt;br&gt;Iniciar timeout de aceptación" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="460" y="1270" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="aceptado" value="¿aceptado == 1?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="510" y="1380" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="transmitir" value="solicitud = 0&lt;br&gt;permiso_arranque = 0&lt;br&gt;Conservar base y longitud activas&lt;br&gt;Iniciar timeout de transmisión" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="1500" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="terminado" value="¿terminado == 1?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="510" y="1630" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="espera" value="Esperar espera_activa&lt;br&gt;Desde que se observa terminado&lt;br&gt;Sin solicitar otro envío" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="1750" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ultimo" value="¿paso == 10?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="520" y="1870" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="avanzar" value="paso = paso + 1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="250" y="1885" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fin" value="init_completa = 1&lt;br&gt;init_en_curso = 0&lt;br&gt;Mantener preparar_lp = 1&lt;br&gt;Sin nuevos envíos; esperar reset o fallo" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="2000" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tlp" value="¿Timeout?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="220" y="695" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ta" value="¿Timeout?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="220" y="1385" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tt" value="¿Timeout?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="220" y="1635" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flp" value="F" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="805" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fa" value="F" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="1495" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ft" value="F" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="1745" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fv" value="F" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="820" y="1050" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="motor" value="MOTOR LPDT (externo)&lt;br&gt;&lt;br&gt;Recibe: solicitud, permiso_arranque,&lt;br&gt;cantidad_bytes, byte_almacen.&lt;br&gt;Entrega: aceptado, ocupado, terminado, pos.&lt;br&gt;&lt;br&gt;Añade 87 y transmite el paquete.&lt;br&gt;estado_D0 → interfaz física → D0_P/N.&lt;br&gt;El supervisor no controla sus bits.&lt;br&gt;&lt;br&gt;Retirar permiso NO aborta.&lt;br&gt;Motor: control posedge, datos negedge.&lt;br&gt;Conservar caminos de medio ciclo: 12,5 ns." style="whiteSpace=wrap;html=1;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="100" width="420" height="280" as="geometry" />
        </mxCell>
        <mxCell id="rom" value="ROM_PAQUETES (interna)&lt;br&gt;&lt;br&gt;Durante el envío:&lt;br&gt;dirección = base_activa + pos&lt;br&gt;byte_almacen = ROM_PAQUETES[dirección]&lt;br&gt;&lt;br&gt;Paquetes completos con ECC/CRC, sin 87.&lt;br&gt;Lectura anticipada; sin handshake por byte.&lt;br&gt;Latencia pendiente de cerrar en datapath.&lt;br&gt;&lt;br&gt;Motor actual: 1–7 bytes.&lt;br&gt;DEPENDENCIA: ampliación a 1–15 bytes.&lt;br&gt;No fragmentar paquetes largos." style="whiteSpace=wrap;html=1;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="410" width="420" height="280" as="geometry" />
        </mxCell>
        <mxCell id="phy" value="INTERFAZ FÍSICA LP (externa)&lt;br&gt;&lt;br&gt;preparar_lp → petición de configuración.&lt;br&gt;lp_preparada → condición interna de drivers.&lt;br&gt;No es respuesta del panel ni power-good.&lt;br&gt;&lt;br&gt;CLK/D1 en LP-11; D0 sigue al motor.&lt;br&gt;Drivers HS sin conducir.&lt;br&gt;Sin RESET físico ni GPIO de backlight.&lt;br&gt;Seguridad eléctrica pendiente de validar." style="whiteSpace=wrap;html=1;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="720" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="secuencia" value="ROM_DESC · REFERENCIA POR VALIDAR&lt;br&gt;Paso: comando y parámetros hex → espera&lt;br&gt;&lt;br&gt;0: 01 → 20 ms&lt;br&gt;1: B0 00 → 5 ms&lt;br&gt;2: E4 00 00 00 00 08 → 0&lt;br&gt;3: D0 45 45 71 → 0&lt;br&gt;4: 6F 01 → 0&lt;br&gt;5: 11 → 120 ms&lt;br&gt;6: D0 52 4A 71 → 0&lt;br&gt;7: BE FF 0F 00 18 04 04 00 5D → 0&lt;br&gt;8: BB 2F → 0&lt;br&gt;9: B0 2F → 20 ms&lt;br&gt;10: 29 → 120 ms&lt;br&gt;&lt;br&gt;0: sin espera DCS adicional; no elimina&lt;br&gt;restricciones entre transacciones.&lt;br&gt;20 ms tras 01: propuesta dentro de 10–20 ms.&lt;br&gt;285 ms + preparación + transmisión." style="whiteSpace=wrap;html=1;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="980" width="420" height="380" as="geometry" />
        </mxCell>
        <mxCell id="fallo" value="F · FALLO ENCLAVADO&lt;br&gt;&lt;br&gt;Guardar primera causa; fallo = 1&lt;br&gt;init_completa = 0; init_en_curso = 0&lt;br&gt;solicitud = 0; permiso_arranque = 0&lt;br&gt;Mantener reset del motor, no del supervisor.&lt;br&gt;Conservar petición LP si estaba activa.&lt;br&gt;&lt;br&gt;Sin avance ni reintentos automáticos.&lt;br&gt;Salir únicamente mediante reset interno.&lt;br&gt;Todos los círculos F remiten a este bloque.&lt;br&gt;No garantiza recuperar físicamente el panel." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="1400" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="global" value="REGLAS GLOBALES&lt;br&gt;&lt;br&gt;rst tiene prioridad: volver al inicio.&lt;br&gt;Reset motor: un posedge y el negedge siguiente.&lt;br&gt;Reset aborta sin terminado.&lt;br&gt;&lt;br&gt;Tras adquirir lp_preparada, perderla → F.&lt;br&gt;También en LISTO mientras se conserve LP.&lt;br&gt;Incoherencia de handshake → F.&lt;br&gt;ocupado no sustituye terminado.&lt;br&gt;Timeouts pendientes de dimensionar.&lt;br&gt;Controles síncronos al reloj de 40 MHz." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="970" y="1700" width="420" height="240" as="geometry" />
        </mxCell>
        <mxCell id="tiempos" value="T_ESTABILIZACION: configurable, pendiente.&lt;br&gt;No mide ni garantiza alimentaciones.&lt;br&gt;T_REPOSO_INICIAL: propuesta de 200 µs.&lt;br&gt;No es temporización física validada." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pie" value="PROPUESTA DE DISEÑO · NO RTL IMPLEMENTADO&lt;br&gt;Notación como ejemplo.drawio: = asignación; == comparación. Una caja no representa necesariamente un ciclo ni un estado.&lt;br&gt;Las esperas terminan antes de avanzar. init_completa solo indica secuencia emitida y tiempos cumplidos, no recepción ni imagen visible.&lt;br&gt;Base: AGENTS.md y contrato RTL del motor. Sin CPU, PC, HS, BTA ni control de backlight. Sin validación eléctrica." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="200" y="2180" width="1190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e01" edge="1" parent="1" source="inicio" target="reset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e02" edge="1" parent="1" source="reset" target="rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry" />
