        </mxCell>
        <mxCell id="guards-3-1" value="Dos FF REF de (RUN_B &amp; V_P &amp; !rst_byte); no cruza el bus de tramas" vertex="1" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;align=center;verticalAlign=middle;spacing=8;fontSize=18;align=left;spacing=8;">
