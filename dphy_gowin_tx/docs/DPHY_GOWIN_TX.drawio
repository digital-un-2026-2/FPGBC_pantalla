        <mxCell id="reset" value="RESET POR DOMINIO&#10;SER_RESET_D / SER_RESET_C: dos FF&#10;Aserción: INHIBIT | rst | !LOCK_RAW&#10;Liberación en FCLK_D / FCLK_C / PCLK&#10;SER_READY_B: resets liberados, sincronizado a byte_clk" vertex="1" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;align=center;verticalAlign=middle;spacing=8;">
