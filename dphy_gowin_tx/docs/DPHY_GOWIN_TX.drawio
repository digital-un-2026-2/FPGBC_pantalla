        <mxCell id="clock" value="CLOCK_FAULT [1]&#10;Set asíncrono:&#10;RUN_STARTED &amp; !LOCK_RAW&#10;rst → 0; resto conservar&#10;Salida clock_fault → G_ERR" vertex="1" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;align=center;verticalAlign=middle;spacing=8;">
          <mxGeometry x="1320" y="960" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="fire" value="BOOT_FIRE = !rst &amp; (STATE=WAIT_LOCK) &amp; B &amp; !F&#10;Evento de aceptación anterior al ↑REF. Estado RELEASE y RUN_STARTED=1 aparecen juntos después del flanco.&#10;En RELEASE, un evento breve queda en EV_RAW e impide volver a limpiar INHIBIT, aunque el nivel de entrada ya se haya recuperado." vertex="1" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;align=center;verticalAlign=middle;spacing=8;text;strokeColor=none;fillColor=none;align=left;fontSize=19;spacing=0;">
          <mxGeometry x="50" y="1180" width="1700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="inhibit" value="R_INHIBIT [1] · MEMORIA DE SEGURIDAD&#10;SET async = rst | phy_abort | !LOCK_RAW | UC_BLOCK | EV_RAW&#10;CLEAR = RELEASE_SAFE; SET &gt; CLEAR &gt; conservar&#10;No depende de FCLK. No borra una causa retenida." vertex="1" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;align=center;verticalAlign=middle;spacing=8;">
