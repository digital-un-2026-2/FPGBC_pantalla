          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="local-clock-note" value="CLK = 40 MHz · Todos los registros usan el mismo reloj; no se generan relojes con lógica." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="300.0" y="1910" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="local-control-note" value="&lt;b&gt;SEÑALES ENTRE DATAPATH Y FSM&lt;/b&gt;&lt;br&gt;&lt;br&gt;FSM → Datapath: LD_LEN, SEL_87, LD_BYTE, RST_BYTE, INC_BYTE, RST_BIT, INC_BIT, LD_T, DEC_T, SEL_FIJO, LP_FIJO[2], LD_LP.&lt;br&gt;Datapath → FSM: Z_BIT, Z_BYTE, Z_T, IDX[W].&lt;br&gt;IDX = indice_byte; Z_BIT = (indice_bit == 7); Z_BYTE = (indice_byte + 1 == longitud_paquete); Z_T = (TIEMPO == 0).&lt;br&gt;Interfaces de control: solicitud, permiso_arranque → FSM; aceptado, ocupado, terminado ← FSM. POS[W] lo prepara el control con antelación; no es una conexión directa de IDX.&lt;br&gt;Las etiquetas son conexiones por nombre, no registros adicionales. selector y pendiente pertenecen al control, no a este datapath." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;align=left;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="500.0" y="2140" width="2750" height="320" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lpdt-fsm" name="FSM">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="3500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fsm-title" value="&lt;b&gt;MOTOR LPDT · UNIDAD DE CONTROL&lt;/b&gt;" style="text;html=1;align=left;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="3400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fsm-key" value="Estructura de ejemplo.drawio: estados con controles del datapath; flechas con condiciones. Especificación gráfica, no RTL.&lt;br&gt;Controles indicados actúan en el flanco que CIERRA el intervalo del estado actual. Salidas no indicadas = 0; registros no habilitados conservan Q.&lt;br&gt;LD_T carga 3 y tiene prioridad sobre DEC_T. En cada fase: 3 → 2 → 1 → 0 → transición = 4 periodos de 25 ns." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="3400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s-idle" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = 11 · ocupado = 0&lt;br&gt;ready = permiso_arranque&lt;br&gt;A = solicitud AND ready&lt;br&gt;&lt;br&gt;LD_LEN = A; RST_BYTE = A&lt;br&gt;RST_BIT = A; LD_BYTE = A&lt;br&gt;SEL_87 = 1&lt;br&gt;LD_T = A; DEC_T = 0&lt;br&gt;LD_LP = A; SEL_FIJO = 1&lt;br&gt;LP_FIJO = 10&lt;br&gt;selector ← 1, pendiente ← 0 si A&lt;br&gt;aceptado: pulso registrado por A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-e10" value="&lt;b&gt;ESC_10&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = 10 · ocupado = 1&lt;br&gt;&lt;br&gt;DEC_T = NOT Z_T&lt;br&gt;LD_T = Z_T&lt;br&gt;LD_LP = Z_T&lt;br&gt;SEL_FIJO = 1&lt;br&gt;LP_FIJO = 00&lt;br&gt;&lt;br&gt;Byte selector e índices estables" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1000" y="300" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-e00a" value="&lt;b&gt;ESC_00_A&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = 00 · ocupado = 1&lt;br&gt;&lt;br&gt;DEC_T = NOT Z_T&lt;br&gt;LD_T = Z_T&lt;br&gt;LD_LP = Z_T&lt;br&gt;SEL_FIJO = 1&lt;br&gt;LP_FIJO = 01&lt;br&gt;&lt;br&gt;Primer puente de entrada" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1900" y="300" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-e01" value="&lt;b&gt;ESC_01&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = 01 · ocupado = 1&lt;br&gt;&lt;br&gt;DEC_T = NOT Z_T&lt;br&gt;LD_T = Z_T&lt;br&gt;LD_LP = Z_T&lt;br&gt;SEL_FIJO = 1&lt;br&gt;LP_FIJO = 00&lt;br&gt;&lt;br&gt;Último Mark de entrada" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="2800" y="300" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-mark" value="&lt;b&gt;MARK&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = {bit, NOT bit}&lt;br&gt;ocupado = 1&lt;br&gt;DEC_T = NOT Z_T; LD_T = Z_T&lt;br&gt;LD_LP = Z_T&lt;br&gt;SEL_FIJO = 1; LP_FIJO = 00&lt;br&gt;&lt;br&gt;Al salir (Z_T): preparar siguiente dato&lt;br&gt;INC_BIT = NOT Z_BIT&lt;br&gt;RST_BIT = Z_BIT&lt;br&gt;LD_BYTE = Z_BIT AND NOT F&lt;br&gt;SEL_87 = 0&lt;br&gt;INC_BYTE = Z_BIT AND NOT selector&lt;br&gt;AND NOT Z_BYTE&lt;br&gt;pendiente ← F&lt;br&gt;selector ← 0 si Z_BIT" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1200" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-space" value="&lt;b&gt;SPACE&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = 00 · ocupado = 1&lt;br&gt;&lt;br&gt;DEC_T = NOT Z_T&lt;br&gt;LD_T = Z_T; LD_LP = Z_T&lt;br&gt;SEL_FIJO = pendiente&lt;br&gt;LP_FIJO = 10&lt;br&gt;&lt;br&gt;Si pendiente = 0: cargar Mark&lt;br&gt;desde byte_actual[indice_bit]&lt;br&gt;ya preparado al entrar en Space.&lt;br&gt;Si pendiente = 1: cargar salida 10.&lt;br&gt;&lt;br&gt;No avanzar índices en este estado" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="100" y="1200" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-e00b" value="&lt;b&gt;ESC_00_B&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = 00 · ocupado = 1&lt;br&gt;&lt;br&gt;DEC_T = NOT Z_T&lt;br&gt;LD_T = Z_T&lt;br&gt;LD_LP = Z_T&lt;br&gt;SEL_FIJO = 0&lt;br&gt;&lt;br&gt;Cargar primer Mark desde&lt;br&gt;byte_actual[0] del selector 87&lt;br&gt;→ Q_LP = 10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1900" y="1200" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-exit" value="&lt;b&gt;EXIT_10&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = 10 · ocupado = 1&lt;br&gt;&lt;br&gt;DEC_T = NOT Z_T&lt;br&gt;LD_T = 0&lt;br&gt;LD_LP = Z_T&lt;br&gt;SEL_FIJO = 1&lt;br&gt;LP_FIJO = 11&lt;br&gt;&lt;br&gt;Mark de salida: no es bit de datos.&lt;br&gt;Le sigue 11, nunca Space." style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="100" y="2100" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="s-done" value="&lt;b&gt;DONE&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;Q_LP = 11&lt;br&gt;ocupado = 0&lt;br&gt;ready = 0&lt;br&gt;terminado = 1&lt;br&gt;&lt;br&gt;Todos los LD e INC = 0&lt;br&gt;DEC_T = 0&lt;br&gt;Duración: un ciclo de 25 ns&lt;br&gt;&lt;br&gt;Fin local, no ACK ni ejecución" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1000" y="2100" width="620" height="620" as="geometry" />
        </mxCell>
        <mxCell id="f-a" value="A = 1" edge="1" parent="1" source="s-idle" target="s-e10" style="html=1;endArrow=classic;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-b" value="Z_T = 1" edge="1" parent="1" source="s-e10" target="s-e00a" style="html=1;endArrow=classic;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-c" value="Z_T = 1" edge="1" parent="1" source="s-e00a" target="s-e01" style="html=1;endArrow=classic;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-d" value="Z_T = 1" edge="1" parent="1" source="s-e01" target="s-e00b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3110" y="1000" />
              <mxPoint x="2210" y="1000" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f-e" value="Z_T = 1" edge="1" parent="1" source="s-e00b" target="s-mark" style="html=1;endArrow=classic;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-f" value="Z_T = 1 / preparar siguiente dato" edge="1" parent="1" source="s-mark" target="s-space" style="html=1;endArrow=classic;exitX=0;exitY=0.3;entryX=1;entryY=0.3;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-g" value="Z_T AND NOT pendiente" edge="1" parent="1" source="s-space" target="s-mark" style="html=1;endArrow=classic;exitX=1;exitY=0.75;entryX=0;entryY=0.75;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-h" value="Z_T AND pendiente" edge="1" parent="1" source="s-space" target="s-exit" style="html=1;endArrow=classic;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-i" value="Z_T = 1" edge="1" parent="1" source="s-exit" target="s-done" style="html=1;endArrow=classic;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-j" value="Incondicional · siguiente flanco" edge="1" parent="1" source="s-done" target="s-idle" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1;fontSize=18;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1740" y="2410" />
              <mxPoint x="1740" y="2890" />
              <mxPoint x="30" y="2890" />
              <mxPoint x="30" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fsm-flags" value="&lt;b&gt;FLAGS Y RETENCIÓN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Z_T = (TIEMPO == 0)&lt;br&gt;Z_BIT = (INDICE_BIT == 7)&lt;br&gt;Z_BYTE = (INDICE_BYTE + 1 == LONGITUD)&lt;br&gt;selector = enviando_selector&lt;br&gt;pendiente = salida_pendiente&lt;br&gt;F = NOT selector AND Z_BIT AND Z_BYTE&lt;br&gt;&lt;br&gt;MARK evalúa F e índices anteriores al flanco.&lt;br&gt;SPACE usa pendiente registrado: NO reevaluar F&lt;br&gt;con índices ya avanzados.&lt;br&gt;&lt;br&gt;Sin A en IDLE: permanecer. Sin Z_T en las siete&lt;br&gt;fases temporizadas: permanecer y decrementar.&lt;br&gt;Los bucles muestran explícitamente esas permanencias, como en ejemplo.drawio." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="2780" y="1200" width="700" height="620" as="geometry" />
        </mxCell>
        <mxCell id="fsm-pos" value="&lt;b&gt;SUMINISTRO DE BYTES · SIN ESTADOS EXTRA&lt;/b&gt;&lt;br&gt;&lt;br&gt;POS = 0 durante selector.&lt;br&gt;POS = INDICE_BYTE + 1 durante un byte DSI&lt;br&gt;si NOT Z_BYTE; en el último, conservar posición válida.&lt;br&gt;SEL_87 = 1 selecciona 87; = 0 selecciona DATA.&lt;br&gt;&lt;br&gt;Al terminar el último Mark del selector: cargar DATA[0],&lt;br&gt;RST_BIT = 1, no incrementar INDICE_BYTE.&lt;br&gt;Al terminar un byte DSI no final: cargar siguiente DATA,&lt;br&gt;RST_BIT = 1, INC_BYTE = 1.&lt;br&gt;&lt;br&gt;El almacén mantiene el paquete completo e inmutable.&lt;br&gt;La lectura debe estar preparada ANTES de ese flanco;&lt;br&gt;no se presupone memoria de latencia cero.&lt;br&gt;En el último byte: LD_BYTE = 0, INC_BYTE = 0.&lt;br&gt;No hay desplazamiento: el MUX 8:1 usa INDICE_BIT." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="1900" y="2100" width="760" height="650" as="geometry" />
        </mxCell>
        <mxCell id="fsm-phy" value="&lt;b&gt;PROPIEDAD, ARRANQUE Y RESET&lt;/b&gt;&lt;br&gt;&lt;br&gt;ESTADO_D0: único registro de valores LP.&lt;br&gt;SEL_FIJO = 1: LP_FIJO; = 0: {bit, NOT bit}.&lt;br&gt;No conectar lógica combinacional directa a los pines.&lt;br&gt;El Control físico posee las habilitaciones reales;&lt;br&gt;durante este ejercicio CLK/D1 = 11, HS no conduce.&lt;br&gt;&lt;br&gt;permiso_arranque solo tras LP válido y 8000 ciclos&lt;br&gt;(200 µs) de reposo inicial externo. No repetir por paquete.&lt;br&gt;El Control físico debe preservar la asignación al motor&lt;br&gt;hasta terminado; no puede retirarla a mitad del envío.&lt;br&gt;También gobierna el permiso entre transacciones.&lt;br&gt;&lt;br&gt;Reset interno desde cualquier estado: abortar, IDLE,&lt;br&gt;Q_LP ← 11; selector/pendiente/avisos ← 0.&lt;br&gt;El supervisor retira permiso y repite reposo inicial.&lt;br&gt;No emitir terminado por aborto. Panel en estado incierto;&lt;br&gt;LP-11 no garantiza recuperación. Reset DCS es distinto.&lt;br&gt;Detalle de reset de E/S pendiente de validación." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="2740" y="2100" width="760" height="740" as="geometry" />
        </mxCell>
        <mxCell id="fsm-timing" value="&lt;b&gt;CRONOLOGÍA NOMINAL · VECTOR 87 05 01 00 10&lt;/b&gt;&lt;br&gt;E0: aceptar y registrar 10 / T=3. E1: T=2. E2: T=1. E3: T=0. E4: registrar 00 / T=3.&lt;br&gt;E0–E16 entrada · E16–E80 selector · E80–E144 05 · E144–E208 01 · E208–E272 00 · E272–E336 10.&lt;br&gt;E336–E340 EXIT_10. E340: registrar 11, entrar DONE y activar terminado. E341: IDLE.&lt;br&gt;340 × 25 ns = 8,5 µs desde abandonar reposo hasta volver a LP-11. DONE no alarga ese intervalo.&lt;br&gt;Un bit 1 es 10 → 00; salida es 10 → 11. Se conserva completo el último Space.&lt;br&gt;Parámetros de trabajo, no certificación. Espera posterior a Software Reset: externa y pendiente." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="100" y="3010" width="3380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="fsm-check" value="&lt;b&gt;VERIFICAR&lt;/b&gt; · Decodificador independiente de P/N: 87 05 01 00 10, LSB primero, polaridad, 4 ciclos por fase, sin LP-11 entre bytes.&lt;br&gt;Pruebas 00 / FF / 55 / AA, solicitudes ocupado, reset en cada fase, CLK/D1 y habilitaciones HS. Simulación lógica ≠ validación eléctrica.&lt;br&gt;Control híbrido como el ejemplo: estados + flags gobiernan habilitaciones; no es Moore estricta. Valores físicos siempre registrados, sin decodificación directa.&lt;br&gt;Contrato: ready solo IDLE con permiso; solicitud y longitud válidas se mantienen hasta aceptar. Sin cola. Retirar solicitud tras aceptar salvo nueva transacción.&lt;br&gt;aceptado es pulso registrado de un ciclo al aceptar; terminado dura DONE. No hay error remoto observable sin recepción. Sin HS/ULPS/BTA/RX." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="100" y="3310" width="3380" height="160" as="geometry" />
        </mxCell>
