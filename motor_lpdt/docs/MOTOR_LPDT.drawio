        </mxCell>
        <mxCell id="n-memory" value="Almacén: interfaz y latencia pendientes; byte disponible antes del flanco de carga al iniciar el último Space previo.&lt;br&gt;POS es la lectura requerida; no se conecta directamente a indice_byte." style="text;html=1;align=left;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="300.0" y="270" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n-next" value="Al comenzar Space: preparar byte/índice. Al terminar sus 4 ciclos: registrar Mark desde Q estables.&lt;br&gt;LD_BYTE y RST_BIT simultáneos al cargar; selector 0x87 preparado antes de entrar a escape.&lt;br&gt;Cierre temporal pendiente; no hay MUX ni sumador de anticipación de bit." style="text;html=1;align=left;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1130.0" y="270" width="1150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n-phy" value="D0 = PN: [1]=P, [0]=N. Drivers bajo control físico.&lt;br&gt;CLK y D1 en LP-11; HS sin conducir durante LPDT." style="text;html=1;align=left;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="2570.0" y="280" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-time" value="Tiempo propuesto: LD prioritario sobre DEC.&lt;br&gt;3 → 2 → 1 → 0 → cambio: 4 × 25 ns.&lt;br&gt;Reposo inicial de 200 µs fuera del motor." style="text;html=1;align=left;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="300.0" y="2700" width="550" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n-priority" value="RST de contadores: puesta a cero síncrona, prioritaria sobre INC; no es RESET del panel.&lt;br&gt;Registros sin LD y contadores sin habilitación conservan Q. Inicialización global pendiente.&lt;br&gt;La anchura W permite representar Nmax; indice_byte válido: 0…longitud−1. No incrementar fuera del rango." style="text;html=1;align=left;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="2700" width="2300" height="75" as="geometry" />
        </mxCell>
