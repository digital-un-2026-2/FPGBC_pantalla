<mxfile host="app.diagrams.net" pages="3">
  <diagram id="lpdt-flujo" name="Flujo del motor LPDT">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="3120" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="&lt;b&gt;MOTOR LPDT · DIAGRAMA DE FLUJO&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=28;fontColor=#172b4d;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="1540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" value="Paquete DSI preparado → estados LP de D0. Flujo conceptual; consultar el RTL para el comportamiento implementado. Sin validación física.&lt;br&gt;&lt;b&gt;←&lt;/b&gt; asignación · &lt;b&gt;==&lt;/b&gt; comparación · &lt;b&gt;PN&lt;/b&gt;: P = lp[1], N = lp[0]. Una caja no equivale a un ciclo ni a un estado de FSM." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=17;fontColor=#42526e;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="1540" height="60" as="geometry" />
        </mxCell>

        <mxCell id="inicio" value="&lt;b&gt;INICIO&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#e8edf4;strokeColor=#5c708a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="170" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="reposo" value="&lt;b&gt;REPOSO&lt;/b&gt;&lt;br&gt;estado_D0 ← 11&lt;br&gt;ocupado ← 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="245" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="solicitud" value="&lt;b&gt;¿solicitud == 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="375" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="permiso" value="&lt;b&gt;¿permiso_arranque&lt;br&gt;== 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="530" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="aceptar" value="&lt;b&gt;ACEPTAR&lt;/b&gt;&lt;br&gt;longitud_paquete ← cantidad_bytes&lt;br&gt;indice_byte ← 0; ocupado ← 1&lt;br&gt;Notificar aceptado → Transporte" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="700" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="entrada" value="&lt;b&gt;ENTRAR A ESCAPE&lt;/b&gt;&lt;br&gt;estado_D0 ← 10; mantener 100 ns&lt;br&gt;estado_D0 ← 00; mantener 100 ns&lt;br&gt;estado_D0 ← 01; mantener 100 ns&lt;br&gt;estado_D0 ← 00; mantener 100 ns" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="1020" width="400" height="155" as="geometry" />
        </mxCell>
        <mxCell id="preparar-selector" value="&lt;b&gt;PREPARAR SELECTOR&lt;/b&gt;&lt;br&gt;byte_actual ← 0x87&lt;br&gt;indice_bit ← 0&lt;br&gt;enviando_selector ← 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="860" width="360" height="115" as="geometry" />
        </mxCell>
        <mxCell id="valor-bit" value="&lt;b&gt;¿byte_actual&lt;br&gt;[indice_bit] == 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="1220" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mark-1" value="&lt;b&gt;MARK-1&lt;/b&gt;&lt;br&gt;estado_D0 ← 10&lt;br&gt;Mantener 100 ns" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="1390" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mark-0" value="&lt;b&gt;MARK-0&lt;/b&gt;&lt;br&gt;estado_D0 ← 01&lt;br&gt;Mantener 100 ns" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="1390" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="space" value="&lt;b&gt;INICIAR SPACE&lt;/b&gt;&lt;br&gt;estado_D0 ← 00&lt;br&gt;salida_pendiente ← 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="1530" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ultimo-bit" value="&lt;b&gt;¿indice_bit == 7?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="1665" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="avanzar-bit" value="&lt;b&gt;AVANZAR BIT&lt;/b&gt;&lt;br&gt;indice_bit ← indice_bit + 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="1680" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="era-selector" value="&lt;b&gt;¿enviando_selector&lt;br&gt;== 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="1820" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pasar-a-dsi" value="&lt;b&gt;PASAR AL PAQUETE DSI&lt;/b&gt;&lt;br&gt;enviando_selector ← 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="1840" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ultimo-byte" value="&lt;b&gt;¿indice_byte + 1&lt;br&gt;== longitud_paquete?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="580" y="1990" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="avanzar-byte" value="&lt;b&gt;AVANZAR BYTE&lt;/b&gt;&lt;br&gt;indice_byte ← indice_byte + 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="2020" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="obtener-byte" value="&lt;b&gt;CARGAR BYTE DSI PREPARADO&lt;/b&gt;&lt;br&gt;byte_actual ← byte del Almacén&lt;br&gt;ya obtenido para indice_byte&lt;br&gt;indice_bit ← 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="2190" width="330" height="115" as="geometry" />
        </mxCell>
        <mxCell id="marcar-salida" value="&lt;b&gt;RECORDAR FIN DEL PAQUETE&lt;/b&gt;&lt;br&gt;salida_pendiente ← 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="2180" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="completar-space" value="&lt;b&gt;COMPLETAR SPACE&lt;/b&gt;&lt;br&gt;Mantener 00 hasta cumplir 100 ns&lt;br&gt;desde INICIAR SPACE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="2380" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="salir-tras-space" value="&lt;b&gt;¿salida_pendiente&lt;br&gt;== 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#513e13;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="2520" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="salida" value="&lt;b&gt;INICIAR SALIDA DE ESCAPE&lt;/b&gt;&lt;br&gt;estado_D0 ← 10&lt;br&gt;Mantener 100 ns" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="2690" width="360" height="95" as="geometry" />
        </mxCell>
        <mxCell id="finalizar" value="&lt;b&gt;FINALIZAR&lt;/b&gt;&lt;br&gt;estado_D0 ← 11; ocupado ← 0&lt;br&gt;Notificar terminado&lt;br&gt;→ Transporte y Control físico D-PHY" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#172b4d;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="2820" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="variables" value="&lt;b&gt;NO CONFUNDIR&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;longitud_paquete&lt;/b&gt;: cantidad de bytes DSI; fija, sin contar 0x87.&lt;br&gt;&lt;b&gt;indice_byte&lt;/b&gt;: posición 0…longitud−1.&lt;br&gt;&lt;b&gt;byte_actual&lt;/b&gt;: contenido de 8 bits.&lt;br&gt;&lt;b&gt;indice_bit&lt;/b&gt;: posición 0…7.&lt;br&gt;&lt;br&gt;Durante Space, los registros describen el siguiente Mark preparado.&lt;br&gt;enviando_selector distingue selector/DSI, no el valor del byte.&lt;br&gt;salida_pendiente conserva la ruta tras Space; pertenece al control." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" vertex="1" parent="1">
          <mxGeometry x="140" y="860" width="350" height="340" as="geometry" />
        </mxCell>
        <mxCell id="ext-transporte" value="&lt;b&gt;EXTERNO · CONTROLADOR DE TRANSPORTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transporte → Motor: solicitud, cantidad_bytes.&lt;br&gt;Motor → Transporte: aceptado, ocupado, terminado.&lt;br&gt;&lt;br&gt;Mantiene solicitud y longitud hasta aceptación. Presenta un paquete completo de longitud válida, no nula, y conserva su contenido hasta terminar." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f4f5f7;strokeColor=#a5adba;" vertex="1" parent="1">
          <mxGeometry x="1190" y="245" width="440" height="245" as="geometry" />
        </mxCell>
        <mxCell id="ext-phy" value="&lt;b&gt;EXTERNO · CONTROL FÍSICO D-PHY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Control físico → Motor: permiso_arranque.&lt;br&gt;Motor → Control físico: estado_D0, ocupado, terminado.&lt;br&gt;&lt;br&gt;Aplica los estados LP y gobierna los drivers. Durante esta etapa: CLK y D1 en LP-11; drivers HS sin conducir.&lt;br&gt;&lt;br&gt;Autoriza tras preparar LP y cumplir el reposo aplicable. Conserva el enlace asignado hasta terminar. estado_D0 no habilita por sí solo las salidas eléctricas." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f4f5f7;strokeColor=#a5adba;" vertex="1" parent="1">
          <mxGeometry x="1190" y="530" width="440" height="315" as="geometry" />
        </mxCell>
        <mxCell id="nota-tiempos" value="&lt;b&gt;TIEMPOS PROPUESTOS, NO CERTIFICADOS&lt;/b&gt;&lt;br&gt;&lt;br&gt;40 MHz → periodo de 25 ns.&lt;br&gt;Cada intervalo de 100 ns = 4 periodos completos. Contadores/habilitaciones sobre 40 MHz; sin relojes derivados.&lt;br&gt;&lt;br&gt;100 ns da margen sobre la referencia clásica T_LPX = 50 ns. Mark + Space = 200 ns: 5 Mbit/s.&lt;br&gt;&lt;br&gt;Reposo inicial: 200 µs = 8000 periodos, considerado por D-PHY antes del permiso inicial; no se repite por cada paquete. Referencia: T_INIT = 100 µs.&lt;br&gt;&lt;br&gt;No sustituye los requisitos del panel ni valida niveles, flancos o conformidad LPDT." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" vertex="1" parent="1">
          <mxGeometry x="1190" y="890" width="440" height="370" as="geometry" />
        </mxCell>
        <mxCell id="nota-bits" value="&lt;b&gt;UN BIT = MARK + SPACE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bit 1: 10 → 00. Bit 0: 01 → 00.&lt;br&gt;indice_bit recorre 0 → 7: LSB primero.&lt;br&gt;&lt;br&gt;Al iniciar Space: evaluar los índices del Mark terminado y preparar el siguiente dato en esa misma frontera, sin ciclos extra.&lt;br&gt;&lt;br&gt;Space: 100 ns desde su inicio, no desde la carga. Después se emite el siguiente Mark con registros estables.&lt;br&gt;&lt;br&gt;Sin bits UART ni LP-11 entre bytes." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1320" width="440" height="305" as="geometry" />
        </mxCell>
        <mxCell id="ext-almacen" value="&lt;b&gt;EXTERNO · ALMACÉN DEL PAQUETE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Motor → Almacén: posición del byte requerido.&lt;br&gt;Almacén → Motor: contenido de ese byte.&lt;br&gt;&lt;br&gt;El byte siguiente debe estar disponible antes del flanco que inicia el último Space del byte anterior, para cargarlo en ese flanco.&lt;br&gt;&lt;br&gt;La lectura se prepara con antelación; no se supone latencia cero. Memoria, interfaz y latencia pendientes. Tener el paquete completo no garantiza su suministro temporal ni permite pausas arbitrarias." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f4f5f7;strokeColor=#a5adba;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1820" width="440" height="295" as="geometry" />
        </mxCell>
        <mxCell id="nota-ejemplo" value="&lt;b&gt;EJEMPLO DE RECORRIDO · NO FIJO EN EL MOTOR&lt;/b&gt;&lt;br&gt;&lt;br&gt;cantidad_bytes = 4.&lt;br&gt;Almacén: [0]=05, [1]=01, [2]=00, [3]=10.&lt;br&gt;Primero selector 87; después posiciones 0, 1, 2 y 3. Al terminar posición 3: 3 + 1 == 4 → salida.&lt;br&gt;&lt;br&gt;Bytes codificados: &lt;b&gt;87 05 01 00 10&lt;/b&gt;.&lt;br&gt;87, LSB primero: &lt;b&gt;1 1 1 0 0 0 0 1&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Entrada: 0,4 µs; cinco bytes: 8 µs; salida: 0,1 µs. Total nominal: &lt;b&gt;8,5 µs = 340 ciclos&lt;/b&gt;, sin pausas, reposo previo ni espera de ejecución.&lt;br&gt;&lt;br&gt;El motor no interpreta DCS ni calcula ECC/CRC. 0x87 pertenece a D-PHY, no al paquete DSI." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fontColor=#344563;fillColor=#f3f7fb;strokeColor=#bccbdc;" vertex="1" parent="1">
          <mxGeometry x="1190" y="2170" width="440" height="370" as="geometry" />
        </mxCell>
        <mxCell id="nota-salida" value="&lt;b&gt;SALIDA: 00 → 10 → 11&lt;/b&gt;&lt;br&gt;Parte del último Space. El 10 de salida no es otro bit: le sigue 11, no Space." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#42526e;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="2690" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="nota-fin" value="&lt;b&gt;FIN LOCAL ≠ CONFIRMACIÓN DEL PANEL&lt;/b&gt;&lt;br&gt;terminado informa del regreso a LP-11; no confirma recepción ni ejecución. El control superior gestiona la espera del comando. La espera posterior a Software Reset sigue pendiente y debe ser configurable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=17;fontColor=#42526e;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="2580" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="nota-ocupado" value="Solo se acepta estando libre, con solicitud y permiso válidos. Mientras ocupado = 1 no se acepta otra operación. aceptado y terminado son avisos de evento; su codificación temporal queda para el diseño de la interfaz." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#42526e;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1650" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="pie" value="Lectura: procesos azules · decisiones amarillas · contexto externo gris. Las cajas externas no forman parte de la secuencia.&lt;br&gt;Base documental: AGENTS.md y README.md, sección 5. No se incluyen lecturas LP, BTA ni confirmaciones del receptor." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#5e6c84;" vertex="1" parent="1">
          <mxGeometry x="180" y="3040" width="940" height="50" as="geometry" />
        </mxCell>

        <mxCell id="f-inicio" edge="1" parent="1" source="inicio" target="reposo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-reposo" edge="1" parent="1" source="reposo" target="solicitud" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-solicitud-si" value="Sí" edge="1" parent="1" source="solicitud" target="permiso" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;fontColor=#344563;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-solicitud-no" value="No" edge="1" parent="1" source="solicitud" target="reposo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#344563;strokeWidth=2;fontSize=17;fontColor=#344563;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="430" /><mxPoint x="550" y="290" /></Array></mxGeometry></mxCell>
        <mxCell id="f-permiso-si" value="Sí" edge="1" parent="1" source="permiso" target="aceptar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;fontColor=#344563;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell>
