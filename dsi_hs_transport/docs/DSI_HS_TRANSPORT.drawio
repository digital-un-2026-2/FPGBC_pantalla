<mxfile host="app.diagrams.net"><diagram name="FLUJO" id="hs-flow"><mxGraphModel page="1" pageWidth="1600" pageHeight="1700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="DSI HS TRANSPORT — DIAGRAMA DE FLUJO&lt;br&gt;Un paquete completo → una operación HS" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffffff;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="20" width="1000" height="70" /></mxCell><mxCell id="init" value="Inicio / reset coordinado&lt;br&gt;Vaciar ocupación y limpiar error" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="130" width="320" height="75" /></mxCell><mxCell id="receive" value="¿Palabra aceptada?&lt;br&gt;valid ∧ ready" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="250" width="320" height="110" /></mxCell><mxCell id="mask" value="¿keep=11, o&lt;br&gt;keep=01 con last=1?" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="410" width="320" height="110" /></mxCell><mxCell id="store" value="Guardar datos y máscara&lt;br&gt;Incrementar ocupación" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="570" width="320" height="75" /></mxCell><mxCell id="last" value="¿last=1?" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="700" width="320" height="100" /></mxCell><mxCell id="full" value="¿Se agotó la capacidad?" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="870" width="320" height="100" /></mxCell><mxCell id="fault" value="Registrar primera causa&lt;br&gt;error=1; hs_error=1&lt;br&gt;Bloquear entrada, petición y salida" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#f8cecc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="1110" width="320" height="100" /></mxCell><mxCell id="reset" value="¿Reset coordinado?" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#f8cecc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="1280" width="320" height="100" /></mxCell><mxCell id="prime" value="Cerrar entrada y precargar&lt;br&gt;la primera palabra" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="130" width="320" height="75" /></mxCell><mxCell id="req" value="Solicitar enlace HS&lt;br&gt;hs_req=1; hs_data_ready=1" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="260" width="320" height="75" /></mxCell><mxCell id="accepted" value="¿hs_req_ready=1?" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="390" width="320" height="100" /></mxCell><mxCell id="grant" value="Retirar hs_req&lt;br&gt;¿hs_grant=1?" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="550" width="320" height="110" /></mxCell><mxCell id="send" value="Entregar palabra precargada&lt;br&gt;valid=1; consumir en posedge" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="720" width="320" height="75" /></mxCell><mxCell id="end" value="¿Última palabra?" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="850" width="320" height="100" /></mxCell><mxCell id="next" value="Precargar siguiente palabra&lt;br&gt;Continuar en el próximo ciclo&lt;br&gt;sin burbujas" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="720" width="280" height="100" /></mxCell><mxCell id="done" value="Retirar valid y data_ready&lt;br&gt;Emitir hs_done durante un ciclo" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="1010" width="320" height="75" /></mxCell><mxCell id="complete" value="¿hs_complete=1?" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="1150" width="320" height="100" /></mxCell><mxCell id="release" value="Vaciar ocupación&lt;br&gt;Habilitar siguiente paquete" style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="1320" width="320" height="75" /></mxCell><mxCell id="note" value="REGLAS GLOBALES&lt;br&gt;Reset tiene prioridad y vuelve al inicio.&lt;br&gt;phy_abort, o pérdida de grant durante envío: ir a FALLO.&lt;br&gt;Conservar la primera causa hasta reset.&lt;br&gt;Errores: capacidad / máscara / aborto.&lt;br&gt;Sin timeout; keep=01 no autoriza relleno físico.&lt;br&gt;Reloj único; diagrama lógico, sin señalización eléctrica." style="whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2cc;strokeColor=#365574;strokeWidth=2;rounded=1;" vertex="1" paren