"geometry" x="1500" y="1220" width="280" height="55" /></mxCell><mxCell id="dp-7-0" value="FAULT / 111" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1275" width="300" height="55" /></mxCell><mxCell id="dp-7-1" value="0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="350" y="1275" width="280" height="55" /></mxCell><mxCell id="dp-7-2" value="0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="630" y="1275" width="280" height="55" /></mxCell><mxCell id="dp-7-3" value="0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="910" y="1275" width="310" height="55" /></mxCell><mxCell id="dp-7-4" value="0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1275" width="280" height="55" /></mxCell><mxCell id="dp-7-5" value="0" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;fontSize=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="1275" width="280" height="55" /></mxCell><mxCell id="exception" value="PRIME es la selección de dirección sin enmascarar en el RTL: si rst/phy_abort se activa durante PRIME, SEL_M0 puede seguir en 1;&lt;br&gt;READ_EN=0 impide capturar. busy y error no se enmascaran con reset: reflejan el estado previo hasta el posedge de reset." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1350" width="1770" height="85" /></mxCell><mxCell id="priority" value="&lt;b&gt;3. MEMORIA Y PRIORIDADES EN ↑CLK&lt;/b&gt;&lt;br&gt;STATE[3] + DONE[1] + ERROR_CODE[2] = 6 bits de UC. No hay ACTION ni captura en negedge.&lt;br&gt;1) rst → FILL, DONE=0 y CAUSA=00; reset coordinado de toda la ruta.&lt;br&gt;2) Si ya está en FAULT → conservar estado y causa, DONE=0.&lt;br&gt;3) phy_abort → FAULT/11; después errores de fase (máscara 10, capacidad 01, pérdida grant 11).&lt;br&gt;4) Operación normal según arcos; código 111 → FAULT/11. done = E &amp;amp; DONE; error_code = CAUSA." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1460" width="1770" height="180" /></mxCell><mxCell id="timing" value="&lt;b&gt;4. SECUENCIA TEMPORAL · paquete de dos palabras&lt;/b&gt;&lt;br&gt;N: aceptar última palabra → PRIME. N+1: Q←RAM[0] → REQUEST.&lt;br&gt;H: handshake hs_req/ready → WAIT_GRANT. G: observar hs_grant → SEND (Q aún contiene palabra 0).&lt;br&gt;G+1: consumir palabra 0; Q←RAM[1], INDEX←1. G+2: consumir última → WAIT_COMPLETE, DONE←1.&lt;br&gt;G+3: árbitro observa hs_done; DONE←0. Tras hs_complete: limpiar COUNT/INDEX → FILL.&lt;br&gt;El receptor consume en posedge; valid no tiene ready. done no acredita recepción del panel ni liberación física del enlace." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1690" width="1770" height="195" /></mxCell></root></mxGraphModel></diagram></mxfile>