+1]" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;"><mxGeometry as="geometry" x="1350" y="1275" width="440" height="100" /></mxCell><mxCell id="uc" value="&lt;b&gt;UC&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recibe FULL, OCCUPIED,&lt;br&gt;FINAL_WORD, MASK_OK.&lt;br&gt;&lt;br&gt;Emite WRITE_EN, READ_EN,&lt;br&gt;PRIME, ADVANCE, CLEAR_COUNT.&lt;br&gt;&lt;br&gt;Recibe valid/last, ready/grant,&lt;br&gt;complete, phy_abort, clk y rst.&lt;br&gt;&lt;br&gt;Genera handshakes, busy,&lt;br&gt;valid, done, error y código." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;"><mxGeometry as="geometry" x="1350" y="880" width="440" height="350" /></mxCell><mxCell id="e45" value="COUNT−1 [A+1]" edge="1" parent="1" source="sub1" target="finalin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=18;strokeColor=#344563;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=1;entryX=1;entryY=1;dashed=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1300" y="1400" /><mxPoint x="400" y="1400" /></Array></mxGeometry></mxCell><mxCell id="cond" value="{FULL, OCCUPIED,&lt;br&gt;FINAL_WORD, MASK_OK} [4]" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="930" y="1570" width="360" height="80" /></mxCell><mxCell id="e47" value="[4]" edge="1" parent="1" source="cond" target="uc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=18;strokeColor=#344563;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.85;dashed=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1840" y="1610" /><mxPoint x="1840" y="1177" /></Array></mxGeometry></mxCell><mxCell id="footer" value="&lt;b&gt;Memoria predeterminada:&lt;/b&gt; 2048×18 + Q[18] + COUNT[12] + INDEX[11] = 36 905 bits de datapath.&lt;br&gt;La memoria de UC se cuenta aparte: STATE[3], DONE[1], ERROR_CODE[2] según el RTL actual. No se duplican en datapath.&lt;br&gt;FULL se interpreta antes de escribir, únicamente durante recepción. FINAL_WORD solo tiene significado con hs_word_valid.&lt;br&gt;Σ2 y las expresiones de condición son combinacionales. La página representa conexiones nombradas; las condiciones se agrupan en el bus [4] hacia UC." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="50" y="1680" width="1770" height="120" /></mxCell></root></mxGraphModel></diagram><diagram name="FSM · Transiciones"><mxGraphModel page="1" pageWidth="1750" pageHeight="2000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;DSI_HS_TRANSPORT · FSM · TRANSICIONES&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="25" width="1640" height="70" /></mxCell><mxCell id="sub" value="7 estados · codificación binaria de 3 bits · ↑clk, 40 MHz en simulación.&lt;br&gt;Arcos: condición / acción en ese posedge. Se aplican después de reset y phy_abort; la primera causa de fallo se conserva." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="100" width="1640" height="85" /></mxCell><mxCell id="fill" value="FILL · 000&lt;br&gt;&lt;br&gt;Recibir palabras&lt;br&gt;ready=1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;ellipse;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="160" y="300" width="290" height="210" /></mxCell><mxCell id="prime" value="PRIME · 001&lt;br&gt;&lt;br&gt;Leer RAM[0]&lt;br&gt;READ_EN=1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;ellipse;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="300" width="290" height="210" /></mxCell><mxCell id="request" value="REQUEST · 010&lt;br&gt;&lt;br&gt;hs_req=1&lt;br&gt;hs_data_ready=1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;ellipse;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="300" width="290" height="210" /></mxCell><mxCell id="complete" value="WAIT_COMPLETE · 101&lt;br&gt;&lt;br&gt;Esperar enlace libre&lt;br&gt;sin entrada ni salida" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;ellipse;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="160" y="900" width="290" height="210" /></mxCell><mxCell id="send" value="SEND · 100&lt;br&gt;&lt;br&gt;valid=hs_grant&lt;br&gt;una palabra / ciclo" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;ellipse;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="900" width="290" height="210" /></mxCell><mxCell id="grant" value="WAIT_GRANT · 011&lt;br&gt;&lt;br&gt;hs_req=0&lt;br&gt;hs_data_ready=1" style="html=1;whiteSpace=wrap;fontFamily=Helve