ource="accepted" target="accepted"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="780" y="440" /><mxPoint x="780" y="365" /><mxPoint x="1010" y="365" /></Array></mxGeometry></mxCell><mxCell id="e35" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="accepted" target="grant"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e36" value="No: esperar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="grant" target="grant"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="780" y="605" /><mxPoint x="780" y="525" /><mxPoint x="1010" y="525" /></Array></mxGeometry></mxCell><mxCell id="e37" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="grant" target="send"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="send" target="end"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e39" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="end" target="next"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1390" y="900" /></Array></mxGeometry></mxCell><mxCell id="e40" value="Próximo ciclo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="next" target="send"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e41" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="end" target="done"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="done" target="complete"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e43" value="No: esperar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="complete" target="complete"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="780" y="1200" /><mxPoint x="780" y="1125" /><mxPoint x="1010" y="1125" /></Array></mxGeometry></mxCell><mxCell id="e44" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="complete" target="release"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e45" value="Nuevo paquete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="release" target="receive"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="690" y="1358" /><mxPoint x="690" y="1060" /><mxPoint x="610" y="1060" /><mxPoint x="610" y="305" /></Array></mxGeometry></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="fault" target="reset"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e47" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="reset" target="reset"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="80" y="1330" /><mxPoint x="80" y="1255" /><mxPoint x="300" y="1255" /></Array></mxGeometry></mxCell><mxCell id="e48" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#365574;strokeWidth=2;" edge="1" parent="1" source="reset" target="init"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="10" y="1330" /><mxPoint x="10" y="168" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="DATAPATH · Almacenamiento"><mxGraphModel page="1" pageWidth="1800" pageHeight="1350"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;DSI_HS_TRANSPORT · DATAPATH 1/2 · ALMACENAMIENTO Y LECTURA&lt;/b&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=30;"><mxGeometry as="geometry" x="50" y="25" width="1680" height="70" /></mxCell><mxCell id="sub" value="Bloques sin relleno · buses [n] · controles discontinuos · ↑clk, 40 MHz en simulación.&lt;br&gt;W = BUFFER_WORDS; A = max(1, ceil(log2(W))). Predeterminado: W=2048, A=11." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="50" y="100" width="1650" height="80" /></mxCell><mxCell id="input" value="tx_word_data [16]&lt;br&gt;tx_word_keep [2]" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="50" y="230" width="250" height="90" /></mxCell><mxCell id="join" value="CONCATENACIÓN [18]&lt;br&gt;{keep[1:0], data[15:0]}" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;"><mxGeometry as="geometry" x="370" y="230" width="290" height="90" /></mxCell><mxCell id="ram" value="&lt;b&gt;MEMORIA · W × 18&lt;/b&gt;&lt;br&gt;&lt;br&gt;WR_DATA [18] → memoria&lt;br&gt;WR_ADDR [A]&lt;br&gt;RD_ADDR [A]&lt;br&gt;&lt;br&gt;WE [1] · ↑CLK&lt;br&gt;Sin reset de contenido" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;"><mxGeometry as="geometry" x="780" y="220" width="320" height="340" /></mxCell><mxCell id="q" value="&lt;b&gt;Q [18]&lt;/b&gt;&lt;br&gt;&lt;br&gt;Registro de lectura&lt;br&gt;LD = READ_EN&lt;br&gt;↑CLK · sin reset&lt;br&gt;LD=0: conservar Q" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;"><mxGeometry as="geometry" x="1220" y="245" width="240" height="220" /></mxCell><mxCell id="out" value="hs_word_data = Q[15:0] [16]&lt;br&gt;hs_word_keep = Q[17:16] [2]&lt;br&gt;Solo significativos con valid=1." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="1510" y="260" width="270" height="170" /></mxCell><mxCell id="waddr" value="COUNT[A−1:0] [A]&lt;br&gt;desde contador, página 2" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="390" y="410" width="300" height="80" /></mxCell><mxCell id="zero" value="0 [A]" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="70" y="840" width="180" height="60" /></mxCell><mxCell id="inc" value="INDEX + 1 [A]&lt;br&gt;desde sumador, página 2" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="70" y="690" width="260" height="80" /></mxCell><mxCell id="mux" value="&lt;b&gt;M0&lt;/b&gt;&lt;br&gt;2:1&lt;br&gt;[A]" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;shape=mxgraph.electrical.abstract.mux2;"><mxGeometry as="geometry" x="430" y="670" width="100" height="260" /></mxCell><mxCell id="sel" value="SEL_M0 = PRIME [1]&lt;br&gt;1 → dirección 0&lt;br&gt;0 → INDEX+1" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="350" y="1030" width="370" height="100" /></mxCell><mxCell id="uc" value="&lt;b&gt;UC · controles combinacionales&lt;/b&gt;&lt;br&gt;&lt;br&gt;WRITE_EN [1] · READ_EN [1] · PRIME [1]&lt;br&gt;WRITE_EN: entrada aceptada y máscara válida&lt;br&gt;READ_EN: precarga, o envío no final" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;"><mxGeometry as="geometry" x="850" y="800" width="650" height="170" /></mxCell><mxCell id="clk" value="clk [1] · ↑&lt;br&gt;común a RAM, Q y contadores" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="1100" y="620" width="400" height="75" /></mxCell><mxCell id="note" value="&lt;b&gt;Lectura síncrona, un único almacenamiento de salida:&lt;/b&gt; Q representa el registro de lectura de la RAM; no se añade otro registro después de él.&lt;br&gt;En PRIME se lee dirección 0. Tras grant, cada flanco consume Q y carga la dirección siguiente si no es la última.&lt;br&gt;RAM y Q no se borran: reset invalida el paquete al limpiar COUNT/INDEX y la fase de UC. last se reconstruye desde longitud; no se almacena por palabra.&lt;br&gt;Datos [7:0] → D0; [15:8] → D1. keep=01 indica que solo D0 es válido; no define relleno ni terminación eléctrica." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;text;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry as="geometry" x="50" y="1170" width="1680" height="150" /></mxCell><mxCell id="e19" value="[18]" edge="1" parent="1" source="input" target="join" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=18;strokeColor=#344563;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e20" value="[18]" edge="1" parent="1" source="join" target="ram" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=18;strokeColor=#344563;strokeWidth