        </mxCell>
        <mxCell id="markers" parent="1" value="MARCAS DEL BYTE OFRECIDO&#10;L = (x = WIDTH−1) ∧ (componente = B)&#10;tx_line_last = tx_byte_valid ∧ L&#10;tx_frame_last = tx_line_last ∧ (y = HEIGHT−1)&#10;Con ready=0: conservar byte y marcas." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;text;fillColor=none;strokeColor=none;align=left;spacing=0;">
          <mxGeometry x="1250" y="1190" width="420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="contract" parent="1" value="CONTRATO TEMPORAL&#10;clk único; actualización en posedge.&#10;Solo BYTE_FIRE avanza el recorrido.&#10;Decisiones sobre el byte antes del flanco.&#10;Sin burbujas internas entre píxeles/líneas.&#10;frame_done: pulso tras último BYTE_FIRE.&#10;No aceptar inicio al entregar el último byte.&#10;start_valid=1 permite repetir sin CPU." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;text;fillColor=none;strokeColor=none;align=left;spacing=0;">
          <mxGeometry x="1250" y="1470" width="420" height="280" as="geometry" />
        </mxCell>
        <mxCell id="limits" parent="1" value="FRONTERA DEL MÓDULO&#10;Salida: bytes RGB y marcas lógicas.&#10;Descriptor por línea, ECC/CRC, sincronismo,&#10;blanking y transporte: módulos externos.&#10;No fija fps, bitrate ni porches del LCD.&#10;Sin RISC-V ni framebuffer." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;text;fillColor=none;strokeColor=none;align=left;spacing=0;">
          <mxGeometry x="1250" y="2230" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" value="DSI_TEST_PATTERN · PROPUESTA · 2026-11-09 | Flujo: pág. 1; datapath: págs. 2–3; FSM: pág. 4. Sin RTL. Contrato en flujo.md." vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;text;fillColor=none;strokeColor=none;align=left;spacing=0;fontSize=16;">
