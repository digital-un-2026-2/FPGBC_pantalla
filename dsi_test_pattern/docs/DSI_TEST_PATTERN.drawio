        <mxCell id="color-7" parent="1" value="7   Negro   RGB = 000000" vertex="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;rounded=1;arcSize=12;fillColor=#eaf2fc;strokeColor=#5b7fa6;rounded=0;fontSize=18;align=left;">
