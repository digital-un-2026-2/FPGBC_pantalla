        </mxCell>
        <mxCell id="ops" value="INIT=START_FIRE; STEP_COMP=BYTE_FIRE &amp; !IS_B;&#10;STEP_PIXEL=BYTE_FIRE &amp; IS_B &amp; !X_END;&#10;STEP_LINE=BYTE_FIRE &amp; IS_B &amp; X_END &amp; !Y_END;&#10;FINISH=BYTE_FIRE &amp; IS_B &amp; X_END &amp; Y_END → UC (no carga X/Y/C)." vertex="1" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#172b4d;fillColor=none;strokeColor=#344563;strokeWidth=2;rounded=0;align=center;verticalAlign=middle;spacing=8;text;strokeColor=none;align=left;spacing=0;fontSize=19;">
