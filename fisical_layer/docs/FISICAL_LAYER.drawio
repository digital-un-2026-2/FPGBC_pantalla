        <mxCell id="dp-foot" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontSize=16;" value="* Señales nuevas. liberar_d0 = 0 en panel_init_top; lecturas sin receptor ni BTA. HS: seis TBUF deshabilitados permanentemente.&lt;br&gt;preparar_lp, rst_motor y lp_preparada: secuenciador; estado_D0: motor. Reset completo y D0 en LP-11 ANTES de habilitar.&lt;br&gt;RTL y pruebas con modelos ideales; sin validación eléctrica. Legalidad de E/S, constraints y estado real durante configuración pendientes." vertex="1">
          <mxGeometry height="80" width="1490" x="60" y="900" as="geometry" />
        </mxCell>
        <mxCell id="dp-e1" edge="1" parent="1" source="dp-rst" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="dp-not-rst">
