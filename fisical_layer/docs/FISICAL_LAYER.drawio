<mxfile host="Electron" pages="2">
  <diagram id="lp-flujo" name="INTERFAZ_FISICA_LP">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" parent="1" style="text;html=1;whiteSpace=wrap;align=center;fontSize=22;" value="INTERFAZ FÍSICA LP — FLUJO DEL RTL" vertex="1">
          <mxGeometry height="40" width="750" x="270" y="20" as="geometry" />
        </mxCell>
        <mxCell id="inicio" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.start_1;whiteSpace=wrap;" value="INTERFAZ&lt;br&gt;LP" vertex="1">
          <mxGeometry height="60" width="140" x="560" y="90" as="geometry" />
        </mxCell>
        <mxCell id="invariantes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="SIEMPRE&lt;br&gt;Drivers HS 112–117 explícitamente deshabilitados&lt;br&gt;d0_pad_p = IOBUF_P.O; d0_pad_n = IOBUF_N.O" vertex="1">
          <mxGeometry height="80" width="460" x="400" y="190" as="geometry" />
        </mxCell>
        <mxCell id="deshabilitar" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿rst_motor = 1&lt;br&gt;o preparar_lp = 0?" vertex="1">
          <mxGeometry height="100" width="260" x="500" y="320" as="geometry" />
        </mxCell>
        <mxCell id="off" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="RESET / DESHABILITAR&lt;br&gt;d0_oen = 1; lp_aux_oen = 1&lt;br&gt;Liberar D0, CLK y D1&lt;br&gt;lp_preparada = 0" vertex="1">
          <mxGeometry height="110" width="320" x="60" y="320" as="geometry" />
        </mxCell>
        <mxCell id="aux" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="HABILITAR CLK Y D1 EN LP&lt;br&gt;Datos CLK_P/N = 11; datos D1_P/N = 11&lt;br&gt;lp_aux_oen = 0" vertex="1">
          <mxGeometry height="80" width="380" x="440" y="470" as="geometry" />
        </mxCell>
        <mxCell id="liberar" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" value="¿liberar_d0 = 1?&lt;br&gt;(entrada propuesta)" vertex="1">
          <mxGeometry height="90" width="240" x="510" y="600" as="geometry" />
        </mxCell>
        <mxCell id="escuchar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="LIBERAR / ESCUCHAR D0&lt;br&gt;d0_oen = 1 para ambos IOBUF&lt;br&gt;Lectura de ambos pads disponible&lt;br&gt;lp_preparada = 0&lt;br&gt;CLK y D1 permanecen en LP-11" vertex="1">
          <mxGeometry height="130" width="320" x="60" y="590" as="geometry" />
        </mxCell>
        <mxCell id="transmitir" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;" value="D0 SIGUE DIRECTAMENTE AL MOTOR&lt;br&gt;IOBUF_P.I = estado_D0[1]&lt;br&gt;IOBUF_N.I = estado_D0[0]&lt;br&gt;d0_oen = 0; lp_preparada = 1&lt;br&gt;Reposo LP-11 y transmisión los genera el motor" vertex="1">
          <mxGeometry height="130" width="420" x="420" y="780" as="geometry" />
        </mxCell>
        <mxCell id="nota_evaluacion" parent="1" style="text;html=1;whiteSpace=wrap;align=center;fontSize=15;fontStyle=1;" value="DECISIONES COMBINACIONALES, NO ESTADOS&lt;br&gt;Reevaluar ante cambios de entradas. Sin FSM, reloj ni contadores propios.&lt;br&gt;Las salidas de cada rama se aplican junto con las condiciones comunes anteriores." vertex="1">
          <mxGeometry height="90" width="840" x="240" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="nota_interfaz" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="SEÑALES REUTILIZADAS&lt;br&gt;Entradas: preparar_lp y rst_motor del secuenciador; estado_D0 del motor.&lt;br&gt;Salida: lp_preparada hacia el secuenciador.&lt;br&gt;rst_motor incluye reset global y aborto por fallo.&lt;br&gt;&lt;br&gt;INTERFAZ NUEVA IMPLEMENTADA&lt;br&gt;liberar_d0: entrada fijada a 0 en panel_init_top, sin controlador BTA.&lt;br&gt;d0_pad_p/n: lecturas de los dos IOBUF.&lt;br&gt;d0_oen y lp_aux_oen: controles internos; 0 conduce, 1 libera.&lt;br&gt;hs_oen = 111111 conectado a seis TBUF.&lt;br&gt;Sin modo_d0, ocupado, mux ni error físico propio." vertex="1">
          <mxGeometry height="360" width="420" x="1120" y="90" as="geometry" />
        </mxCell>
        <mxCell id="nota_contrato" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="COORDINACIÓN OBLIGATORIA&lt;br&gt;Reset motor: cubrir posedge y negedge posterior. Antes de habilitar LP, estado_D0 debe estar inicializado en LP-11.&lt;br&gt;No hay mux protector: el motor se conecta directamente a los IOBUF.&lt;br&gt;En FALLO, rst_motor = 1 deshabilita las salidas aunque preparar_lp siga a 1.&lt;br&gt;No usar permiso_arranque como OEN: retirarlo no aborta.&lt;br&gt;lp_preparada solo refleja habilitación interna, no recepción ni alimentación estable.&lt;br&gt;Reposo inicial, esperas y timeouts siguen en el secuenciador." vertex="1">
          <mxGeometry height="340" width="420" x="1120" y="480" as="geometry" />
        </mxCell>
        <mxCell id="nota_escucha" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="ESCUCHA: RESERVA PARA EL FUTURO&lt;br&gt;No ejecuta BTA ni decodifica respuestas.&lt;br&gt;Coordinar detener solicitudes y terminar/abortar envío antes de liberar. Una liberación durante envío lo trunca.&lt;br&gt;No retirar liberar_d0 sin autorización externa para volver a conducir: no hay recuperación automática ni detector de propiedad del enlace.&lt;br&gt;El secuenciador actual trata lp_preparada = 0 como fallo desde REPOSO_INICIAL hasta LISTO. Escucha aún no integrada." vertex="1">
          <mxGeometry height="280" width="420" x="1120" y="850" as="geometry" />
        </mxCell>
        <mxCell id="nota_electrica" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;" value="MAPA Y VALIDACIÓN PENDIENTE — GW2AR-LV18EQ144PC8/I7&lt;br&gt;D0 P/N = 122/123, dos IOBUF y 100 Ω por rama. CLK P/N = 126/128; D1 P/N = 124/125.&lt;br&gt;HS 112–117: configurar explícitamente salidas deshabilitadas; no basta dejarlas sin usar.&lt;br&gt;BANK0 = 1,21 V medidos; LVCMOS12 candidato, no validación D-PHY.&lt;br&gt;Revisar niveles, corrientes, flancos, pulls, keeper, terminaciones, timing y comportamiento durante configuración.&lt;br&gt;No se diseñan BTA, receptor LP, paquetes, vídeo HS ni backlight. No implementar ni probar en placa a partir de este dibujo sin revisión." vertex="1">
          <mxGeometry height="190" width="1300" x="240" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="inicio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="invariantes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="invariantes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="deshabilitar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="deshabilitar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="off" value="Sí">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="deshabilitar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="aux" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="aux" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="liberar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="liberar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="escuchar" value="Sí">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="liberar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="transmitir" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QXiJJQsXjHay4Z0DCxPz-1" edge="1" parent="1" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1320" y="1070" as="sourcePoint" />
            <mxPoint x="1370" y="1020" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
