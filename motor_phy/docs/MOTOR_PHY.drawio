<mxfile host="app.diagrams.net" pages="3">
  <diagram id="phy-flujo" name="Flujo del motor PHY">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2480" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="canvas" value="" style="fillColor=#ffffff;strokeColor=none;connectable=0;" vertex="1" parent="1"><mxGeometry width="1700" height="2480" as="geometry"/></mxCell>
        <mxCell id="titulo" value="&lt;b&gt;MOTOR PHY · DIAGRAMA DE FLUJO&lt;/b&gt;" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=28;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="1540" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitulo" value="Estados LP del motor → habilitación y pads. DISEÑO PROPUESTO: aún sin RTL ni validación eléctrica.&lt;br&gt;← asignación · == comparación · [n] anchura. Una caja no equivale necesariamente a un ciclo ni a un estado." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#42526e;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="1540" height="65" as="geometry"/></mxCell>
        <mxCell id="inicio" value="&lt;b&gt;INICIO&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fillColor=#e8edf4;strokeColor=#5c708a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="180" height="45" as="geometry"/></mxCell>
        <mxCell id="aislar" value="&lt;b&gt;AISLAR LAS SALIDAS&lt;/b&gt;&lt;br&gt;EN_LP ← 0; LISTO_CTRL ← 0&lt;br&gt;SEL_D0 ← 0; RST_T ← 1; INC_T ← 0&lt;br&gt;LP sin conducir; HS siempre sin conducir" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="265" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="reset" value="&lt;b&gt;¿rst == 0?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="440" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="error-inicial" value="&lt;b&gt;¿ERROR == 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="585" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="peticion" value="&lt;b&gt;¿preparar_lp == 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="740" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="precargar" value="&lt;b&gt;PREPARAR DATOS SIN CONDUCIR&lt;/b&gt;&lt;br&gt;SEL_D0 ← 0 → D0 interno = 11&lt;br&gt;D1 interno = CLK interno = 11&lt;br&gt;EN_LP ← 0; RST_T ← 1&lt;br&gt;Conservar un ciclo de control" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="900" width="420" height="145" as="geometry"/></mxCell>
        <mxCell id="habilitar" value="&lt;b&gt;HABILITAR LP Y CONTAR&lt;/b&gt;&lt;br&gt;EN_LP ← 1; SEL_D0 ← 0&lt;br&gt;RST_T ← 0; INC_T ← NOT Z_T&lt;br&gt;D0 = D1 = CLK = LP-11&lt;br&gt;LISTO_CTRL ← 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="1100" width="420" height="145" as="geometry"/></mxCell>
        <mxCell id="fin-t" value="&lt;b&gt;¿Z_T == 1?&lt;/b&gt;&lt;br&gt;TIEMPO == T_HABILITACION" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="1300" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="servir" value="&lt;b&gt;APLICAR LOS ESTADOS LP&lt;/b&gt;&lt;br&gt;EN_LP ← 1; LISTO_CTRL ← 1&lt;br&gt;SEL_D0 ← 1; INC_T ← 0&lt;br&gt;D0P/N ← estado_D0[1:0]&lt;br&gt;D1 y CLK permanecen en LP-11" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=18;fillColor=#eaf2fc;strokeColor=#5b7fa6;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="1480" width="420" height="145" as="geometry"/></mxCell>
        <mxCell id="reset-servicio" value="&lt;b&gt;¿rst == 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="1680" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="error-servicio" value="&lt;b&gt;¿ERROR == 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="1840" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="mantener" value="&lt;b&gt;¿preparar_lp == 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="2010" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="fallo" value="&lt;b&gt;F · ENCLAVAR FALLO Y AISLAR&lt;/b&gt;&lt;br&gt;EN_LP ← 0; LISTO_CTRL ← 0&lt;br&gt;SEL_D0 ← 0; RST_T ← 1; INC_T ← 0&lt;br&gt;LP y HS sin conducir; no terminar paquete&lt;br&gt;FALLO_ACTIVO ← 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fcebea;strokeColor=#b85450;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1190" y="1800" width="440" height="155" as="geometry"/></mxCell>
        <mxCell id="reset-fallo" value="&lt;b&gt;¿rst == 1?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fillColor=#fff4d6;strokeColor=#b69a50;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1270" y="2020" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="contexto" value="&lt;b&gt;EXTERNO · SECUENCIADOR INIT&lt;/b&gt;&lt;br&gt;&lt;br&gt;→ preparar_lp, fallo_init&lt;br&gt;← lp_preparada&lt;br&gt;&lt;br&gt;Conserva las esperas de 9/65 ms&lt;br&gt;y el reposo inicial de 200 µs.&lt;br&gt;No retirar preparar_lp al finalizar:&lt;br&gt;el PHY debe conservar LP-11." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fillColor=#f4f5f7;strokeColor=#a5adba;" vertex="1" parent="1"><mxGeometry x="1190" y="265" width="440" height="270" as="geometry"/></mxCell>
        <mxCell id="reglas" value="&lt;b&gt;REGLAS GLOBALES · TODAS LAS FASES&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Reset → aislar.&lt;br&gt;2. ERROR o FALLO enclavado → F.&lt;br&gt;3. Retirar preparar_lp → aislar.&lt;br&gt;&lt;br&gt;ERROR = fallo_init OR NOT ESTADO_VALIDO.&lt;br&gt;Inhibir OE y lp_preparada sin esperar&lt;br&gt;al cambio de estado registrado.&lt;br&gt;&lt;br&gt;La rama F se aplica también durante&lt;br&gt;preparación y conteo. Solo reset sale de F." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fillColor=#f3f7fb;strokeColor=#bccbdc;" vertex="1" parent="1"><mxGeometry x="1190" y="800" width="440" height="330" as="geometry"/></mxCell>
        <mxCell id="tiempo" value="&lt;b&gt;CONTADOR, NO OTRO MOTOR LPDT&lt;/b&gt;&lt;br&gt;&lt;br&gt;T_HABILITACION ≥ 1 ciclo de 40 MHz.&lt;br&gt;Propuesta inicial: 4 ciclos = 100 ns.&lt;br&gt;Valor configurable, no medido en el LCD.&lt;br&gt;&lt;br&gt;La precarga selecciona constantes:&lt;br&gt;no requiere un registro de datos D0.&lt;br&gt;RST_T prepara el contador una sola vez;&lt;br&gt;el bucle no vuelve a ponerlo a cero." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fillColor=#f3f7fb;strokeColor=#bccbdc;" vertex="1" parent="1"><mxGeometry x="1190" y="1200" width="440" height="290" as="geometry"/></mxCell>
        <mxCell id="datos" value="&lt;b&gt;EXTERNO · MOTOR LPDT&lt;/b&gt;&lt;br&gt;&lt;br&gt;→ estado_D0 [2], actualiza en negedge.&lt;br&gt;Sin nuevo registro en el camino al pad.&lt;br&gt;El motor ya produce Escape, 87 y bits.&lt;br&gt;&lt;br&gt;No usar rst_motor como reset del PHY.&lt;br&gt;Aquí no se interpretan comandos DSI." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Helvetica;fontSize=17;fillColor=#f4f5f7;strokeColor=#a5adba;" vertex="1" parent="1"><mxGeometry x="80" y="900" width="390" height="250" as="geometry"/></mxCell>
        <mxCell id="pie" value="&lt;b&gt;FIN NORMAL:&lt;/b&gt; mantener servicio; motor_lpdt conserva 11 tras los 18 paquetes. No hay fin ni transmisión HS.&lt;br&gt;&lt;b&gt;Z ≠ LP-11:&lt;/b&gt; Z significa no conducir, no una tensión garantizada. lp_preparada no es ACK del panel.&lt;br&gt;Procesos azules · decisiones amarillas · externos grises. La FSM y el datapath detallan las señales de cada operación." style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Helvetica;fontSize=17;fontColor=#42526e;" vertex="1" parent="1"><mxGeometry x="180" y="2300" width="1380" height="100" as="geometry"/></mxCell>
        <mxCell id="f01" edge="1" parent="1" source="inicio" target="aislar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f02" edge="1" parent="1" source="aislar" target="reset" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f03" value="No" edge="1" parent="1" source="reset" target="aislar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="490"/><mxPoint x="540" y="327"/></Array></mxGeometry></mxCell>
        <mxCell id="f04" value="Sí" edge="1" parent="1" source="reset" target="error-inicial" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f05" value="Sí → F" edge="1" parent="1" source="error-inicial" target="fallo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.15;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.85" relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="640"/><mxPoint x="1110" y="1823"/></Array></mxGeometry></mxCell>
        <mxCell id="f06" value="No" edge="1" parent="1" source="error-inicial" target="peticion" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f07" value="No" edge="1" parent="1" source="peticion" target="aislar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.9" relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="795"/><mxPoint x="500" y="327"/></Array></mxGeometry></mxCell>
        <mxCell id="f08" value="Sí" edge="1" parent="1" source="peticion" target="precargar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f09" value="Un ciclo" edge="1" parent="1" source="precargar" target="habilitar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f10" edge="1" parent="1" source="habilitar" target="fin-t" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f11" value="No" edge="1" parent="1" source="fin-t" target="habilitar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="1362"/><mxPoint x="540" y="1172"/></Array></mxGeometry></mxCell>
        <mxCell id="f12" value="Sí" edge="1" parent="1" source="fin-t" target="servir" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f13" edge="1" parent="1" source="servir" target="reset-servicio" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f14" value="Sí" edge="1" parent="1" source="reset-servicio" target="aislar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.25;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.95" relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="1730"/><mxPoint x="40" y="296"/></Array></mxGeometry></mxCell>
        <mxCell id="f15" value="No" edge="1" parent="1" source="reset-servicio" target="error-servicio" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f16" value="Sí → F" edge="1" parent="1" source="error-servicio" target="fallo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.6;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f17" value="No" edge="1" parent="1" source="error-servicio" target="mantener" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f18" value="Sí: continuar servicio" edge="1" parent="1" source="mantener" target="servir" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.85" relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="2065"/><mxPoint x="520" y="1552"/></Array></mxGeometry></mxCell>
        <mxCell id="f19" value="No: aislar" edge="1" parent="1" source="mantener" target="aislar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;exitX=0.5;exitY=1;entryX=0;entryY=0.75;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.95" relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="2200"/><mxPoint x="70" y="2200"/><mxPoint x="70" y="358"/></Array></mxGeometry></mxCell>
        <mxCell id="f20" edge="1" parent="1" source="fallo" target="reset-fallo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f21" value="No" edge="1" parent="1" source="reset-fallo" target="fallo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.9;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="2072"/><mxPoint x="1150" y="1939"/></Array></mxGeometry></mxCell>
        <mxCell id="f22" value="Sí: reset" edge="1" parent="1" source="reset-fallo" target="aislar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#344563;strokeWidth=2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=17;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.95" relative="1" as="geometry"><Array as="points"><mxPoint x="1670" y="2072"/><mxPoint x="1670" y="220"/><mxPoint x="1080" y="220"/><mxPoint x="1080" y="327"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phy-datapath" name="Datapath">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="2250" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="canvas" value="" style="fillColor=#ffffff;strokeColor=none;connectable=0;" vertex="1" parent="1"><mxGeometry width="2900" height="2250" as="geometry"/></mxCell>
        <mxCell id="titulo" value="&lt;b&gt;MOTOR PHY · ESQUEMA DEL DATAPATH PROPUESTO&lt;/b&gt;" style="text;html=1;align=left;fontSize=32;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="35" width="2700" height="55" as="geometry"/></mxCell>
        <mxCell id="clave" value="Estilo de los otros módulos: bloques sin relleno de color, MUX explícito, contador, comparador y señales nombradas.&lt;br&gt;RST / INC junto al bloque; D/Q o A/B/Z en sus puertos. [n]: anchura. Las etiquetas iguales son conexiones por nombre.&lt;br&gt;Solo TIEMPO almacena datos en este datapath; el registro de estado pertenece a la FSM. No hay registro nuevo de D0." style="text;html=1;align=left;whiteSpace=wrap;fontSize=19;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="2700" height="100" as="geometry"/></mxCell>
        <mxCell id="timer" value="&lt;b&gt;TIEMPO&lt;/b&gt;&lt;br&gt;count.v [W]&lt;br&gt;ASCENDENTE" style="whiteSpace=wrap;html=1;fontSize=21;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="310" height="210" as="geometry"/></mxCell>
        <mxCell id="timer-rst" value="RST" style="text;html=1;fontSize=16;" vertex="1" parent="timer"><mxGeometry x="0" y="0" width="50" height="30" as="geometry"/></mxCell>
        <mxCell id="timer-inc" value="INC" style="text;html=1;fontSize=16;" vertex="1" parent="timer"><mxGeometry x="0" y="35" width="50" height="30" as="geometry"/></mxCell>
        <mxCell id="timer-q" value="Q" style="text;html=1;align=right;fontSize=17;" vertex="1" parent="timer"><mxGeometry x="275" y="90" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="timer-clk" value="↓CLK" style="text;html=1;fontSize=16;" vertex="1" parent="timer"><mxGeometry x="210" y="175" width="90" height="25" as="geometry"/></mxCell>
        <mxCell id="rst-t" value="rst OR RST_T" style="text;html=1;align=right;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="385" width="240" height="35" as="geometry"/></mxCell>
        <mxCell id="inc-t" value="INC_T" style="text;html=1;align=right;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="425" width="240" height="35" as="geometry"/></mxCell>
        <mxCell id="comp" value="&lt;b&gt;COMPARADOR&lt;/b&gt;&lt;br&gt;comp.v [W]&lt;br&gt;A == B" style="whiteSpace=wrap;html=1;fontSize=21;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1050" y="400" width="290" height="210" as="geometry"/></mxCell>
        <mxCell id="comp-a" value="A" style="text;html=1;fontSize=17;" vertex="1" parent="comp"><mxGeometry x="0" y="40" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="comp-b" value="B" style="text;html=1;fontSize=17;" vertex="1" parent="comp"><mxGeometry x="0" y="145" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="comp-z" value="Z" style="text;html=1;align=right;fontSize=17;" vertex="1" parent="comp"><mxGeometry x="255" y="90" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="limite" value="T_HABILITACION [W]&lt;br&gt;constante configurable" style="text;html=1;whiteSpace=wrap;align=right;fontSize=18;" vertex="1" parent="1"><mxGeometry x="710" y="630" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="zt" value="Z_T → FSM&lt;br&gt;TIEMPO == T_HABILITACION" style="text;html=1;whiteSpace=wrap;fontSize=19;fontColor=#b00020;" vertex="1" parent="1"><mxGeometry x="1450" y="450" width="430" height="70" as="geometry"/></mxCell>
        <mxCell id="fsm" value="&lt;b&gt;CONTROL · FSM&lt;/b&gt;&lt;br&gt;registro de estado en ↑CLK&lt;br&gt;decodificación combinacional&lt;br&gt;&lt;br&gt;Entradas: rst, preparar_lp, fallo_init, Z_T&lt;br&gt;Controles: RST_T, INC_T, EN_LP,&lt;br&gt;SEL_D0, LISTO_CTRL&lt;br&gt;Decodifica ESTADO_VALIDO y FALLO_ACTIVO&lt;br&gt;&lt;br&gt;Ver página FSM; no contiene los bits LPDT" style="whiteSpace=wrap;html=1;fontSize=19;strokeWidth=1;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="2030" y="300" width="700" height="360" as="geometry"/></mxCell>
        <mxCell id="counter-note" value="W = max(1, ceil(log2(T_HABILITACION + 1)))&lt;br&gt;RST_T deja TIEMPO en 0 durante PRECARGAR.&lt;br&gt;ESTABILIZAR: incrementar hasta N y observar Z_T&lt;br&gt;en el posedge posterior: N ciclos completos de LP-11.&lt;br&gt;N ≥ 1; sin relojes derivados." style="text;html=1;whiteSpace=wrap;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry x="180" y="730" width="1170" height="145" as="geometry"/></mxCell>
        <mxCell id="motor" value="&lt;b&gt;MOTOR LPDT&lt;/b&gt;&lt;br&gt;EXTERNO&lt;br&gt;estado_D0 [2]&lt;br&gt;{P,N} · actualiza en ↓CLK" style="whiteSpace=wrap;html=1;fontSize=20;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="1070" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="k11" value="11 [2]" style="text;html=1;align=right;fontSize=20;" vertex="1" parent="1"><mxGeometry x="500" y="970" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="mux" value="M0&lt;br&gt;2:1&lt;br&gt;[2]" style="shadow=0;dashed=0;align=center;html=1;strokeWidth=1;shape=mxgraph.electrical.abstract.mux2;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="740" y="980" width="130" height="270" as="geometry"/></mxCell>
        <mxCell id="sel" value="S = SEL_D0 AND B" style="text;html=1;align=center;fontSize=18;" vertex="1" parent="1"><mxGeometry x="600" y="1340" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="join" value="&lt;b&gt;CONCATENAR&lt;/b&gt;&lt;br&gt;D1 = CLK = 11&lt;br&gt;&lt;br&gt;lp_p = {1,1,D0[1]}&lt;br&gt;lp_n = {1,1,D0[0]}&lt;br&gt;bits: 0=D0, 1=D1, 2=CLK" style="whiteSpace=wrap;html=1;fontSize=19;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1110" y="1000" width="390" height="240" as="geometry"/></mxCell>
        <mxCell id="buf" value="&lt;b&gt;TBUF × 6&lt;/b&gt;&lt;br&gt;DATOS [6] → PADS [6]&lt;br&gt;&lt;br&gt;OEN=0: conducir&lt;br&gt;OEN=1: Z&lt;br&gt;&lt;br&gt;Adaptador de pads Gowin" style="whiteSpace=wrap;html=1;fontSize=20;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1800" y="1000" width="380" height="240" as="geometry"/></mxCell>
        <mxCell id="oen" value="OEN" style="text;html=1;fontSize=17;align=center;" vertex="1" parent="buf"><mxGeometry x="155" y="0" width="70" height="30" as="geometry"/></mxCell>
        <mxCell id="pins" value="&lt;b&gt;PADS LP&lt;/b&gt;&lt;br&gt;D0 P/N: 122/123&lt;br&gt;D1 P/N: 124/125&lt;br&gt;CLK P/N: 126/128&lt;br&gt;&lt;br&gt;100 Ω por rama hacia LCD" style="whiteSpace=wrap;html=1;fontSize=19;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2460" y="1000" width="320" height="240" as="geometry"/></mxCell>
        <mxCell id="not" value="" style="shape=mxgraph.electrical.logic_gates.inverter;html=1;" vertex="1" parent="1"><mxGeometry x="1920" y="825" width="90" height="65" as="geometry"/></mxCell>
        <mxCell id="hab" value="HAB_LP = EN_LP AND B" style="text;html=1;fontSize=19;align=right;" vertex="1" parent="1"><mxGeometry x="1510" y="825" width="350" height="40" as="geometry"/></mxCell>
        <mxCell id="mask" value="&lt;b&gt;MÁSCARA COMBINACIONAL B [1]&lt;/b&gt;&lt;br&gt;&lt;br&gt;B = preparar_lp AND NOT rst AND NOT fallo_init&lt;br&gt;AND ESTADO_VALIDO AND NOT FALLO_ACTIVO&lt;br&gt;&lt;br&gt;S = SEL_D0 AND B&lt;br&gt;HAB_LP = EN_LP AND B&lt;br&gt;lp_oe[2:0] = {3{HAB_LP}}&lt;br&gt;lp_preparada = LISTO_CTRL AND B" style="whiteSpace=wrap;html=1;fontSize=19;strokeWidth=1;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="150" y="1530" width="930" height="320" as="geometry"/></mxCell>
        <mxCell id="hs-const" value="111 [3]&lt;br&gt;CONSTANTE" style="text;html=1;whiteSpace=wrap;align=center;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1180" y="1560" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="hs" value="&lt;b&gt;BUFFERS HS&lt;/b&gt;&lt;br&gt;OEN [3] = 111&lt;br&gt;Siempre sin conducir&lt;br&gt;Sin PLL ni serialización" style="whiteSpace=wrap;html=1;fontSize=20;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1580" y="1510" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="hs-pins" value="&lt;b&gt;PADS HS → Z&lt;/b&gt;&lt;br&gt;D0 P/N: 117/116&lt;br&gt;D1 P/N: 115/114&lt;br&gt;CLK P/N: 113/112" style="whiteSpace=wrap;html=1;fontSize=20;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2300" y="1510" width="410" height="190" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;CONTROLES POR NOMBRE, IGUAL QUE EN LOS OTROS MÓDULOS&lt;/b&gt;&lt;br&gt;FSM → datapath: RST_T, INC_T, SEL_D0, EN_LP, LISTO_CTRL. Datapath → FSM: Z_T.&lt;br&gt;ESTADO_VALIDO y FALLO_ACTIVO se decodifican del estado; no son registros de datos ni respuestas del LCD.&lt;br&gt;M0, CONCATENAR y TBUF son combinacionales. No insertar LD/REG en D0: cambiaría el tiempo respecto a terminado.&lt;br&gt;La máscara B inhibe pads y preparación; no es un sensor ni elimina el retardo físico de las puertas.&lt;br&gt;&lt;br&gt;Pines de FPGA, no contactos LCD. Primitivas concretas, restricciones y señales durante configuración: pendientes." style="text;html=1;whiteSpace=wrap;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry x="150" y="1960" width="2600" height="220" as="geometry"/></mxCell>
        <mxCell id="d01" edge="1" parent="1" source="rst-t" target="timer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.07;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d02" edge="1" parent="1" source="inc-t" target="timer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.24;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d03" value="TIEMPO [W]" edge="1" parent="1" source="timer" target="comp" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.26;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="505"/><mxPoint x="860" y="455"/></Array></mxGeometry></mxCell>
        <mxCell id="d04" edge="1" parent="1" source="limite" target="comp" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.76;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="662"/><mxPoint x="1020" y="559"/></Array></mxGeometry></mxCell>
        <mxCell id="d05" edge="1" parent="1" source="comp" target="zt" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d06" edge="1" parent="1" source="k11" target="mux" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.2;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="990"/><mxPoint x="675" y="1034"/></Array></mxGeometry></mxCell>
        <mxCell id="d07" value="estado_D0 [2]" edge="1" parent="1" source="motor" target="mux" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.8;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="1160"/><mxPoint x="580" y="1196"/></Array></mxGeometry></mxCell>
        <mxCell id="d08" edge="1" parent="1" source="sel" target="mux" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d09" value="D0 [2]" edge="1" parent="1" source="mux" target="join" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d10" value="lp_p [3] / lp_n [3]" edge="1" parent="1" source="join" target="buf" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d11" edge="1" parent="1" source="hab" target="not" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d12" value="OEN común LP" edge="1" parent="1" source="not" target="buf" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0.5;entryY=0;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2090" y="857"/><mxPoint x="2090" y="950"/><mxPoint x="1990" y="950"/></Array></mxGeometry></mxCell>
        <mxCell id="d13" value="6 salidas" edge="1" parent="1" source="buf" target="pins" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d14" value="hs_oen [3]" edge="1" parent="1" source="hs-const" target="hs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d15" value="6 pines sin conducir" edge="1" parent="1" source="hs" target="hs-pins" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=18;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="phy-fsm" name="FSM">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2440" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="canvas" value="" style="fillColor=#ffffff;strokeColor=none;connectable=0;" vertex="1" parent="1"><mxGeometry width="2600" height="2440" as="geometry"/></mxCell>
        <mxCell id="titulo" value="&lt;b&gt;MOTOR PHY · FSM PROPUESTA&lt;/b&gt;" style="text;html=1;align=left;fontFamily=Helvetica;fontSize=32;" vertex="1" parent="1"><mxGeometry x="100" y="35" width="2400" height="55" as="geometry"/></mxCell>
        <mxCell id="clave" value="Estados circulares con controles de salida, como motor_lpdt / secuenciador_init. Transiciones evaluadas en ↑CLK.&lt;br&gt;RST_T / INC_T gobiernan TIEMPO en ↓CLK; Z_T = (TIEMPO == T_HABILITACION). Ver datapath.&lt;br&gt;Las flechas normales presuponen rst=0, ERROR=0 y ausencia de FALLO enclavado. HS_OEN=111 siempre." style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Helvetica;fontSize=20;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="2400" height="105" as="geometry"/></mxCell>
        <mxCell id="i" value="&lt;b&gt;I · AISLADO&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;&lt;br&gt;RST_T = 1 · INC_T = 0&lt;br&gt;EN_LP = 0 · SEL_D0 = 0&lt;br&gt;LISTO_CTRL = 0&lt;br&gt;FALLO_ACTIVO = 0&lt;br&gt;&lt;br&gt;Dato LP interno = 11&lt;br&gt;Buffers LP sin conducir&lt;br&gt;lp_preparada = 0" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=21;" vertex="1" parent="1"><mxGeometry x="180" y="440" width="480" height="480" as="geometry"/></mxCell>
        <mxCell id="p" value="&lt;b&gt;P · PRECARGAR&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;&lt;br&gt;RST_T = 1 · INC_T = 0&lt;br&gt;EN_LP = 0 · SEL_D0 = 0&lt;br&gt;LISTO_CTRL = 0&lt;br&gt;FALLO_ACTIVO = 0&lt;br&gt;&lt;br&gt;Dato LP interno = 11&lt;br&gt;Buffers LP sin conducir&lt;br&gt;Duración: un ciclo" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1040" y="440" width="480" height="480" as="geometry"/></mxCell>
        <mxCell id="e" value="&lt;b&gt;E · ESTABILIZAR&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;&lt;br&gt;RST_T = 0&lt;br&gt;INC_T = NOT Z_T&lt;br&gt;EN_LP = 1 · SEL_D0 = 0&lt;br&gt;LISTO_CTRL = 0&lt;br&gt;FALLO_ACTIVO = 0&lt;br&gt;&lt;br&gt;D0 = D1 = CLK = LP-11&lt;br&gt;Contar N ciclos completos" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1900" y="440" width="480" height="480" as="geometry"/></mxCell>
        <mxCell id="l" value="&lt;b&gt;L · LISTO&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;&lt;br&gt;RST_T = 0 · INC_T = 0&lt;br&gt;EN_LP = 1 · SEL_D0 = 1&lt;br&gt;LISTO_CTRL = 1&lt;br&gt;FALLO_ACTIVO = 0&lt;br&gt;&lt;br&gt;D0 = estado_D0 [2]&lt;br&gt;D1 = CLK = LP-11&lt;br&gt;Sin nuevo registro en D0" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1660" y="1460" width="480" height="480" as="geometry"/></mxCell>
        <mxCell id="f" value="&lt;b&gt;F · FALLO&lt;/b&gt;&lt;br&gt;________________________&lt;br&gt;&lt;br&gt;RST_T = 1 · INC_T = 0&lt;br&gt;EN_LP = 0 · SEL_D0 = 0&lt;br&gt;LISTO_CTRL = 0&lt;br&gt;FALLO_ACTIVO = 1&lt;br&gt;&lt;br&gt;LP y HS sin conducir&lt;br&gt;lp_preparada = 0&lt;br&gt;Solo rst permite salir" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=21;" vertex="1" parent="1"><mxGeometry x="350" y="1460" width="480" height="480" as="geometry"/></mxCell>
        <mxCell id="reset" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="220" y="330" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="global" value="&lt;b&gt;TRANSICIONES GLOBALES · PRIORIDAD&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. rst: desde cualquier estado → I.&lt;br&gt;2. ERROR o FALLO_ACTIVO: → F.&lt;br&gt;3. !preparar_lp: desde I/P/E/L → I.&lt;br&gt;4. En otro caso: seguir flechas normales.&lt;br&gt;&lt;br&gt;ERROR = fallo_init OR NOT ESTADO_VALIDO.&lt;br&gt;Estado no válido: controles por defecto a 0,&lt;br&gt;ESTADO_VALIDO=0; pads inhibidos; → F.&lt;br&gt;F no sale al retirar el fallo o la petición." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontFamily=Helvetica;fontSize=21;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="970" y="1030" width="680" height="335" as="geometry"/></mxCell>
        <mxCell id="mascara" value="&lt;b&gt;SALIDAS EFECTIVAS: NO SOLO EL ESTADO&lt;/b&gt;&lt;br&gt;B = preparar_lp AND NOT rst AND NOT fallo_init AND ESTADO_VALIDO AND NOT FALLO_ACTIVO&lt;br&gt;HAB_LP = EN_LP AND B · lp_oe = {3{HAB_LP}} · lp_preparada = LISTO_CTRL AND B&lt;br&gt;Selección efectiva del MUX: S = SEL_D0 AND B. OEN físico LP = NOT HAB_LP.&lt;br&gt;&lt;br&gt;ESTADO_VALIDO=1 en I/P/E/L/F. La máscara inhibe sin esperar al cambio del registro de estado.&lt;br&gt;Las señales describen un diseño pendiente de implementar, no una garantía analógica de latencia cero." style="text;html=1;whiteSpace=wrap;align=left;fontFamily=Helvetica;fontSize=20;" vertex="1" parent="1"><mxGeometry x="140" y="2160" width="2320" height="190" as="geometry"/></mxCell>
        <mxCell id="t01" value="rst" edge="1" parent="1" source="reset" target="i" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.3;entryY=0;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t02" value="preparar_lp" edge="1" parent="1" source="i" target="p" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t03" value="!preparar_lp" edge="1" parent="1" source="i" target="i" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.7;exitY=0;entryX=0.3;entryY=0;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="516" y="300"/><mxPoint x="324" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="t04" value="1" edge="1" parent="1" source="p" target="e" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t05" value="!Z_T" edge="1" parent="1" source="e" target="e" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.7;exitY=0;entryX=0.3;entryY=0;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2236" y="300"/><mxPoint x="2044" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="t06" value="Z_T" edge="1" parent="1" source="e" target="l" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2140" y="1410"/><mxPoint x="1900" y="1410"/></Array></mxGeometry></mxCell>
        <mxCell id="t07" value="1 · mantener servicio" edge="1" parent="1" source="l" target="l" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.7;exitY=1;entryX=0.3;entryY=1;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1996" y="2050"/><mxPoint x="1804" y="2050"/></Array></mxGeometry></mxCell>
        <mxCell id="t08" value="!preparar_lp" edge="1" parent="1" source="l" target="i" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.3;entryX=0.5;entryY=1;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry x="-0.9" relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="1604"/><mxPoint x="900" y="1410"/><mxPoint x="420" y="1410"/></Array></mxGeometry></mxCell>
        <mxCell id="t09" value="ERROR / FALLO_ACTIVO" edge="1" parent="1" source="global" target="f" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0.5;entryY=0;fontSize=19;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="1197"/></Array></mxGeometry></mxCell>
        <mxCell id="t10" value="!rst" edge="1" parent="1" source="f" target="f" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.7;exitY=1;entryX=0.3;entryY=1;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="686" y="2050"/><mxPoint x="494" y="2050"/></Array></mxGeometry></mxCell>
        <mxCell id="t11" value="rst" edge="1" parent="1" source="f" target="i" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.3;entryX=0;entryY=0.5;fontSize=20;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="1604"/><mxPoint x="100" y="680"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
